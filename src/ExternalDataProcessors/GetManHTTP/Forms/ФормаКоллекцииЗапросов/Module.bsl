КонецПроцедуры

&НаКлиенте
Процедура ТипАвторизацииПриИзменении(Элемент)
	
	ПерестроитьПараметрыАвторизацииПоСхеме(Ложь);
	ОтобразитьПоляАвторизацииПоСхеме();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеАвторизацииПриИзменении(Элемент)
	
	СинхронизироватьПараметрыАвторизацииИзПолейФормы();
	Если ТипАвторизации = ИдентификаторТипаАвторизацииJwtBearer()
		И Элемент.Имя = "ПолеАвторизации1" Тогда
		ОтобразитьПоляАвторизацииПоСхеме();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеАвторизацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Не Элемент.КнопкаВыбора Тогда
		Возврат;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Загрузка ключа из файла недоступна в веб-клиенте";
		Сообщение.Сообщить();
		Возврат;
	#КонецЕсли
	
	ИмяРеквизита = СтрЗаменить(Элемент.Имя, "ПолеАвторизации", "ЗначениеАвторизации");
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл приватного ключа (PEM)";
	Диалог.Фильтр =
		"Ключ PEM/TXT (*.pem;*.txt)|*.pem;*.txt|"
		+ "Все файлы (*.*)|*.*";
	Диалог.МножественныйВыбор = Ложь;
	ПараметрыОповещения = Новый Структура("ИмяРеквизита", ИмяРеквизита);
	Оповещение = Новый ОписаниеОповещения(
		"ЗагрузитьJwtПриватныйКлючИзФайлаЗавершение",
		ЭтотОбъект,
		ПараметрыОповещения);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьJwtПриватныйКлючИзФайлаЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = "";
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ДополнительныеПараметры.Свойство("ИмяРеквизита", ИмяРеквизита);
	КонецЕсли;
	Если ПустаяСтрока(ИмяРеквизита) Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = ВыбранныеФайлы[0];
	
	#Если НЕ ВебКлиент Тогда
		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
		ТекстКлюча = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
	#Иначе
		Возврат;
	#КонецЕсли
	
	Если ТекстКлюча = Неопределено Тогда
		ТекстКлюча = "";
	КонецЕсли;
	
	ЭтотОбъект[ИмяРеквизита] = ТекстКлюча;
	СинхронизироватьПараметрыАвторизацииИзПолейФормы();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиКомандФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура ПрименитьНастройкиКоллекции(Команда)
	
	Если ПустаяСтрока(СокрЛП(Наименование)) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите наименование коллекции";
		Сообщение.Поле = "Наименование";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если Не ИспользоватьТаймаутПоУмолчанию И ТаймаутКоллекции < 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Таймаут коллекции не может быть отрицательным";
		Сообщение.Поле = "ТаймаутКоллекции";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	СинхронизироватьПараметрыАвторизацииИзПолейФормы();
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование", СокрЛП(Наименование));
	Результат.Вставить("ИспользоватьТаймаутПоУмолчанию", ИспользоватьТаймаутПоУмолчанию);
	Результат.Вставить("ТаймаутКоллекции", ТаймаутКоллекции);
	Результат.Вставить("ТипАвторизации", ТипАвторизации);
	Результат.Вставить("ПараметрыАвторизации", ПараметрыАвторизацииВМассивСтруктур());
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьНастройкиКоллекции(Команда)
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортироватьКоллекцию(Команда)
	
	Если ВладелецФормы = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Импорт коллекции доступен только из главной формы обработки";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ВладелецФормы.ИмпортироватьКоллекциюИзФайла();
	
КонецПроцедуры

&НаКлиенте
Процедура ЭкспортироватьКоллекцию(Команда)
	
	Если ВладелецФормы = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Экспорт коллекции доступен только из главной формы обработки";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ВладелецФормы.ЭкспортироватьТекущуюКоллекциюВФайл();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьПараметрыАвторизацииИзПараметровФормы()
	
	ПараметрыАвторизации.Очистить();
	Если Не Параметры.Свойство("ПараметрыАвторизации") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Параметры.ПараметрыАвторизации) = Тип("ТаблицаЗначений") Тогда
		ПараметрыАвторизации.Загрузить(Параметры.ПараметрыАвторизации);
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Параметры.ПараметрыАвторизации) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементМассива Из Параметры.ПараметрыАвторизации Цикл
		
		Если ТипЗнч(ЭлементМассива) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ПараметрыАвторизации.Добавить();
		Если ЭлементМассива.Свойство("Ключ") Тогда
			НоваяСтрока.Ключ = ЭлементМассива.Ключ;
		КонецЕсли;
		Если ЭлементМассива.Свойство("Значение") Тогда
			НоваяСтрока.Значение = ЭлементМассива.Значение;
		КонецЕсли;
		Если ЭлементМассива.Свойство("Секретный") Тогда
			НоваяСтрока.Секретный = ЭлементМассива.Секретный;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьТаймаутаКоллекции()
	
	Элементы.ТаймаутКоллекции.Доступность = Не ИспользоватьТаймаутПоУмолчанию;
	
КонецПроцедуры

