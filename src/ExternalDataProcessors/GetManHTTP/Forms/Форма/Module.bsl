&НаСервере
Функция ПолучитьИмяТекущейКоллекцииДляЭкспортаНаСервере()
	
	СтрокаКоллекции = НайтиСтрокуКоллекцииЗапросов(ТекущаяКоллекция);
	Если СтрокаКоллекции = Неопределено Тогда
		Возврат ИмяКоллекцииЗапросовПоУмолчанию();
	КонецЕсли;
	
	Возврат СтрокаКоллекции.Наименование;
	
КонецФункции

&НаСервере
Функция СформироватьТекстЭкспортаТекущейКоллекцииНаСервере(Знач ФорматЭкспорта)
	
	Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
		ЗаписатьТекущийЭлементВСписокНаСервере(ИдентификаторТекущегоЗапроса);
	КонецЕсли;
	
	ЗаписатьДеревоВТекущуюКоллекциюНаСервере();
	
	СтрокаКоллекции = НайтиСтрокуКоллекцииЗапросов(ТекущаяКоллекция);
	Если СтрокаКоллекции = Неопределено Тогда
		ВызватьИсключение "Не выбрана коллекция запросов";
	КонецЕсли;
	
	Если ФорматЭкспорта = ИдентификаторФорматаЭкспортаPostman() Тогда
		ДанныеЭкспорта = СформироватьОбъектPostmanКоллекции(СтрокаКоллекции);
	Иначе
		ДанныеЭкспорта = СформироватьОбъектGetManHTTPКоллекции(СтрокаКоллекции);
	КонецЕсли;
	
	Возврат ЗаписатьЗначениеВJSONСтрокуКоллекции(ДанныеЭкспорта);
	
КонецФункции

&НаСервере
Функция ПолучитьСведенияОбИмпортеКоллекцииНаСервере(Знач ТекстJSON)
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Идентификатор", "");
	Результат.Вставить("Наименование", "");
	Результат.Вставить("УжеСуществует", Ложь);
	Результат.Вставить("Формат", "");
	
	ДанныеJSON = ПрочитатьЗначениеИзJSONСтрокиКоллекции(ТекстJSON);
	ОписаниеКоллекции = РазобратьКоллекциюИзJSONОбъекта(ДанныеJSON);
	
	Если Не ПустаяСтрока(ОписаниеКоллекции.Ошибка) Тогда
		Результат.Ошибка = ОписаниеКоллекции.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Идентификатор = ОписаниеКоллекции.Идентификатор;
	Результат.Наименование = ОписаниеКоллекции.Наименование;
	Результат.Формат = ОписаниеКоллекции.Формат;
	Результат.УжеСуществует =
		НайтиСтрокуКоллекцииЗапросов(ОписаниеКоллекции.Идентификатор) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПрименитьИмпортКоллекцииИзJSONНаСервере(Знач ТекстJSON)
	
	ДанныеJSON = ПрочитатьЗначениеИзJSONСтрокиКоллекции(ТекстJSON);
	ОписаниеКоллекции = РазобратьКоллекциюИзJSONОбъекта(ДанныеJSON);
	
	Если Не ПустаяСтрока(ОписаниеКоллекции.Ошибка) Тогда
		ВызватьИсключение ОписаниеКоллекции.Ошибка;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
		ЗаписатьТекущийЭлементВСписокНаСервере(ИдентификаторТекущегоЗапроса);
	КонецЕсли;
	
	Если Не ПустаяСтрока(ОтображаемаяКоллекция) Тогда
		ЗаписатьДеревоВКоллекциюНаСервере(ОтображаемаяКоллекция);
	КонецЕсли;
	
	ТаблицаКоллекций = ТаблицаКоллекцийЗапросов();
	ОбеспечитьКолонкиАвторизацииВТаблицеКоллекций(ТаблицаКоллекций);
	
	СтрокаКоллекции = НайтиСтрокуКоллекцииЗапросов(ОписаниеКоллекции.Идентификатор, ТаблицаКоллекций);
	Если СтрокаКоллекции = Неопределено Тогда
		СтрокаКоллекции = ТаблицаКоллекций.Добавить();
		СтрокаКоллекции.Идентификатор = ОписаниеКоллекции.Идентификатор;
	КонецЕсли;
	
	СтрокаКоллекции.Наименование = ОписаниеКоллекции.Наименование;
	СтрокаКоллекции.ИспользоватьТаймаутПоУмолчанию = ОписаниеКоллекции.ИспользоватьТаймаутПоУмолчанию;
	СтрокаКоллекции.Таймаут = ОписаниеКоллекции.Таймаут;
	СтрокаКоллекции.ТипАвторизации = ОписаниеКоллекции.ТипАвторизации;
	СтрокаКоллекции.ПараметрыАвторизации = СериализоватьПараметрыАвторизацииИзЗначения(
		ОписаниеКоллекции.ПараметрыАвторизации);
	СтрокаКоллекции.ДанныеСписка = ЗначениеВСтрокуВнутр(ОписаниеКоллекции.ДеревоЗапросов);
	
	ЗаписатьТаблицуКоллекцийЗапросов(ТаблицаКоллекций);
	
	ТекущаяКоллекция = ОписаниеКоллекции.Идентификатор;
	ОтображаемаяКоллекция = ТекущаяКоллекция;
	ЗагрузитьДеревоИзКоллекцииНаСервере(ТекущаяКоллекция);
	
	ДанныеПереключения = ПолучитьДанныеПервоначальногоВыбораПослеСменыКоллекцииНаСервере();
	ДанныеПереключения.Вставить("НаименованиеКоллекции", ОписаниеКоллекции.Наименование);
	
	Возврат ДанныеПереключения;
	
КонецФункции

&НаСервере
Функция РазобратьКоллекциюИзJSONОбъекта(Знач ДанныеJSON)
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Формат", "");
	Результат.Вставить("Идентификатор", "");
	Результат.Вставить("Наименование", "");
	Результат.Вставить("ИспользоватьТаймаутПоУмолчанию", Истина);
	Результат.Вставить("Таймаут", 0);
	Результат.Вставить("ТипАвторизации", ИдентификаторТипаАвторизацииБезАвторизации());
	Результат.Вставить("ПараметрыАвторизации", НовыйТаблицаПараметровАвторизации());
	Результат.Вставить("ДеревоЗапросов", Неопределено);
	
	Если ТипЗнч(ДанныеJSON) <> Тип("Соответствие") И ТипЗнч(ДанныеJSON) <> Тип("Структура") Тогда
		Результат.Ошибка = "Файл не содержит JSON-объект коллекции";
		Возврат Результат;
	КонецЕсли;
	
	ФорматКоллекции = ЗначениеСвойстваJSONКоллекции(ДанныеJSON, "format", "");
	Если ФорматКоллекции = ИдентификаторФорматаКоллекцииGetManHTTP() Тогда
		Результат.Формат = ИдентификаторФорматаЭкспортаGetManHTTP();
		ЗаполнитьОписаниеКоллекцииИзGetManHTTP(ДанныеJSON, Результат);
		Возврат Результат;
	КонецЕсли;
	
	Информация = ЗначениеСвойстваJSONКоллекции(ДанныеJSON, "info", Неопределено);
	СхемаPostman = "";
	Если Информация <> Неопределено Тогда
		СхемаPostman = Строка(ЗначениеСвойстваJSONКоллекции(Информация, "schema", ""));
	КонецЕсли;
	
	Если СтрНайти(НРег(СхемаPostman), "schema.getpostman.com/json/collection/v2.1") > 0
		Или ЗначениеСвойстваJSONКоллекции(ДанныеJSON, "item", Неопределено) <> Неопределено Тогда
		Результат.Формат = ИдентификаторФорматаЭкспортаPostman();
		ЗаполнитьОписаниеКоллекцииИзPostman(ДанныеJSON, Результат);
		Возврат Результат;
	КонецЕсли;
	
	Результат.Ошибка =
		"Неизвестный формат коллекции. Ожидается GetManHTTP.Collection или Postman Collection v2.1";
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОписаниеКоллекцииИзGetManHTTP(Знач ДанныеJSON, Результат)
	
	ВерсияСхемы = ЗначениеСвойстваJSONКоллекции(ДанныеJSON, "schemaVersion", 0);
	Если Число(ВерсияСхемы) > ВерсияСхемыКоллекцииGetManHTTP() Тогда
		Результат.Ошибка = СтрШаблон(
			"Версия схемы коллекции %1 не поддерживается (максимум %2)",
			ВерсияСхемы,
			ВерсияСхемыКоллекцииGetManHTTP());
		Возврат;
	КонецЕсли;
	
	Результат.Идентификатор = СокрЛП(Строка(ЗначениеСвойстваJSONКоллекции(ДанныеJSON, "id", "")));
	Если ПустаяСтрока(Результат.Идентификатор) Тогда
		Результат.Идентификатор = НовыйИдентификаторКоллекцииЗапросов();
	КонецЕсли;
	
	Результат.Наименование = СокрЛП(Строка(ЗначениеСвойстваJSONКоллекции(ДанныеJSON, "name", "")));
	Если ПустаяСтрока(Результат.Наименование) Тогда
		Результат.Наименование = ИмяКоллекцииЗапросовПоУмолчанию();
	КонецЕсли;
	
	ОписаниеТаймаута = ЗначениеСвойстваJSONКоллекции(ДанныеJSON, "timeout", Неопределено);
	Если ОписаниеТаймаута <> Неопределено Тогда
		Результат.ИспользоватьТаймаутПоУмолчанию = БулевоЗначениеJSONКоллекции(
			ЗначениеСвойстваJSONКоллекции(ОписаниеТаймаута, "useDefault", Истина),
			Истина);
		Результат.Таймаут = Число(ЗначениеСвойстваJSONКоллекции(ОписаниеТаймаута, "seconds", 0));
	КонецЕсли;
	
	ОписаниеАвторизации = ПортативнаяАвторизацияИзJSON(
		ЗначениеСвойстваJSONКоллекции(ДанныеJSON, "auth", Неопределено),
		ИдентификаторТипаАвторизацииБезАвторизации());
	Результат.ТипАвторизации = ОписаниеАвторизации.ТипАвторизации;
	Результат.ПараметрыАвторизации = ОписаниеАвторизации.ПараметрыАвторизации;
	
	Дерево = ДеревоСписокЗапросов();
	Дерево.Строки.Очистить();
	ЗаполнитьСтрокиДереваИзGetManHTTPЭлементов(
		Дерево.Строки,
		ЗначениеСвойстваJSONКоллекции(ДанныеJSON, "items", Новый Массив));
	Результат.ДеревоЗапросов = Дерево;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиДереваИзGetManHTTPЭлементов(КоллекцияСтрок, Знач ЭлементыJSON)
	
	Если ТипЗнч(ЭлементыJSON) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементJSON Из ЭлементыJSON Цикл
		ДобавитьСтрокуДереваИзGetManHTTPЭлемента(КоллекцияСтрок, ЭлементJSON);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуДереваИзGetManHTTPЭлемента(КоллекцияСтрок, Знач ЭлементJSON)
	
	Если ТипЗнч(ЭлементJSON) <> Тип("Соответствие") И ТипЗнч(ЭлементJSON) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ТипЭлемента = НРег(Строка(ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "type", "")));
	ЭтоГруппа = (ТипЭлемента = "folder");
	
	НоваяСтрока = КоллекцияСтрок.Добавить();
	НоваяСтрока.ЭтоГруппа = ЭтоГруппа;
	НоваяСтрока.Наименование = СокрЛП(Строка(ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "name", "")));
	Если ПустаяСтрока(НоваяСтрока.Наименование) Тогда
		НоваяСтрока.Наименование = ?(ЭтоГруппа, "Папка", "Запрос");
	КонецЕсли;
	
	НоваяСтрока.Идентификатор = СокрЛП(Строка(ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "id", "")));
	Если ПустаяСтрока(НоваяСтрока.Идентификатор) Тогда
		НоваяСтрока.Идентификатор = XMLСтрока(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Если ЭтоГруппа Тогда
		Авторизация = ПортативнаяАвторизацияИзJSON(
			ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "auth", Неопределено),
			ИдентификаторТипаАвторизацииНаследоватьОтВладельца());
		ДанныеПапки = Новый Структура;
		ДанныеПапки.Вставить(КлючПоляТипАвторизацииВДанныхЗапроса(), Авторизация.ТипАвторизации);
		ДанныеПапки.Вставить(КлючПоляПараметрыАвторизацииВДанныхЗапроса(), Авторизация.ПараметрыАвторизации);
		НоваяСтрока.ДанныеЗапроса = ЗначениеВСтрокуВнутр(ДанныеПапки);
		ЗаполнитьСтрокиДереваИзGetManHTTPЭлементов(
			НоваяСтрока.Строки,
			ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "children", Новый Массив));
	Иначе
		НоваяСтрока.ДанныеЗапроса = ЗначениеВСтрокуВнутр(ДанныеЗапросаИзGetManHTTPЭлемента(ЭлементJSON));
	КонецЕсли;
	
	УстановитьКартинкуСтрокиСписка(НоваяСтрока);
	
КонецПроцедуры

&НаСервере
Функция ДанныеЗапросаИзGetManHTTPЭлемента(Знач ЭлементJSON)
	
	ДанныеЗапроса = Новый Структура;
	МетодИзJSON = ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "method", HTTPМетодGET());
	ДанныеЗапроса.Вставить("HTTPМетод", ВРег(СокрЛП(Строка(МетодИзJSON))));
	Если ПустаяСтрока(ДанныеЗапроса.HTTPМетод) Тогда
		ДанныеЗапроса.HTTPМетод = HTTPМетодGET();
	КонецЕсли;
	
	ДанныеЗапроса.Вставить("URI", Строка(ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "url", "")));
	ДанныеЗапроса.Вставить("ВремяВыполненияЗапроса", "");
	ДанныеЗапроса.Вставить("ЗапросОтвет", "");
	ДанныеЗапроса.Вставить("КодОтвета", 0);
	ДанныеЗапроса.Вставить("ЗаголовкиОтвета", Новый ТаблицаЗначений);
	ДанныеЗапроса.Вставить("ФорматОтветаДляСохранения", "");
	ДанныеЗапроса.Вставить("КонтекстВыполненияЗапроса", "");
	ДанныеЗапроса.Вставить(
		"РежимОтправкиЗапроса",
		Строка(ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "sendMode", РежимОтправкиЗапросаКлиент())));
	Если ПустаяСтрока(ДанныеЗапроса.РежимОтправкиЗапроса) Тогда
		ДанныеЗапроса.РежимОтправкиЗапроса = РежимОтправкиЗапросаКлиент();
	КонецЕсли;
	
	Авторизация = ПортативнаяАвторизацияИзJSON(
		ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "auth", Неопределено),
		ИдентификаторТипаАвторизацииНаследоватьОтВладельца());
	ДанныеЗапроса.Вставить(КлючПоляТипАвторизацииВДанныхЗапроса(), Авторизация.ТипАвторизации);
	ДанныеЗапроса.Вставить(КлючПоляПараметрыАвторизацииВДанныхЗапроса(), Авторизация.ПараметрыАвторизации);
	
	ДанныеЗапроса.Вставить(
		"ЗаголовкиЗапроса",
		ТаблицаЗаголовковИзJSONМассива(ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "headers", Новый Массив)));
	ДанныеЗапроса.Вставить(
		"ПараметрыЗапроса",
		ТаблицаПараметровЗапросаИзJSONМассива(ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "query", Новый Массив)));
	
	ВариантТела = ВариантТелаЗапросаОтсутствует();
	ТелоЗапроса = "";
	ПутьКФайлу = "";
	ПоляFormData = НовыйТаблицаПолейFormDataДляИмпорта();
	ЗаполнитьПоляТелаИзGetManHTTPОписания(
		ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "body", Неопределено),
		ВариантТела,
		ТелоЗапроса,
		ПутьКФайлу,
		ПоляFormData);
	
	ДанныеЗапроса.Вставить("ВариантТелаЗапроса", НормализованныйВариантТелаЗапроса(ВариантТела));
	ДанныеЗапроса.Вставить("ТелоЗапроса", ТелоЗапроса);
	ДанныеЗапроса.Вставить("ПутьКФайлуВх", ПутьКФайлу);
	ДанныеЗапроса.Вставить("ПоляFormData", ПоляFormData);
	
	Возврат ДанныеЗапроса;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоляТелаИзGetManHTTPОписания(
	Знач ОписаниеТела,
	ВариантТела,
	ТелоЗапроса,
	ПутьКФайлу,
	ПоляFormData)
	
	Если ОписаниеТела = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РежимТелаИзJSON = ЗначениеСвойстваJSONКоллекции(
		ОписаниеТела,
		КлючJSONMode(),
		ВариантТелаЗапросаОтсутствует());
	ВариантТела = ВРег(СокрЛП(Строка(РежимТелаИзJSON)));
	Если ПустаяСтрока(ВариантТела) Тогда
		ВариантТела = ВариантТелаЗапросаОтсутствует();
	КонецЕсли;
	
	ТелоЗапроса = Строка(ЗначениеСвойстваJSONКоллекции(ОписаниеТела, КлючJSONRaw(), ""));
	ПутьКФайлу = Строка(ЗначениеСвойстваJSONКоллекции(ОписаниеТела, "filePath", ""));
	ПоляFormData = ТаблицаFormDataИзJSONМассива(
		ЗначениеСвойстваJSONКоллекции(ОписаниеТела, "formData", Новый Массив));
	
КонецПроцедуры

&НаСервере
Функция НормализованныйВариантТелаЗапроса(Знач ВариантТела)
	
	Если ВариантТелаПоддерживаетсяПриИмпорте(ВариантТела) Тогда
		Возврат ВариантТела;
	КонецЕсли;
	
	Возврат ВариантТелаЗапросаОтсутствует();
	
КонецФункции

&НаСервере
Функция ВариантТелаПоддерживаетсяПриИмпорте(Знач ВариантТела)
	
	Возврат ВариантТела = ВариантТелаЗапросаОтсутствует()
		Или ВариантТела = "JSON"
		Или ВариантТела = "XML"
		Или ВариантТела = "FORM_DATA"
		Или ВариантТела = "BINARY";
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОписаниеКоллекцииИзPostman(Знач ДанныеJSON, Результат)
	
	Информация = ЗначениеСвойстваJSONКоллекции(ДанныеJSON, "info", Неопределено);
	Результат.Идентификатор = "";
	Результат.Наименование = ИмяКоллекцииЗапросовПоУмолчанию();
	
	Если Информация <> Неопределено Тогда
		Результат.Идентификатор = СокрЛП(Строка(ЗначениеСвойстваJSONКоллекции(Информация, "_postman_id", "")));
		Результат.Наименование = СокрЛП(Строка(ЗначениеСвойстваJSONКоллекции(Информация, "name", "")));
	КонецЕсли;
	
	Если ПустаяСтрока(Результат.Идентификатор) Тогда
		Результат.Идентификатор = НовыйИдентификаторКоллекцииЗапросов();
	КонецЕсли;
	Если ПустаяСтрока(Результат.Наименование) Тогда
		Результат.Наименование = ИмяКоллекцииЗапросовПоУмолчанию();
	КонецЕсли;
	
	АвторизацияКоллекции = АвторизацияИзPostmanAuth(
		ЗначениеСвойстваJSONКоллекции(ДанныеJSON, "auth", Неопределено),
		ИдентификаторТипаАвторизацииБезАвторизации());
	Результат.ТипАвторизации = АвторизацияКоллекции.ТипАвторизации;
	Результат.ПараметрыАвторизации = АвторизацияКоллекции.ПараметрыАвторизации;
	Результат.ИспользоватьТаймаутПоУмолчанию = Истина;
	Результат.Таймаут = 0;
	
	Дерево = ДеревоСписокЗапросов();
	Дерево.Строки.Очистить();
	ЗаполнитьСтрокиДереваИзPostmanЭлементов(
		Дерево.Строки,
		ЗначениеСвойстваJSONКоллекции(ДанныеJSON, "item", Новый Массив));
	Результат.ДеревоЗапросов = Дерево;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиДереваИзPostmanЭлементов(КоллекцияСтрок, Знач ЭлементыJSON)
	
	Если ТипЗнч(ЭлементыJSON) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементJSON Из ЭлементыJSON Цикл
		ДобавитьСтрокуДереваИзPostmanЭлемента(КоллекцияСтрок, ЭлементJSON);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуДереваИзPostmanЭлемента(КоллекцияСтрок, Знач ЭлементJSON)
	
	Если ТипЗнч(ЭлементJSON) <> Тип("Соответствие") И ТипЗнч(ЭлементJSON) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ВложенныеЭлементы = ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "item", Неопределено);
	ОписаниеЗапроса = ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "request", Неопределено);
	ЭтоГруппа = (ВложенныеЭлементы <> Неопределено) И (ОписаниеЗапроса = Неопределено);
	
	НоваяСтрока = КоллекцияСтрок.Добавить();
	НоваяСтрока.ЭтоГруппа = ЭтоГруппа;
	НоваяСтрока.Наименование = СокрЛП(Строка(ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "name", "")));
	Если ПустаяСтрока(НоваяСтрока.Наименование) Тогда
		НоваяСтрока.Наименование = ?(ЭтоГруппа, "Папка", "Запрос");
	КонецЕсли;
	
	НоваяСтрока.Идентификатор = СокрЛП(Строка(ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "id", "")));
	Если ПустаяСтрока(НоваяСтрока.Идентификатор) Тогда
		НоваяСтрока.Идентификатор = XMLСтрока(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Если ЭтоГруппа Тогда
		Авторизация = АвторизацияИзPostmanAuth(
			ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "auth", Неопределено),
			ИдентификаторТипаАвторизацииНаследоватьОтВладельца());
		ДанныеПапки = Новый Структура;
		ДанныеПапки.Вставить(КлючПоляТипАвторизацииВДанныхЗапроса(), Авторизация.ТипАвторизации);
		ДанныеПапки.Вставить(КлючПоляПараметрыАвторизацииВДанныхЗапроса(), Авторизация.ПараметрыАвторизации);
		НоваяСтрока.ДанныеЗапроса = ЗначениеВСтрокуВнутр(ДанныеПапки);
		ЗаполнитьСтрокиДереваИзPostmanЭлементов(НоваяСтрока.Строки, ВложенныеЭлементы);
	Иначе
		НоваяСтрока.ДанныеЗапроса = ЗначениеВСтрокуВнутр(ДанныеЗапросаИзPostmanЭлемента(ЭлементJSON));
	КонецЕсли;
	
	УстановитьКартинкуСтрокиСписка(НоваяСтрока);
	
КонецПроцедуры

&НаСервере
Функция ДанныеЗапросаИзPostmanЭлемента(Знач ЭлементJSON)
	
	КлючТипАвторизации = КлючПоляТипАвторизацииВДанныхЗапроса();
	КлючПараметрыАвторизации = КлючПоляПараметрыАвторизацииВДанныхЗапроса();
	МетодПоУмолчанию = HTTPМетодGET();
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("HTTPМетод", МетодПоУмолчанию);
	ДанныеЗапроса.Вставить("URI", "");
	ДанныеЗапроса.Вставить("ТелоЗапроса", "");
	ДанныеЗапроса.Вставить("ВремяВыполненияЗапроса", "");
	ДанныеЗапроса.Вставить("ЗапросОтвет", "");
	ДанныеЗапроса.Вставить("КодОтвета", 0);
	ДанныеЗапроса.Вставить("ЗаголовкиОтвета", Новый ТаблицаЗначений);
	ДанныеЗапроса.Вставить("ФорматОтветаДляСохранения", "");
	ДанныеЗапроса.Вставить("КонтекстВыполненияЗапроса", "");
	ДанныеЗапроса.Вставить("РежимОтправкиЗапроса", РежимОтправкиЗапросаКлиент());
	ДанныеЗапроса.Вставить("ВариантТелаЗапроса", ВариантТелаЗапросаОтсутствует());
	ДанныеЗапроса.Вставить("ПутьКФайлуВх", "");
	ДанныеЗапроса.Вставить("ПоляFormData", НовыйТаблицаПолейFormDataДляИмпорта());
	ДанныеЗапроса.Вставить("ЗаголовкиЗапроса", НовыйТаблицаЗаголовковДляИмпорта());
	ДанныеЗапроса.Вставить("ПараметрыЗапроса", НовыйТаблицаПараметровЗапросаДляИмпорта());
	
	ОписаниеЗапроса = ЗначениеСвойстваJSONКоллекции(ЭлементJSON, "request", Неопределено);
	Если ОписаниеЗапроса = Неопределено Тогда
		АвторизацияПустая = АвторизацияИзPostmanAuth(
			Неопределено,
			ИдентификаторТипаАвторизацииНаследоватьОтВладельца());
		ДанныеЗапроса.Вставить(КлючТипАвторизации, АвторизацияПустая.ТипАвторизации);
		ДанныеЗапроса.Вставить(КлючПараметрыАвторизации, АвторизацияПустая.ПараметрыАвторизации);
		Возврат ДанныеЗапроса;
	КонецЕсли;
	
	Если ТипЗнч(ОписаниеЗапроса) = Тип("Строка") Тогда
		ДанныеЗапроса.URI = ОписаниеЗапроса;
		АвторизацияПустая = АвторизацияИзPostmanAuth(
			Неопределено,
			ИдентификаторТипаАвторизацииНаследоватьОтВладельца());
		ДанныеЗапроса.Вставить(КлючТипАвторизации, АвторизацияПустая.ТипАвторизации);
		ДанныеЗапроса.Вставить(КлючПараметрыАвторизации, АвторизацияПустая.ПараметрыАвторизации);
		Возврат ДанныеЗапроса;
	КонецЕсли;
	
	МетодИзJSON = ЗначениеСвойстваJSONКоллекции(ОписаниеЗапроса, "method", МетодПоУмолчанию);
	ДанныеЗапроса.HTTPМетод = ВРег(СокрЛП(Строка(МетодИзJSON)));
	Если ПустаяСтрока(ДанныеЗапроса.HTTPМетод) Тогда
		ДанныеЗапроса.HTTPМетод = МетодПоУмолчанию;
	КонецЕсли;
	
	ЗаполнитьURIИПараметрыИзPostmanUrl(
		ДанныеЗапроса,
		ЗначениеСвойстваJSONКоллекции(ОписаниеЗапроса, "url", Неопределено));
	
	ДанныеЗапроса.ЗаголовкиЗапроса = ТаблицаЗаголовковИзPostmanМассива(
		ЗначениеСвойстваJSONКоллекции(ОписаниеЗапроса, "header", Новый Массив));
	
	ЗаполнитьТелоИзPostmanBody(
		ДанныеЗапроса,
		ЗначениеСвойстваJSONКоллекции(ОписаниеЗапроса, "body", Неопределено));
	
	Авторизация = АвторизацияИзPostmanAuth(
		ЗначениеСвойстваJSONКоллекции(ОписаниеЗапроса, "auth", Неопределено),
		ИдентификаторТипаАвторизацииНаследоватьОтВладельца());
	ДанныеЗапроса.Вставить(КлючТипАвторизации, Авторизация.ТипАвторизации);
	ДанныеЗапроса.Вставить(КлючПараметрыАвторизации, Авторизация.ПараметрыАвторизации);
	
	Возврат ДанныеЗапроса;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьURIИПараметрыИзPostmanUrl(ДанныеЗапроса, Знач ОписаниеURL)
	
	Если ОписаниеURL = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ОписаниеURL) = Тип("Строка") Тогда
		ДанныеЗапроса.URI = ОписаниеURL;
		Возврат;
	КонецЕсли;
	
	ДанныеЗапроса.URI = Строка(ЗначениеСвойстваJSONКоллекции(ОписаниеURL, "raw", ""));
	Если ПустаяСтрока(ДанныеЗапроса.URI) Тогда
		ДанныеЗапроса.URI = СобратьURIИзPostmanUrlЧастей(ОписаниеURL);
	КонецЕсли;
	
	ДанныеЗапроса.ПараметрыЗапроса = ТаблицаПараметровЗапросаИзPostmanQuery(
		ЗначениеСвойстваJSONКоллекции(ОписаниеURL, "query", Новый Массив));
	
КонецПроцедуры

&НаСервере
Функция СобратьURIИзPostmanUrlЧастей(Знач ОписаниеURL)
	
	Протокол = Строка(ЗначениеСвойстваJSONКоллекции(ОписаниеURL, "protocol", ""));
	Хост = ЗначениеСвойстваJSONКоллекции(ОписаниеURL, "host", Неопределено);
	Путь = ЗначениеСвойстваJSONКоллекции(ОписаниеURL, "path", Неопределено);
	
	СтрокаХоста = "";
	Если ТипЗнч(Хост) = Тип("Массив") Тогда
		СтрокаХоста = СтрСоединить(Хост, ".");
	ИначеЕсли Хост <> Неопределено Тогда
		СтрокаХоста = Строка(Хост);
	Иначе
		СтрокаХоста = "";
	КонецЕсли;
	
	СтрокаПути = "";
	Если ТипЗнч(Путь) = Тип("Массив") Тогда
		СтрокаПути = "/" + СтрСоединить(Путь, "/");
	ИначеЕсли Путь <> Неопределено Тогда
		СтрокаПути = "/" + Строка(Путь);
	Иначе
		СтрокаПути = "";
	КонецЕсли;
	
	Если ПустаяСтрока(Протокол) Тогда
		Возврат СтрокаХоста + СтрокаПути;
	КонецЕсли;
	
	Возврат Протокол + "://" + СтрокаХоста + СтрокаПути;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТелоИзPostmanBody(ДанныеЗапроса, Знач ОписаниеТела)
	
	Если ОписаниеТела = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючRaw = КлючJSONRaw();
	РежимТела = НРег(Строка(ЗначениеСвойстваJSONКоллекции(ОписаниеТела, КлючJSONMode(), "")));
	
	Если РежимТела = КлючRaw Тогда
		ДанныеЗапроса.ТелоЗапроса = Строка(ЗначениеСвойстваJSONКоллекции(ОписаниеТела, КлючRaw, ""));
		Язык = "";
		Опции = ЗначениеСвойстваJSONКоллекции(ОписаниеТела, "options", Неопределено);
		Если Опции <> Неопределено Тогда
			ОпцииRaw = ЗначениеСвойстваJSONКоллекции(Опции, КлючRaw, Неопределено);
			Если ОпцииRaw <> Неопределено Тогда
				Язык = НРег(Строка(ЗначениеСвойстваJSONКоллекции(ОпцииRaw, "language", "")));
			КонецЕсли;
		КонецЕсли;
		Если Язык = "xml" Тогда
			ДанныеЗапроса.ВариантТелаЗапроса = ВариантТелаЗапросаXML();
		Иначе
			ДанныеЗапроса.ВариантТелаЗапроса = "JSON";
		КонецЕсли;
	ИначеЕсли РежимТела = "formdata" Тогда
		ДанныеЗапроса.ВариантТелаЗапроса = "FORM_DATA";
		ДанныеЗапроса.ПоляFormData = ТаблицаFormDataИзPostmanМассива(
			ЗначениеСвойстваJSONКоллекции(ОписаниеТела, "formdata", Новый Массив));
	ИначеЕсли РежимТела = "file" Тогда
		ДанныеЗапроса.ВариантТелаЗапроса = "BINARY";
		ДанныеЗапроса.ПутьКФайлуВх = "";
	Иначе
		ДанныеЗапроса.ВариантТелаЗапроса = ВариантТелаЗапросаОтсутствует();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьОбъектGetManHTTPКоллекции(Знач СтрокаКоллекции)
	
	Результат = Новый Структура;
	Результат.Вставить("format", ИдентификаторФорматаКоллекцииGetManHTTP());
	Результат.Вставить("schemaVersion", ВерсияСхемыКоллекцииGetManHTTP());
