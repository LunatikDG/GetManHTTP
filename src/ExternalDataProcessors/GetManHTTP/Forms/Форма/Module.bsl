// Реквизиты формы (Form.form): BSL LS без связи с метаданными считает их локальными переменными.
// BSLLS:UnusedLocalVariable-off
// Имена с URI/HTML/JSON и т.п. намеренно смешивают латиницу и кириллицу.
// BSLLS:LatinAndCyrillicSymbolInWord-off

#Область ОписаниеПеременных

// Флаг блокировки повторного входа при синхронизации URI и таблицы параметров запроса.
&НаКлиенте
Перем ИдетСинхронизацияURIПараметров;

#КонецОбласти

#Область ОбработчикиСобытийФормы

// BSLLS:UnusedLocalMethod-off

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбеспечитьРеквизитСписокЗапросовДеревом();
	УстановитьЗаголовокФормыПоВерсии();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ИдетСинхронизацияURIПараметров = Ложь;
	НастроитьКоманднуюПанельСпискаЗапросов();
	УстановитьДоступностьОбластиЗапроса(Ложь);
	ВосстановитьНастройкиОбработки();
	ИнициализироватьСписокЗапросовПослеОткрытия();
	ПодключитьАвтосохранениеНастроек();
	ОбновитьСписокВыбораКоллекцийНаКлиенте();
	ОтображаемаяКоллекция = ТекущаяКоллекция;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если АвтосохранениеВключено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗакрытиеПодтверждено Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
	ПоказатьВопрос(
		ОписаниеОповещения,
		"Сохранить данные формы?",
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	ОтключитьОбработчикОжидания("АвтосохранениеНастроек");
	
	// При завершении работы платформы хранилище системных настроек недоступно.
	// При выключенном автосохранении сохранение выполняется по ответу в ПередЗакрытием.
	Если Не ЗавершениеРаботы И АвтосохранениеВключено Тогда
		СохранитьНастройкиОбработки();
	КонецЕсли;
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура ТипАвторизацииПриИзменении(Элемент)
	
	ПараметрыАвторизации.Очистить();
	ПерестроитьПараметрыАвторизацииПоСхеме();
	ОтобразитьПоляАвторизацииПоСхеме();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеАвторизацииПриИзменении(Элемент)
	
	СинхронизироватьПараметрыАвторизацииИзПолейФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура URIПриИзменении(Элемент)
	
	Если ИдетСинхронизацияURIПараметров Тогда
		Возврат;
	КонецЕсли;
	
	ИдетСинхронизацияURIПараметров = Истина;
	URI = СинхронизироватьПараметрыИURIИзСтрокиURIНаСервере();
	ИдетСинхронизацияURIПараметров = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ТелоЗапросаПриИзменении(Элемент)
	БьютифицированныйЗапрос(ТелоЗапроса, "ТелоЗапроса", ВариантТелаЗапроса);
КонецПроцедуры

&НаКлиенте
Процедура ВариантТелаЗапросаПриИзменении(Элемент)
	
	Если ВариантТелаЗапроса = "NONE" Тогда
		ТелоЗапроса = "";
		ПутьКФайлуВх = "";
	КонецЕсли;
	
	ОтобразитьВариантТелаЗапроса();
	
КонецПроцедуры

&НаКлиенте
Процедура КоллекцияЗапросовПриИзменении(Элемент)
	
	Если ИдетПереключениеКоллекции Тогда
		Возврат;
	КонецЕсли;
	
	НовыйИдентификатор = ТекущаяКоллекция;
	Если ПустаяСтрока(НовыйИдентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	Если НовыйИдентификатор = ОтображаемаяКоллекция Тогда
		Возврат;
	КонецЕсли;
	
	ИдетПереключениеКоллекции = Истина;
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		ДанныеПереключения = ПереключитьКоллекциюЗапросовНаСервере(
			НовыйИдентификатор,
			ОтображаемаяКоллекция);
		ОтображаемаяКоллекция = НовыйИдентификатор;
		ПрименитьПереключениеКоллекцииНаКлиенте(ДанныеПереключения);
	Исключение
		ТекущаяКоллекция = ОтображаемаяКоллекция;
		ИдетПереключениеКоллекции = Ложь;
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеКоллекции = Ложь;
	ИдетПереключениеЗапроса = Ложь;
	ОбновитьСписокВыбораКоллекцийНаКлиенте();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура ПараметрыЗапросаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		Элементы.ПараметрыЗапроса.ТекущиеДанные.Активен = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаголовкиЗапросаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		Элементы.ЗаголовкиЗапроса.ТекущиеДанные.Активен = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЗапросаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьURIИзПараметровЗапросаНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЗапросаПослеУдаления(Элемент)
	
	ОбновитьURIИзПараметровЗапросаНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЗапросаАктивенПриИзменении(Элемент)
	
	ОбновитьURIИзПараметровЗапросаНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьURIИзПараметровЗапросаНаКлиенте()
	
	Если ИдетСинхронизацияURIПараметров Тогда
		Возврат;
	КонецЕсли;
	
	ИдетСинхронизацияURIПараметров = Истина;
	URI = СобратьURIСПараметрамиЗапросаНаСервере();
	ИдетСинхронизацияURIПараметров = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗапросовПриАктивизацииСтроки(Элемент)
	
	Если ИдетПереключениеЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Идентификатор = ИдентификаторТекущегоЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
			ЗаписатьТекущийЭлементВСписокНаСервере(ИдентификаторТекущегоЗапроса);
		КонецЕсли;
		
		ИдентификаторТекущегоЗапроса = ТекущиеДанные.Идентификатор;
		
		Если ТекущиеДанные.ЭтоГруппа Тогда
			ЗагрузитьАвторизациюЭлементаИзСпискаНаСервере(ИдентификаторТекущегоЗапроса);
			УстановитьРежимОбластиЗапроса("ТолькоАвторизация");
			ОтобразитьПоляАвторизацииПоСхеме();
		Иначе
			ЗагрузитьЗапросИзСпискаНаСервере(ИдентификаторТекущегоЗапроса);
			УстановитьРежимОбластиЗапроса("Полный");
			ОбновитьОтображениеФормыЗапроса();
		КонецЕсли;
	Исключение
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеЗапроса = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗапросовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Если ИдетПереключениеЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	Если Копирование Тогда
		СкопироватьЗапрос(Неопределено);
	ИначеЕсли Группа Тогда
		ДобавитьПапку(Неопределено);
	Иначе
		ДобавитьЗапрос(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗапросовОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	
	Если ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторТекущейСтроки = "";
	ТекущиеДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ИдентификаторТекущейСтроки = ТекущиеДанные.Идентификатор;
	КонецЕсли;
	
	НормализоватьСтруктуруСпискаЗапросовПослеИзмененияНаСервере();
	
	Если Не ПустаяСтрока(ИдентификаторТекущейСтроки) Тогда
		УстановитьТекущуюСтрокуСпискаЗапросов(ИдентификаторТекущейСтроки);
	КонецЕсли;
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиКомандФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура Отправить(Команда)
	
	ПроверкаУсловий = УсловияОтправкиВыполнены();
	
	Если ПроверкаУсловий.УсловияВыполнены  Тогда
		ИдетСинхронизацияURIПараметров = Истина;
		URI = СобратьURIСПараметрамиЗапросаНаСервере();
		ИдетСинхронизацияURIПараметров = Ложь;
		ОтправитьHTTPЗапрос(СтруктураURI(URI));
	Иначе
		ВывестиСообщениеПользователю("Запрос не может быть отправлен, поскольку не все обязательные поля были заполнены");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВходящийФайл(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл который хотите передать";
	Диалог.Показать(Новый ОписаниеОповещения("ВыбратьФайлЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтветВФайл(Команда)
	
	Если ПустаяСтрока(ЗапросОтвет) Тогда
		ВывестиСообщениеПользователю("Нет данных для сохранения");
		Возврат;
	КонецЕсли;
	
	ФорматОтвета = ФорматОтветаДляСохранения;
	Если ПустаяСтрока(ФорматОтвета) Тогда
		ФорматОтвета = ОпределитьФорматОтветаДляСохранения();
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить результат запроса";
	ЗаполнитьПараметрыДиалогаСохраненияПоФормату(Диалог, ФорматОтвета);
	Диалог.Показать(Новый ОписаниеОповещения("СохранитьОтветВФайлЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура Настройки(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Таймаут", Таймаут);
	ПараметрыФормы.Вставить("АвтосохранениеВключено", АвтосохранениеВключено);
	ПараметрыФормы.Вставить("ИнтервалАвтосохранения", ИнтервалАвтосохранения);
	ПараметрыФормы.Вставить("РежимОтправкиПоУмолчанию", РежимОтправкиПоУмолчанию);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("НастройкиЗавершение", ЭтотОбъект);
	
	ОткрытьФорму(
		ПолучитьИмяОбработки() + ".Форма.ФормаНастроек",
		ПараметрыФормы,
		ЭтотОбъект,
		,
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиКоллекцииЗапросов(Команда)
	
	ПараметрыКоллекции = ПолучитьПараметрыТекущейКоллекцииНаСервере();
	Если ПараметрыКоллекции = Неопределено Тогда
		ВывестиСообщениеПользователю("Не выбрана коллекция запросов");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("НастройкиКоллекцииЗапросовЗавершение", ЭтотОбъект);
	
	ОткрытьФорму(
		ПолучитьИмяОбработки() + ".Форма.ФормаКоллекцииЗапросов",
		ПараметрыКоллекции,
		ЭтотОбъект,
		,
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКоллекциюЗапросов(Команда)
	
	ИдетПереключениеКоллекции = Истина;
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		ДанныеПереключения = ДобавитьКоллекциюЗапросовНаСервере();
		ТекущаяКоллекция = ДанныеПереключения.ИдентификаторКоллекции;
		ОтображаемаяКоллекция = ТекущаяКоллекция;
		ПрименитьПереключениеКоллекцииНаКлиенте(ДанныеПереключения);
	Исключение
		ИдетПереключениеКоллекции = Ложь;
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеКоллекции = Ложь;
	ИдетПереключениеЗапроса = Ложь;
	ОбновитьСписокВыбораКоллекцийНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКоллекциюЗапросов(Команда)
	
	Если ПустаяСтрока(ТекущаяКоллекция) Тогда
		ВывестиСообщениеПользователю("Не выбрана коллекция запросов");
		Возврат;
	КонецЕсли;
	
	ДанныеПодтверждения = ПолучитьДанныеПодтвержденияУдаленияКоллекцииНаСервере(ТекущаяКоллекция);
	Если Не ДанныеПодтверждения.МожноУдалить Тогда
		ВывестиСообщениеПользователю(ДанныеПодтверждения.Сообщение);
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтрШаблон(
		"Удалить коллекцию ""%1""? Все запросы в ней будут удалены без возможности восстановления.",
		ДанныеПодтверждения.Наименование);
	
	ДополнительныеПараметры = Новый Структура("ИдентификаторКоллекции", ТекущаяКоллекция);
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"УдалитьКоллекциюЗапросовЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПапку(Команда)
	
	Если ИдетПереключениеЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторТекущейСтроки = "";
	ТекущаяСтрокаЭтоГруппа = Ложь;
	ТекущиеДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ИдентификаторТекущейСтроки = ТекущиеДанные.Идентификатор;
		ТекущаяСтрокаЭтоГруппа = ТекущиеДанные.ЭтоГруппа;
	КонецЕсли;
	
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
			ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
		КонецЕсли;
		
		НовыйИдентификатор = ДобавитьПапкуВСписокНаСервере(ИдентификаторТекущейСтроки, ТекущаяСтрокаЭтоГруппа);
		НормализоватьСтруктуруСпискаЗапросовПослеИзмененияНаСервере();
		ИдентификаторТекущегоЗапроса = НовыйИдентификатор;
		УстановитьТекущуюСтрокуСпискаЗапросов(НовыйИдентификатор);
		ЗагрузитьАвторизациюЭлементаИзСпискаНаСервере(НовыйИдентификатор);
		УстановитьРежимОбластиЗапроса("ТолькоАвторизация");
		ОтобразитьПоляАвторизацииПоСхеме();
	Исключение
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеЗапроса = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗапрос(Команда)
	
	Если ИдетПереключениеЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторТекущейСтроки = "";
	ТекущаяСтрокаЭтоГруппа = Ложь;
	ТекущиеДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ИдентификаторТекущейСтроки = ТекущиеДанные.Идентификатор;
		ТекущаяСтрокаЭтоГруппа = ТекущиеДанные.ЭтоГруппа;
	КонецЕсли;
	
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
			ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
		КонецЕсли;
		
		НовыйИдентификатор = ДобавитьЗапросВСписокНаСервере(ИдентификаторТекущейСтроки, ТекущаяСтрокаЭтоГруппа, Истина);
		ИдентификаторТекущегоЗапроса = НовыйИдентификатор;
		УстановитьТекущуюСтрокуСпискаЗапросов(НовыйИдентификатор);
		ЗагрузитьЗапросИзСпискаНаСервере(НовыйИдентификатор);
		УстановитьДоступностьОбластиЗапроса(Истина);
		ОбновитьОтображениеФормыЗапроса();
	Исключение
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеЗапроса = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьЗапрос(Команда)
	
	Если ИдетПереключениеЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторИсходнойСтроки = ТекущиеДанные.Идентификатор;
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
			ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
		КонецЕсли;
		
		НовыйИдентификатор = СкопироватьЭлементСпискаЗапросовНаСервере(ИдентификаторИсходнойСтроки);
		Если ПустаяСтрока(НовыйИдентификатор) Тогда
			Возврат;
		КонецЕсли;
		
		НормализоватьСтруктуруСпискаЗапросовПослеИзмененияНаСервере();
		УстановитьТекущуюСтрокуСпискаЗапросов(НовыйИдентификатор);
		
		Если Не ТекущиеДанные.ЭтоГруппа Тогда
			ИдентификаторТекущегоЗапроса = НовыйИдентификатор;
			ЗагрузитьЗапросИзСпискаНаСервере(НовыйИдентификатор);
			УстановитьДоступностьОбластиЗапроса(Истина);
			ОбновитьОтображениеФормыЗапроса();
		Иначе
			ИдентификаторТекущегоЗапроса = НовыйИдентификатор;
			ЗагрузитьАвторизациюЭлементаИзСпискаНаСервере(НовыйИдентификатор);
			УстановитьРежимОбластиЗапроса("ТолькоАвторизация");
			ОтобразитьПоляАвторизацииПоСхеме();
		КонецЕсли;
	Исключение
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеЗапроса = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНаименованиеСпискаЗапросов(Команда)
	
	Если Элементы.СписокЗапросов.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийЭлемент = Элементы.СписокЗапросов;
	ПодключитьОбработчикОжидания(
		"СписокЗапросовНачатьИзменениеСтроки",
		ЗадержкаСекундПередИзменениемСтрокиСпискаЗапросов(),
		Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗапросовНачатьИзменениеСтроки()
	
	Если Элементы.СписокЗапросов.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.СписокЗапросов.ИзменитьСтроку();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗапрос(Команда)
	
	ТекущиеДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторУдаляемого = ТекущиеДанные.Идентификатор;
	РазвернутыеПапки = СобратьИдентификаторыРазвернутыхПапокСпискаЗапросовНаКлиенте();
	
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		РезультатУдаления = УдалитьЭлементИзСпискаНаСервере(ИдентификаторУдаляемого);
		ИдентификаторТекущегоЗапроса = РезультатУдаления.ИдентификаторЗапроса;
		УстановитьТекущуюСтрокуСпискаЗапросов(РезультатУдаления.ИдентификаторСтрокиСписка);
		ВосстановитьРазвернутыеПапкиСпискаЗапросовНаКлиенте(РазвернутыеПапки);
		
		Если РезультатУдаления.ЭтоГруппа Тогда
			ЗагрузитьАвторизациюЭлементаИзСпискаНаСервере(ИдентификаторТекущегоЗапроса);
			УстановитьРежимОбластиЗапроса("ТолькоАвторизация");
			ОтобразитьПоляАвторизацииПоСхеме();
		Иначе
			ЗагрузитьЗапросИзСпискаНаСервере(ИдентификаторТекущегоЗапроса);
			УстановитьДоступностьОбластиЗапроса(Истина);
			ОбновитьОтображениеФормыЗапроса();
		КонецЕсли;
	Исключение
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеЗапроса = Ложь;
	
КонецПроцедуры

