КонецПроцедуры

// Записывает текст в бьютифицированном виде (JSON или XML).
//
// Параметры:
//	СтрокаОтвета - Строка - Текст для форматирования.
//	Поле         - Строка - Имя реквизита формы для записи результата.
//	Формат       - Строка - "JSON", "XML" или "AUTO" (определение формата автоматически).
//
&НаКлиенте
Процедура БьютифицированныйЗапрос(Знач СтрокаОтвета, Знач Поле, Знач Формат = "JSON")

	Если ПустаяСтрока(СтрокаОтвета) ИЛИ ПустаяСтрока(Поле) Тогда
		Возврат;
	КонецЕсли;
	
	#Если НЕ ВебКлиент Тогда
		
		Если Формат = "AUTO" Тогда
			
			ФорматированиеВыполнено = БьютифицироватьJSON(СтрокаОтвета, Поле);
			
			Если Не ФорматированиеВыполнено Тогда
				ФорматированиеВыполнено = БьютифицироватьXML(СтрокаОтвета, Поле);
			КонецЕсли;
			
			Если Не ФорматированиеВыполнено Тогда
				ЭтотОбъект[Поле] = СтрокаОтвета;
			КонецЕсли;
			
		ИначеЕсли Формат = "XML" Тогда
			
			Если Не БьютифицироватьXML(СтрокаОтвета, Поле) Тогда
				ЭтотОбъект[Поле] = СтрокаОтвета;
			КонецЕсли;
			
		Иначе
			
			Если Не БьютифицироватьJSON(СтрокаОтвета, Поле) Тогда
				ЭтотОбъект[Поле] = СтрокаОтвета;
			КонецЕсли;
			
		КонецЕсли;
		
	#Иначе
		ЭтотОбъект[Поле] = СтрокаОтвета;
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Функция БьютифицироватьJSON(Знач СтрокаJSON, Знач Поле)
	
	Попытка
		
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(СтрокаJSON);
		
		Данные = ПрочитатьJSON(Чтение);
		
		Запись = Новый ЗаписьJSON();
		ПараметрыJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
		Запись.УстановитьСтроку(ПараметрыJSON);

		ЗаписатьJSON(Запись, Данные);
		
		ЭтотОбъект[Поле] = Запись.Закрыть();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция БьютифицироватьXML(Знач СтрокаXML, Знач Поле)
	
	Попытка
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		ЗаписьDOM = Новый ЗаписьDOM;
		ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
		ЭтотОбъект[Поле] = ЗаписьXML.Закрыть();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Скрывает группы авторизаций на форме
//
&НаКлиенте
Процедура СкрытьГруппыАвторизаций()

	Элементы.ЛогинПароль.Видимость = Ложь;
	Элементы.ГруппаТокен.Видимость = Ложь;

КонецПроцедуры

// Сформировать заголовки запроса
// 
// Возвращаемое значение:
//	Произвольный - заголовки HTTP-запроса
//
&НаКлиенте
Функция ЗаголовкиЗапроса()

	ЗаголовкиЗапросаПользователя = ЗаголовкиВСоответствие();
	
	// Дополняем заголовки авторизацией
	Если ТипАвторизации = "Token" Тогда
		СтрокаТокена = ?(ПустаяСтрока(НаименованиеТокена), "Token ", НаименованиеТокена + " ") + ТокенАвторизации;
		ЗаголовкиЗапросаПользователя.Вставить("Authorization", СтрокаТокена);
	КонецЕсли;

	Возврат ЗаголовкиЗапросаПользователя;

КонецФункции

// Проверяет выполнение всех условий для отправки HTTP-запроса
//
// Возвращаемое значение:
//	Структура:
//		* УсловияВыполнены - Булево - Признак того может ли быть отправлен HTTP-запроса
//
&НаКлиенте
Функция УсловияОтправкиВыполнены()
	Результат = Новый Структура;
	
	Результат.Вставить("УсловияВыполнены", Ложь);
	
	// Проверяем поля
	Если НЕ ПустаяСтрока(URI) И НЕ ПустаяСтрока(HTTPМетод) Тогда
		Результат.УсловияВыполнены = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разбирает строку URI на составные части и возвращает в виде структуры.
// На основе RFC 3986.
//
// Параметры:
//  СтрокаURI - Строка - ссылка на ресурс в формате:
//                       <схема>://<логин>:<пароль>@<хост>:<порт>/<путь>?<параметры>#<якорь>.
//
// Возвращаемое значение:
//  Структура - составные части URI согласно формату:
//   * Схема        	- Строка - схема из URI.
//   * Логин         	- Строка - логин из URI.
//   * Пароль        	- Строка - пароль из URI.
//   * ИмяСервера    	- Строка - часть <хост>:<порт> из URI.
//   * Хост          	- Строка - хост из URI.
//   * Порт          	- Число, Неопределено - порт из URI.
//   * ПутьНаСервере 	- Строка - часть <путь>?<параметры>#<якорь> из URI.
//   * ТипАвторизации 	- Строка - Используемый тип авторизации
//
&НаКлиенте
Функция СтруктураURI(Знач СтрокаURI) Экспорт
	
	СтрокаURI = СокрЛП(СтрокаURI);
	
	// схема
	Схема = "";
	Позиция = СтрНайти(СтрокаURI, "://");
	Если Позиция > 0 Тогда
		Схема = НРег(Лев(СтрокаURI, Позиция - 1));
		СтрокаURI = Сред(СтрокаURI, Позиция + 3);
	КонецЕсли;
	
	// Строка соединения и путь на сервере.
	СтрокаСоединения = СтрокаURI;
	ПутьНаСервере = "";
	Позиция = СтрНайти(СтрокаСоединения, "/");
	Если Позиция > 0 Тогда
		ПутьНаСервере = Сред(СтрокаСоединения, Позиция + 1);
		СтрокаСоединения = Лев(СтрокаСоединения, Позиция - 1);
	КонецЕсли;
	
	// Информация пользователя и имя сервера.
	СтрокаАвторизации = "";
	ИмяСервера = СтрокаСоединения;
	Позиция = СтрНайти(СтрокаСоединения, "@");
	Если Позиция > 0 Тогда
		СтрокаАвторизации = Лев(СтрокаСоединения, Позиция - 1);
		ИмяСервера = Сред(СтрокаСоединения, Позиция + 1);
	КонецЕсли;
	
	// логин и пароль
	Логин = СтрокаАвторизации;
	Пароль = "";
	Позиция = СтрНайти(СтрокаАвторизации, ":");
	Если Позиция > 0 Тогда
		Логин = Лев(СтрокаАвторизации, Позиция - 1);
		Пароль = Сред(СтрокаАвторизации, Позиция + 1);
	КонецЕсли;
	
	// хост и порт
	Хост = ИмяСервера;
	Порт = "";
	Позиция = СтрНайти(ИмяСервера, ":");
	Если Позиция > 0 Тогда
		Хост = Лев(ИмяСервера, Позиция - 1);
		Порт = Сред(ИмяСервера, Позиция + 1);
		Если Не ТолькоЦифрыВСтроке(Порт) Тогда
			Порт = "";
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Схема", Схема);
	Результат.Вставить("Логин", Логин);
	Результат.Вставить("Пароль", Пароль);
	Результат.Вставить("ИмяСервера", ИмяСервера);
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Порт", ?(ПустаяСтрока(Порт), Неопределено, Число(Порт)));
	Результат.Вставить("ПутьНаСервере", ПутьНаСервере);
	Результат.Вставить("ТипАвторизации", "");
	
	ДополнитьАвторизациюВСтруктурURI(Результат);
	
	ДополнитьПараметрыЗапросаВСтруктуруURI(Результат);

	Возврат Результат;
	
	
КонецФункции

// Проверяет, содержит ли строка только цифры.
//
// Параметры:
//  Значение         - Строка - проверяемая строка.
//  Устаревший       - Булево - устаревший параметр, не используется.
//  ПробелыЗапрещены - Булево - если Ложь, то в строке допустимо наличие пробелов.
//
// Возвращаемое значение:
//   Булево - Истина - строка содержит только цифры или пустая, Ложь - строка содержит иные символы.
//
// Пример:
//  Результат = СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке("0123"); // Истина
//  Результат = СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке("0123abc"); // Ложь
//  Результат = СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке("01 2 3",, Ложь); // Истина
//
&НаКлиенте
Функция ТолькоЦифрыВСтроке(Знач Значение, Знач Устаревший = Истина, Знач ПробелыЗапрещены = Истина) Экспорт
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПробелыЗапрещены Тогда
		Значение = СтрЗаменить(Значение, " ", "");
	КонецЕсли;
		
	Если СтрДлина(Значение) = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Цифры = "0123456789";
	
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		
		Если СтрНайти(Цифры, Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Дополняет структуру URI авторизацией (Basic Auth)
// 
// Параметры:
//	URI - Структура:
//			- см. СтруктураURI
&НаКлиенте
Процедура ДополнитьАвторизациюВСтруктурURI(URI)

	URI.ТипАвторизации = ТипАвторизации;
	
	Если ТипАвторизации = "BasicAuth" Тогда
		URI.Логин = ЛогинBasicAuth;
		URI.Пароль = ПарольBasicAuth;
	КонецЕсли;

КонецПроцедуры

// Дополнить структуру URI параметрами запроса
// Параметры:
//	URI - Структура:
//			- см. СтруктураURI
&НаКлиенте
Процедура ДополнитьПараметрыЗапросаВСтруктуруURI(URI)

	URI.ПутьНаСервере = URI.ПутьНаСервере + ПараметрыВСтроку();

КонецПроцедуры

// Отправка HTTP-запроса по указанным данным пользователем
// Параметры:
//	URI - Структура:
//			- см. СтруктураURI
//
&НаКлиенте
Асинх Процедура ОтправитьHTTPЗапросАсинх(URI)
	
	ЗначенияПоУмолчанию();
	ТекстОтвета = "";
	
	HTTPСоединение = СоздатьHTTPСоединение(URI);
	
	HTTPЗапрос = Новый HTTPЗапрос(URI.ПутьНаСервере);
	
	СформироватьТелоЗапроса(HTTPЗапрос);
	
	HTTPЗапрос.Заголовки = ЗаголовкиЗапроса();
	УстановитьЗаголовокТелаFormData(HTTPЗапрос);
	
	СтартЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Обещание  = HTTPСоединение.ВызватьHTTPМетодАсинх(HTTPМетод, HTTPЗапрос);
	
	Результат = Ждать Обещание;
	
	КонецЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ВремяВыполненияЗапроса = Строка(КонецЗамера - СтартЗамера) + " ms";
	
	КодОтвета = Результат.КодСостояния;
	
	ЗаполнитьЗаголовкиОтвета(Результат.Заголовки);
	
	ТекстОтвета = Результат.ПолучитьТелоКакСтроку();

	ФорматОтветаДляСохранения = ОпределитьФорматПоЗаголовкамИТелу(Результат.Заголовки, ТекстОтвета);
	БьютифицированныйЗапрос(ТекстОтвета, "ЗапросОтвет", "AUTO");
	
КонецПроцедуры

// Создаёт HTTP-соединение с учётом схемы, авторизации и таймаута из настроек.
//
// Параметры:
//  URI - Структура - см. СтруктураURI.
//
// Возвращаемое значение:
//  HTTPСоединение - готовое соединение для выполнения запроса.
//
&НаКлиенте
Функция СоздатьHTTPСоединение(URI)
	
	Порт = URI.Порт;
	Если Порт = Неопределено Тогда
		Если URI.Схема = "https" Тогда
			Порт = 443;
		Иначе
			Порт = 80;
		КонецЕсли;
	КонецЕсли;
	
	ТаймаутСоединения = Таймаут;
	Если ТаймаутСоединения = Неопределено Тогда
		ТаймаутСоединения = 0;
	КонецЕсли;
	
	ЗащищенноеСоединение = Неопределено;
	Если URI.Схема = "https" Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	КонецЕсли;
	
	Если URI.ТипАвторизации = "BasicAuth" Тогда
		Возврат Новый HTTPСоединение(
			URI.Хост,
			Порт,
			URI.Логин,
			URI.Пароль,
			,
			ТаймаутСоединения,
			ЗащищенноеСоединение);
	Иначе
		Возврат Новый HTTPСоединение(
			URI.Хост,
			Порт,
			,
			,
			,
			ТаймаутСоединения,
			ЗащищенноеСоединение);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура СформироватьТелоЗапроса(HTTPЗапроса)
	
	ГраницаFormData = "";
	
	Если ВариантТелаЗапроса = "JSON" ИЛИ ВариантТелаЗапроса = "XML" Тогда
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			HTTPЗапроса.УстановитьТелоИзСтроки(ТелоЗапроса);
		КонецЕсли;
	КонецЕсли;
	
	Если ВариантТелаЗапроса = "BINARY" Тогда
		Если ЗначениеЗаполнено(ПутьКФайлуВх) Тогда
			HTTPЗапроса.УстановитьТелоИзДвоичныхДанных(Новый ДвоичныеДанные(ПутьКФайлуВх));
		Иначе
			ВывестиСообщениеПользователю("Предупреждение! Не выбран файл для отправки!");
		КонецЕсли;
	КонецЕсли;
	
	Если ВариантТелаЗапроса = "FORM_DATA" Тогда
		СформироватьТелоFormData(HTTPЗапроса);
	КонецЕсли;
	
КонецПроцедуры

// Собирает multipart/form-data тело из таблицы текстовых полей.
//
// Параметры:
//  HTTPЗапроса - HTTPЗапрос - запрос, в который записывается тело.
//
&НаКлиенте
Процедура СформироватьТелоFormData(HTTPЗапроса)
	
	ГраницаFormData = "GetManBoundary" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ЧастиТела = Новый Массив;
	
	Для Каждого СтрокаПоля Из ПоляFormData Цикл
		
		Если ПустаяСтрока(СтрокаПоля.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = СтрЗаменить(СтрокаПоля.Ключ, """", "");
		
		ЧастиТела.Добавить("--" + ГраницаFormData);
		ЧастиТела.Добавить("Content-Disposition: form-data; name=""" + ИмяПоля + """");
		ЧастиТела.Добавить("");
		ЧастиТела.Добавить(Строка(СтрокаПоля.Значение));
		
	КонецЦикла;
	
	Если ЧастиТела.Количество() = 0 Тогда
		ВывестиСообщениеПользователю("Предупреждение! Не заполнены поля form-data!");
		ГраницаFormData = "";
		Возврат;
	КонецЕсли;
	
	ЧастиТела.Добавить("--" + ГраницаFormData + "--");
	ЧастиТела.Добавить("");
	
	РазделительСтрок = Символы.ВК + Символы.ПС;
	ТелоFormData = СтрСоединить(ЧастиТела, РазделительСтрок);
	HTTPЗапроса.УстановитьТелоИзСтроки(ТелоFormData, КодировкаТекста.UTF8);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокТелаFormData(HTTPЗапроса)
	
	Если ВариантТелаЗапроса <> "FORM_DATA" ИЛИ ПустаяСтрока(ГраницаFormData) Тогда
		Возврат;
	КонецЕсли;
	
	HTTPЗапроса.Заголовки.Вставить(
		"Content-Type",
		"multipart/form-data; boundary=" + ГраницаFormData);
	
КонецПроцедуры

#КонецОбласти

#Область Сервер

// Процедура заполняет реквизит формы заголовков из соответствия
//
// Параметры:
//	Соответствие - Произвольный - Заголовки результата запроса
//
&НаСервере
Процедура ЗаполнитьЗаголовкиОтвета(Знач Соответствие)

	ЗаголовкиОтвета.Загрузить(СоответствиеВЗаголовки(Соответствие));

КонецПроцедуры

// Преобразует таблицу значений в массив структур.
// Может использоваться для передачи на клиент данных в том случае, если таблица
// значений содержит только такие значения, которые могут
// быть переданы с сервера на клиент.
//
// Полученный массив содержит структуры, каждая из которых повторяет
// структуру колонок таблицы значений.
//
// Не рекомендуется использовать для преобразования таблиц значений
// с большим количеством строк.
//
// Возвращаемое значение:
//  Произвольный - коллекция строк таблицы в виде структур.
//
&НаСервере
Функция ЗаголовкиВСоответствие()
    // Создаем пустое соответствие
    Соответствие = Новый Соответствие;
    ЗаголовкиЗапросаТЗ = ЗаголовкиЗапроса.Выгрузить();
    // Проверка наличия строк в таблице
    Если ЗаголовкиЗапросаТЗ.Количество() = 0 Тогда
        Возврат Соответствие; // Возвращаем пустое соответствие
    КонецЕсли;
    
    // Проходим по всем строкам таблицы значений
    Для Каждого Строка Из ЗаголовкиЗапросаТЗ Цикл
        // Проверяем наличие хотя бы двух столбцов
        Если ЗаголовкиЗапросаТЗ.Колонки.Количество() >= 2 Тогда
            Ключ = Строка[0];
            Значение = Строка[1];
            // Добавляем в соответствие
            Соответствие.Вставить(Ключ, Значение);
        КонецЕсли;
    КонецЦикла;
    
    // Возвращаем готовое соответствие
    Возврат Соответствие;
КонецФункции

// Преобразует таблицу значений в массив структур.
// Может использоваться для передачи на клиент данных в том случае, если таблица
// значений содержит только такие значения, которые могут
// быть переданы с сервера на клиент.
//
// Полученный массив содержит структуры, каждая из которых повторяет
// структуру колонок таблицы значений.
//
// Не рекомендуется использовать для преобразования таблиц значений
// с большим количеством строк.
//
// Параметры:
//  Соответствие - Соответствие - коллекция строк таблицы в виде структур.
//  
// Возвращаемое значение:
// 	ТаблицаЗначений:
// 		* КлючЗаголовка - Строка - Ключ соответствия
// 		* ЗначениеЗаголовка - Строка - Значение соответствия
// 		* ОписаниеЗаголовка - Строка - Описание ключа соответствия
//
&НаСервере
Функция СоответствиеВЗаголовки(Знач Соответствие)
	
	ТЗ_Заголовки = Новый ТаблицаЗначений();
	ТЗ_Заголовки.Колонки.Добавить("КлючЗаголовка");
	ТЗ_Заголовки.Колонки.Добавить("ЗначениеЗаголовка");
	ТЗ_Заголовки.Колонки.Добавить("ОписаниеЗаголовка");
	
    // Проходим по всем строкам таблицы значений
    Для Каждого Элемент Из Соответствие Цикл
    	
    	НоваяСтрока = ТЗ_Заголовки.Добавить();
    	
    	НоваяСтрока.КлючЗаголовка = Элемент.Ключ;
    	НоваяСтрока.ЗначениеЗаголовка = Элемент.Значение;
    	
    КонецЦикла;
    
    Возврат ТЗ_Заголовки;
    
КонецФункции

&НаСервере
Функция ПараметрыВСтроку()
	
	СтрокаПараметров = "";
	
	ТаблицаПараметров = ПараметрыЗапроса.Выгрузить();
	
	Для Каждого Параметр Из ТаблицаПараметров Цикл
	
		СтрокаПараметров = СтрокаПараметров + СтрШаблон("%1=%2&", Параметр[0], Параметр[1]);
	
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(СтрокаПараметров) Тогда
		СтрокаПараметров = "?" + Лев(СтрокаПараметров, СтрДлина(СтрокаПараметров)-1);
	КонецЕсли;
	
	Возврат СтрокаПараметров;
	
КонецФункции

&НаСервере
Функция ПолучитьИмяОбработки()
	
	Если ПустаяСтрока(ПолноеИмяОбработки) Тогда
		ПолноеИмяОбработки = РеквизитФормыВЗначение("Объект").Метаданные().ПолноеИмя();
	КонецЕсли;
	
	Возврат ПолноеИмяОбработки;
	
КонецФункции

&НаСервере
Функция КлючХраненияНастроекОбработки()
	
	Возврат ПолучитьИмяОбработки() + ".ПользовательскиеНастройки";
	
КонецФункции


#Область НастройкиОбработки

&НаСервере
Функция ИмяРеквизитаСпискаЗапросов()
	
	Возврат "СписокЗапросов";
	
КонецФункции

&НаСервере
Процедура СохранитьНастройкиОбработки(Знач СохранятьСписокЗапросов = Истина)

	Настройки = Новый Соответствие();
	Настройки.Вставить("ВерсияФорматаНастроек", 3);
	Настройки.Вставить("Таймаут", Таймаут);
	Настройки.Вставить("АвтосохранениеВключено", АвтосохранениеВключено);
	Настройки.Вставить("ИнтервалАвтосохранения", ИнтервалАвтосохранения);
	
	Если СохранятьСписокЗапросов Тогда
		
		Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
			ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
		КонецЕсли;
		
		ИмяСписка = ИмяРеквизитаСпискаЗапросов();
		СписокДляСохранения = ЗначениеВСтрокуВнутр(РеквизитФормыВЗначение(ИмяСписка));
		Настройки.Вставить(ИмяСписка, СписокДляСохранения);
	Иначе
		СохранённыйСписок = ПолучитьСохранённыйСписокЗапросов();
		Если СохранённыйСписок <> Неопределено Тогда
			Настройки.Вставить(ИмяРеквизитаСпискаЗапросов(), СохранённыйСписок);
		КонецЕсли;
	КонецЕсли;
	
	ХранилищеСистемныхНастроек.Сохранить(КлючХраненияНастроекОбработки(), "Основные", Настройки);

КонецПроцедуры

&НаСервере
Функция ПолучитьСохранённыйСписокЗапросов()
	
	НастройкиФормы = ХранилищеСистемныхНастроек.Загрузить(КлючХраненияНастроекОбработки(), "Основные");
	Если НастройкиФормы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат НастройкиФормы.Получить(ИмяРеквизитаСпискаЗапросов());
	
КонецФункции

&НаСервере
Процедура ВосстановитьНастройкиОбработки()

	НастройкиФормы = ХранилищеСистемныхНастроек.Загрузить(КлючХраненияНастроекОбработки(), "Основные");
	
	Если НастройкиФормы = Неопределено Тогда
		Попытка
			НастройкиФормы = ХранилищеСистемныхНастроек.Загрузить(
				ПолучитьИмяОбработки() + ".Форма.Форма/ТекущиеДанные");
		Исключение
			НастройкиФормы = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если НастройкиФормы = Неопределено Тогда
		УстановитьНастройкиПоУмолчанию();
		Возврат;
	КонецЕсли;
	
	СохранённыйТаймаут = НастройкиФормы.Получить("Таймаут");
	Если СохранённыйТаймаут = Неопределено Тогда
		Таймаут = 0;
	Иначе
		Таймаут = СохранённыйТаймаут;
	КонецЕсли;
	
	СохранённоеАвтосохранение = НастройкиФормы.Получить("АвтосохранениеВключено");
	Если СохранённоеАвтосохранение = Неопределено Тогда
		АвтосохранениеВключено = Ложь;
	Иначе
		АвтосохранениеВключено = СохранённоеАвтосохранение;
	КонецЕсли;
	
	СохранённыйИнтервал = НастройкиФормы.Получить("ИнтервалАвтосохранения");
	Если СохранённыйИнтервал = Неопределено Тогда
		ИнтервалАвтосохранения = 30;
	Иначе
		ИнтервалАвтосохранения = СохранённыйИнтервал;
	КонецЕсли;
	
	СписокЗапросов_ХР = НастройкиФормы.Получить(ИмяРеквизитаСпискаЗапросов());
	Если СписокЗапросов_ХР <> Неопределено Тогда
		ЗагрузитьСписокЗапросовИзХранилища(СписокЗапросов_ХР);
		Возврат;
	КонецЕсли;
	
	// Миграция со старого плоского формата настроек в один элемент списка.
	ВосстановитьПлоскиеРеквизитыЗапроса(НастройкиФормы);
	ИдентификаторПервогоЗапроса = ДобавитьЗапросВСписокНаСервере("", Ложь, Ложь);
	ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторПервогоЗапроса);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНастройкиПоУмолчанию()
	
	Таймаут = 0;
	АвтосохранениеВключено = Ложь;
	ИнтервалАвтосохранения = 30;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСоСпискомЗапросов

&НаСервере
Функция ДеревоСписокЗапросов()
	
	Возврат РеквизитФормыВЗначение(ИмяРеквизитаСпискаЗапросов());
	
КонецФункции

&НаСервере
Процедура ЗаписатьДеревоСписокЗапросов(Знач ДеревоЗапросов)
	
	ЗначениеВРеквизитФормы(ДеревоЗапросов, ИмяРеквизитаСпискаЗапросов());
	
КонецПроцедуры

&НаСервере
Процедура ОбеспечитьРеквизитСписокЗапросовДеревом()
	
	Список = РеквизитФормыВЗначение(ИмяРеквизитаСпискаЗапросов());
	
	Если ТипЗнч(Список) = Тип("ТаблицаЗначений") Тогда
		ЗагрузитьСписокЗапросовИзПлоскойТаблицы(Список);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбеспечитьМинимумОдинЗапросНаСервере(Знач ОчищатьФормуПриСоздании = Ложь)
	
	Если КоличествоЗапросовВДереве() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьЗапросВСписокНаСервере("", Ложь, ОчищатьФормуПриСоздании);
	
КонецПроцедуры

&НаСервере
Функция ИнициализироватьСписокЗапросовПослеОткрытияНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗапроса", "");
	Результат.Вставить("ИдентификаторСтрокиСписка", "");
	Результат.Вставить("ЭтоГруппа", Ложь);
	
	ОбеспечитьРеквизитСписокЗапросовДеревом();
	ОбеспечитьМинимумОдинЗапросНаСервере(Истина);
	НормализоватьСтруктуруСпискаЗапросовПослеИзмененияНаСервере();
	
	ДанныеВыбора = ПолучитьДанныеПервоначальногоВыбораСпискаНаСервере();
	Результат.ИдентификаторЗапроса = ДанныеВыбора.ИдентификаторЗапроса;
	Результат.ИдентификаторСтрокиСписка = ДанныеВыбора.ИдентификаторСтрокиСписка;
	Результат.ЭтоГруппа = ДанныеВыбора.ЭтоГруппа;
	
	Если ДанныеВыбора.ЭтоГруппа Тогда
		ОчиститьРеквизитыТекущегоЗапроса();
	КонецЕсли;
	
	Если Не ДанныеВыбора.ЭтоГруппа И Не ПустаяСтрока(ДанныеВыбора.ИдентификаторЗапроса) Тогда
		ЗагрузитьЗапросИзСпискаНаСервере(ДанныеВыбора.ИдентификаторЗапроса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОчиститьФормуЗапросаНаСервере()
	
	ОчиститьРеквизитыТекущегоЗапроса();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокЗапросовИзХранилища(Знач СписокЗапросов_ХР)
	
	ЗагруженноеЗначение = ЗначениеИзСтрокиВнутр(СписокЗапросов_ХР);
	
	Если ТипЗнч(ЗагруженноеЗначение) = Тип("ДеревоЗначений") Тогда
		ЗначениеВРеквизитФормы(ЗагруженноеЗначение, ИмяРеквизитаСпискаЗапросов());
	КонецЕсли;
	
	Если ТипЗнч(ЗагруженноеЗначение) = Тип("ТаблицаЗначений") Тогда
		ЗагрузитьСписокЗапросовИзПлоскойТаблицы(ЗагруженноеЗначение);
	КонецЕсли;
	
	НормализоватьСписокЗапросовПослеЗагрузки();
	ОбеспечитьМинимумОдинЗапросНаСервере(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокЗапросовИзПлоскойТаблицы(Знач ТаблицаЗапросов)
	
	Дерево = ДеревоСписокЗапросов();
	Дерево.Строки.Очистить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗапросов Цикл
		НоваяСтрока = Дерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, , "Картинка");
		НоваяСтрока.ЭтоГруппа = Ложь;
		УстановитьКартинкуСтрокиСписка(НоваяСтрока);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, ИмяРеквизитаСпискаЗапросов());
	
КонецПроцедуры

&НаСервере
Процедура НормализоватьСписокЗапросовПослеЗагрузки()
	
	Дерево = ДеревоСписокЗапросов();
	ОбновитьКартинкиИСоставСтрокСпискаЗапросов(Дерево.Строки);
	ЗаписатьДеревоСписокЗапросов(Дерево);
	НормализоватьСтруктуруЭлементовДанныхФормыСписка(СписокЗапросов.ПолучитьЭлементы());
	
КонецПроцедуры

&НаСервере
Процедура НормализоватьСтруктуруСпискаЗапросовПослеИзмененияНаСервере()
	
	ИсправитьНедопустимуюВложенностьВДанныхФормыСписка(СписокЗапросов.ПолучитьЭлементы());
	НормализоватьСтруктуруЭлементовДанныхФормыСписка(СписокЗапросов.ПолучитьЭлементы());
	
КонецПроцедуры

&НаСервере
Процедура ИсправитьНедопустимуюВложенностьВДанныхФормыСписка(ЭлементыДерева)
	
	Для Каждого ЭлементСтроки Из ЭлементыДерева Цикл
		
		Пока Не ЭлементСтроки.ЭтоГруппа И ЭлементСтроки.ПолучитьЭлементы().Количество() > 0 Цикл
			ВынестиПодчиненныйЭлементЗапросаВДанныхФормы(ЭлементСтроки);
		КонецЦикла;
		
		ИсправитьНедопустимуюВложенностьВДанныхФормыСписка(ЭлементСтроки.ПолучитьЭлементы());
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВынестиПодчиненныйЭлементЗапросаВДанныхФормы(ЭлементЗапроса)
	
	Подчиненные = ЭлементЗапроса.ПолучитьЭлементы();
	Если Подчиненные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПодчиненныйЭлемент = Подчиненные.Получить(0);
	Родитель = ЭлементЗапроса.ПолучитьРодитель();
	
	Если Родитель = Неопределено Тогда
		КоллекцияРодителя = СписокЗапросов.ПолучитьЭлементы();
	Иначе
		КоллекцияРодителя = Родитель.ПолучитьЭлементы();
	КонецЕсли;
	
	ИндексЗапроса = ИндексЭлементаДанныхФормыВКоллекции(КоллекцияРодителя, ЭлементЗапроса);
	Если ИндексЗапроса < 0 Тогда
		Возврат;
	КонецЕсли;
	
	НовыйЭлемент = КоллекцияРодителя.Вставить(ИндексЗапроса + 1);
	СкопироватьЭлементДанныхФормыСписка(ПодчиненныйЭлемент, НовыйЭлемент);
	Подчиненные.Удалить(ПодчиненныйЭлемент);
	
КонецПроцедуры

&НаСервере
Процедура СкопироватьЭлементДанныхФормыСписка(Источник, Приемник)
	
	ЗаполнитьЗначенияСвойств(Приемник, Источник);
	УстановитьКартинкуЭлементаДанныхФормыСписка(Приемник);
	
	Пока Источник.ПолучитьЭлементы().Количество() > 0 Цикл
		ПодчиненныйИсточник = Источник.ПолучитьЭлементы().Получить(0);
		ПодчиненныйПриемник = Приемник.ПолучитьЭлементы().Добавить();
		СкопироватьЭлементДанныхФормыСписка(ПодчиненныйИсточник, ПодчиненныйПриемник);
		Источник.ПолучитьЭлементы().Удалить(ПодчиненныйИсточник);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ИндексЭлементаДанныхФормыВКоллекции(КоллекцияЭлементов, ЭлементСтроки)
	
	Индекс = 0;
	Для Каждого ЭлементКоллекции Из КоллекцияЭлементов Цикл
		Если ЭлементКоллекции = ЭлементСтроки Тогда
			Возврат Индекс;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат -1;
	
КонецФункции

&НаСервере
Процедура НормализоватьСтруктуруЭлементовДанныхФормыСписка(ЭлементыДерева)
	
	Для Каждого ЭлементСтроки Из ЭлементыДерева Цикл
		
		Подчиненные = ЭлементСтроки.ПолучитьЭлементы();
		НормализоватьЭлементДанныхФормыСписка(ЭлементСтроки);
		НормализоватьСтруктуруЭлементовДанныхФормыСписка(Подчиненные);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НормализоватьЭлементДанныхФормыСписка(ЭлементСтроки)
	
	Если ЭлементСтроки.ЭтоГруппа Или ЭлементСтроки.ДанныеЗапроса = Неопределено Тогда
		ЭлементСтроки.ДанныеЗапроса = "";
	КонецЕсли;
	
	Если ПустаяСтрока(ЭлементСтроки.Идентификатор) Тогда
		ЭлементСтроки.Идентификатор = XMLСтрока(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	УстановитьКартинкуЭлементаДанныхФормыСписка(ЭлементСтроки);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКартинкуЭлементаДанныхФормыСписка(ЭлементСтроки)
	
	Если ЭлементСтроки.ЭтоГруппа Тогда
		ЭлементСтроки.Картинка = БиблиотекаКартинок.Папка;
	Иначе
		ЭлементСтроки.Картинка = БиблиотекаКартинок.Документ;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиЭлементДанныхФормыСпискаЗапросов(Знач ИдентификаторСтроки, Знач ЭлементыДерева = Неопределено)
	
	Если ПустаяСтрока(ИдентификаторСтроки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭлементыДерева = Неопределено Тогда
		ЭлементыДерева = СписокЗапросов.ПолучитьЭлементы();
	КонецЕсли;
	
	Для Каждого ЭлементСтроки Из ЭлементыДерева Цикл
		
		Если ЭлементСтроки.Идентификатор = ИдентификаторСтроки Тогда
			Возврат ЭлементСтроки;
		КонецЕсли;
		
		НайденныйЭлемент = НайтиЭлементДанныхФормыСпискаЗапросов(
			ИдентификаторСтроки,
			ЭлементСтроки.ПолучитьЭлементы());
		Если НайденныйЭлемент <> Неопределено Тогда
			Возврат НайденныйЭлемент;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ОбновитьКартинкиИСоставСтрокСпискаЗапросов(КоллекцияСтрок)
	
	Для Каждого СтрокаСписка Из КоллекцияСтрок Цикл
		НормализоватьСтрокуСпискаЗапросов(СтрокаСписка);
		ОбновитьКартинкиИСоставСтрокСпискаЗапросов(СтрокаСписка.Строки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НормализоватьСтрокуСпискаЗапросов(СтрокаСписка)
	
	Если Не СтрокаСписка.ЭтоГруппа Тогда
		СтрокаСписка.ЭтоГруппа = Ложь;
	КонецЕсли;
	
	Если СтрокаСписка.ЭтоГруппа Или СтрокаСписка.ДанныеЗапроса = Неопределено Тогда
		СтрокаСписка.ДанныеЗапроса = "";
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаСписка.Идентификатор) Тогда
		СтрокаСписка.Идентификатор = XMLСтрока(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	УстановитьКартинкуСтрокиСписка(СтрокаСписка);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКартинкуСтрокиСписка(СтрокаСписка)
	
	Если СтрокаСписка.ЭтоГруппа Тогда
		СтрокаСписка.Картинка = БиблиотекаКартинок.Папка;
	Иначе
		СтрокаСписка.Картинка = БиблиотекаКартинок.Документ;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПервоначальногоВыбораСпискаНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗапроса", "");
	Результат.Вставить("ИдентификаторСтрокиСписка", "");
	Результат.Вставить("ЭтоГруппа", Ложь);
	
	ИдентификаторЗапроса = НайтиПервыйЗапросВДереве();
	Если Не ПустаяСтрока(ИдентификаторЗапроса) Тогда
		Результат.ИдентификаторЗапроса = ИдентификаторЗапроса;
		Результат.ИдентификаторСтрокиСписка = ИдентификаторЗапроса;
		Возврат Результат;
	КонецЕсли;
	
	ПерваяСтрока = НайтиПервуюСтрокуВДереве();
	Если ПерваяСтрока <> Неопределено Тогда
		Результат.ИдентификаторСтрокиСписка = ПерваяСтрока.Идентификатор;
		Результат.ЭтоГруппа = ПерваяСтрока.ЭтоГруппа;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НайтиИдентификаторСтрокиСпискаЗапросовНаСервере(Знач ИдентификаторСтрокиСписка)
	
	Возврат НайтиИдентификаторЭлементаДанныхФормыДерева(
		СписокЗапросов.ПолучитьЭлементы(),
		ИдентификаторСтрокиСписка);
	
КонецФункции

&НаСервере
Функция НайтиИдентификаторЭлементаДанныхФормыДерева(ЭлементыДерева, Знач ИдентификаторСтрокиСписка)
	
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		
		Если ЭлементДерева.Идентификатор = ИдентификаторСтрокиСписка Тогда
			Возврат ЭлементДерева.ПолучитьИдентификатор();
		КонецЕсли;
		
		НайденныйИдентификатор = НайтиИдентификаторЭлементаДанныхФормыДерева(
			ЭлементДерева.ПолучитьЭлементы(),
			ИдентификаторСтрокиСписка);
		Если НайденныйИдентификатор <> Неопределено Тогда
			Возврат НайденныйИдентификатор;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ЗаписатьТекущийЗапросВСписокНаСервере(Знач ИдентификаторЗапроса)
	
	Если ПустаяСтрока(ИдентификаторЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементСтроки = НайтиЭлементДанныхФормыСпискаЗапросов(ИдентификаторЗапроса);
	Если ЭлементСтроки = Неопределено Или ЭлементСтроки.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементСтроки.ДанныеЗапроса = ЗначениеВСтрокуВнутр(СобратьДанныеТекущегоЗапроса());
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЗапросИзСпискаНаСервере(Знач ИдентификаторЗапроса)
	
	ЭлементСтроки = НайтиЭлементДанныхФормыСпискаЗапросов(ИдентификаторЗапроса);
	Если ЭлементСтроки = Неопределено Или ЭлементСтроки.ЭтоГруппа Тогда
		ОчиститьРеквизитыТекущегоЗапроса();
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ЭлементСтроки.ДанныеЗапроса) Тогда
		ОчиститьРеквизитыТекущегоЗапроса();
		Возврат;
	КонецЕсли;
	
	ДанныеЗапроса = ЗначениеИзСтрокиВнутр(ЭлементСтроки.ДанныеЗапроса);
	ЗаполнитьРеквизитыИзДанныхЗапроса(ДанныеЗапроса);
	
КонецПроцедуры

&НаСервере
Функция ДобавитьПапкуВСписокНаСервере(Знач ИдентификаторТекущейСтроки, Знач ТекущаяСтрокаЭтоГруппа)
	
	Дерево = ДеревоСписокЗапросов();
	РодительскаяСтрока = ОпределитьРодителяПриДобавлении(
		ИдентификаторТекущейСтроки, ТекущаяСтрокаЭтоГруппа, Истина, Дерево);
	НомерПапки = КоличествоПапокВДереве(Дерево.Строки) + 1;
	НоваяСтрока = ДобавитьСтрокуСпискаЗапросов(Дерево, РодительскаяСтрока);
	
	НоваяСтрока.Идентификатор = XMLСтрока(Новый УникальныйИдентификатор);
	НоваяСтрока.ЭтоГруппа = Истина;
	НоваяСтрока.ДанныеЗапроса = "";
	НоваяСтрока.Наименование = "Папка " + Формат(НомерПапки, "ЧГ=0");
	УстановитьКартинкуСтрокиСписка(НоваяСтрока);
	ЗаписатьДеревоСписокЗапросов(Дерево);
	
	Возврат НоваяСтрока.Идентификатор;
	
КонецФункции

&НаСервере
Функция ДобавитьЗапросВСписокНаСервере(
	Знач ИдентификаторТекущейСтроки,
	Знач ТекущаяСтрокаЭтоГруппа,
	Знач ОчищатьФорму = Истина)
	
	Дерево = ДеревоСписокЗапросов();
	РодительскаяСтрока = ОпределитьРодителяПриДобавлении(
		ИдентификаторТекущейСтроки, ТекущаяСтрокаЭтоГруппа, Ложь, Дерево);
	НомерЗапроса = КоличествоЗапросовВДереве(Дерево.Строки) + 1;
	НоваяСтрока = ДобавитьСтрокуСпискаЗапросов(Дерево, РодительскаяСтрока);
	
	НоваяСтрока.Идентификатор = XMLСтрока(Новый УникальныйИдентификатор);
	НоваяСтрока.ЭтоГруппа = Ложь;
	НоваяСтрока.Наименование = "Запрос " + Формат(НомерЗапроса, "ЧГ=0");
	
	Если ОчищатьФорму Тогда
		ОчиститьРеквизитыТекущегоЗапроса();
	КонецЕсли;
	
	НоваяСтрока.ДанныеЗапроса = ЗначениеВСтрокуВнутр(СобратьДанныеТекущегоЗапроса());
	УстановитьКартинкуСтрокиСписка(НоваяСтрока);
	ЗаписатьДеревоСписокЗапросов(Дерево);
	
	Возврат НоваяСтрока.Идентификатор;
	
КонецФункции

&НаСервере
Функция СкопироватьЭлементСпискаЗапросовНаСервере(Знач ИдентификаторИсходнойСтроки)
	
	Дерево = ДеревоСписокЗапросов();
	ИсходнаяСтрока = НайтиСтрокуСпискаЗапросов(ИдентификаторИсходнойСтроки, Дерево.Строки);
	Если ИсходнаяСтрока = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	КоллекцияРодителя = ПолучитьКоллекциюСтрокСпискаЗапросов(Дерево, ИсходнаяСтрока);
	ИндексИсходнойСтроки = КоллекцияРодителя.Индекс(ИсходнаяСтрока);
	НоваяСтрока = КоллекцияРодителя.Вставить(ИндексИсходнойСтроки + 1);
	
	СкопироватьСтрокуСпискаЗапросов(ИсходнаяСтрока, НоваяСтрока, Дерево);
	ЗаписатьДеревоСписокЗапросов(Дерево);
	
	Возврат НоваяСтрока.Идентификатор;
	
КонецФункции

&НаСервере
Процедура СкопироватьСтрокуСпискаЗапросов(ИсходнаяСтрока, НоваяСтрока, Знач Дерево)
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрока, , "Строки");
	НоваяСтрока.Идентификатор = XMLСтрока(Новый УникальныйИдентификатор);
	
	Если ИсходнаяСтрока.ЭтоГруппа Тогда
		НоваяСтрока.Наименование = ИсходнаяСтрока.Наименование + " (копия)";
	Иначе
		НоваяСтрока.Наименование = СформироватьИмяКопииЗапроса(ИсходнаяСтрока.Наименование);
	КонецЕсли;
	
	УстановитьКартинкуСтрокиСписка(НоваяСтрока);
	
	Для Каждого ПодчиненнаяСтрока Из ИсходнаяСтрока.Строки Цикл
		НоваяПодчиненнаяСтрока = НоваяСтрока.Строки.Добавить();
		СкопироватьСтрокуСпискаЗапросов(ПодчиненнаяСтрока, НоваяПодчиненнаяСтрока, Дерево);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СформироватьИмяКопииЗапроса(Знач ИсходноеНаименование)
	
	Если ПустаяСтрока(ИсходноеНаименование) Тогда
		Возврат "Запрос (копия)";
	КонецЕсли;
	
	Возврат ИсходноеНаименование + " (копия)";
	
КонецФункции

&НаСервере
Функция УдалитьЭлементИзСпискаНаСервере(Знач ИдентификаторСтрокиСписка)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗапроса", "");
	Результат.Вставить("ИдентификаторСтрокиСписка", "");
	Результат.Вставить("ЭтоГруппа", Ложь);
	
	ЭлементСтроки = НайтиЭлементДанныхФормыСпискаЗапросов(ИдентификаторСтрокиСписка);
	Если ЭлементСтроки = Неопределено Тогда
		Возврат ЗаполнитьРезультатПослеУдаленияИзСписка(Результат);
	КонецЕсли;
	
	Родитель = ЭлементСтроки.ПолучитьРодитель();
	Если Родитель = Неопределено Тогда
		СписокЗапросов.ПолучитьЭлементы().Удалить(ЭлементСтроки);
	Иначе
		Родитель.ПолучитьЭлементы().Удалить(ЭлементСтроки);
	КонецЕсли;
	
	Возврат ЗаполнитьРезультатПослеУдаленияИзСписка(Результат);
	
КонецФункции

&НаСервере
Функция ЗаполнитьРезультатПослеУдаленияИзСписка(Результат)
	
	Если КоличествоЗапросовВДереве() = 0 Тогда
		ИдентификаторЗапроса = ДобавитьЗапросВСписокНаСервере("", Ложь, Истина);
		Результат.ИдентификаторЗапроса = ИдентификаторЗапроса;
		Результат.ИдентификаторСтрокиСписка = ИдентификаторЗапроса;
		Возврат Результат;
	КонецЕсли;
	
	ИдентификаторЗапроса = НайтиПервыйЗапросВДереве();
	Если Не ПустаяСтрока(ИдентификаторЗапроса) Тогда
		Результат.ИдентификаторЗапроса = ИдентификаторЗапроса;
		Результат.ИдентификаторСтрокиСписка = ИдентификаторЗапроса;
		Возврат Результат;
	КонецЕсли;
	
	ПерваяСтрока = НайтиПервуюСтрокуВДереве();
	Если ПерваяСтрока <> Неопределено Тогда
		Результат.ИдентификаторСтрокиСписка = ПерваяСтрока.Идентификатор;
		Результат.ЭтоГруппа = ПерваяСтрока.ЭтоГруппа;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОпределитьРодителяПриДобавлении(
	Знач ИдентификаторТекущейСтроки,
	Знач ТекущаяСтрокаЭтоГруппа,
	Знач ДобавляемПапку,
	Знач Дерево)
	
	Если ПустаяСтрока(ИдентификаторТекущейСтроки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекущаяСтрока = НайтиСтрокуСпискаЗапросов(ИдентификаторТекущейСтроки, Дерево.Строки);
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДобавляемПапку Тогда
		Если ТекущаяСтрокаЭтоГруппа Тогда
			Возврат ТекущаяСтрока;
		КонецЕсли;
		Возврат ТекущаяСтрока.Родитель;
	КонецЕсли;
	
	Если ТекущаяСтрокаЭтоГруппа Тогда
		Возврат ТекущаяСтрока;
	КонецЕсли;
	
	Возврат ТекущаяСтрока.Родитель;
	
КонецФункции

&НаСервере
Функция ДобавитьСтрокуСпискаЗапросов(Знач Дерево, Знач РодительскаяСтрока)
	
	Если РодительскаяСтрока = Неопределено Тогда
		Возврат Дерево.Строки.Добавить();
	КонецЕсли;
	
	Возврат РодительскаяСтрока.Строки.Добавить();
	
КонецФункции

&НаСервере
Функция ПолучитьКоллекциюСтрокСпискаЗапросов(Знач Дерево, Знач СтрокаСписка)
	
	Если СтрокаСписка.Родитель = Неопределено Тогда
		Возврат Дерево.Строки;
	КонецЕсли;
	
	Возврат СтрокаСписка.Родитель.Строки;
	
КонецФункции

&НаСервере
Функция НайтиСтрокуСпискаЗапросов(Знач ИдентификаторСтрокиСписка, Знач КоллекцияСтрок = Неопределено)
	
	Если ПустаяСтрока(ИдентификаторСтрокиСписка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если КоллекцияСтрок = Неопределено Тогда
		КоллекцияСтрок = ДеревоСписокЗапросов().Строки;
	КонецЕсли;
	
	Для Каждого СтрокаСписка Из КоллекцияСтрок Цикл
		
		Если СтрокаСписка.Идентификатор = ИдентификаторСтрокиСписка Тогда
			Возврат СтрокаСписка;
		КонецЕсли;
		
		НайденнаяСтрока = НайтиСтрокуСпискаЗапросов(ИдентификаторСтрокиСписка, СтрокаСписка.Строки);
		Если НайденнаяСтрока <> Неопределено Тогда
			Возврат НайденнаяСтрока;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция НайтиПервыйЗапросВДереве(Знач КоллекцияСтрок = Неопределено)
	
	Если КоллекцияСтрок = Неопределено Тогда
		КоллекцияСтрок = ДеревоСписокЗапросов().Строки;
	КонецЕсли;
	
	Для Каждого СтрокаСписка Из КоллекцияСтрок Цикл
		
		Если Не СтрокаСписка.ЭтоГруппа Тогда
			Возврат СтрокаСписка.Идентификатор;
		КонецЕсли;
		
		ИдентификаторЗапроса = НайтиПервыйЗапросВДереве(СтрокаСписка.Строки);
		Если Не ПустаяСтрока(ИдентификаторЗапроса) Тогда
			Возврат ИдентификаторЗапроса;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция НайтиПервуюСтрокуВДереве(Знач КоллекцияСтрок = Неопределено)
	
	Если КоллекцияСтрок = Неопределено Тогда
		КоллекцияСтрок = ДеревоСписокЗапросов().Строки;
	КонецЕсли;
	
	Если КоллекцияСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат КоллекцияСтрок[0];
	
КонецФункции

&НаСервере
Функция КоличествоЗапросовВДереве(Знач КоллекцияСтрок = Неопределено)
	
	Если КоллекцияСтрок = Неопределено Тогда
		КоллекцияСтрок = ДеревоСписокЗапросов().Строки;
	КонецЕсли;
	
	Количество = 0;
	
	Для Каждого СтрокаСписка Из КоллекцияСтрок Цикл
		
		Если Не СтрокаСписка.ЭтоГруппа Тогда
			Количество = Количество + 1;
		КонецЕсли;
		
		Количество = Количество + КоличествоЗапросовВДереве(СтрокаСписка.Строки);
		
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

&НаСервере
Функция КоличествоПапокВДереве(Знач КоллекцияСтрок = Неопределено)
	
	Если КоллекцияСтрок = Неопределено Тогда
		КоллекцияСтрок = ДеревоСписокЗапросов().Строки;
	КонецЕсли;
	
	Количество = 0;
	
	Для Каждого СтрокаСписка Из КоллекцияСтрок Цикл
		
		Если СтрокаСписка.ЭтоГруппа Тогда
			Количество = Количество + 1;
		КонецЕсли;
		
		Количество = Количество + КоличествоПапокВДереве(СтрокаСписка.Строки);
		
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

&НаСервере
Функция СобратьДанныеТекущегоЗапроса()
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("HTTPМетод", HTTPМетод);
	ДанныеЗапроса.Вставить("URI", URI);
	ДанныеЗапроса.Вставить("ТелоЗапроса", ТелоЗапроса);
	ДанныеЗапроса.Вставить("ВремяВыполненияЗапроса", ВремяВыполненияЗапроса);
	ДанныеЗапроса.Вставить("ЗаголовкиЗапроса", ЗаголовкиЗапроса.Выгрузить());
	ДанныеЗапроса.Вставить("ЗаголовкиОтвета", ЗаголовкиОтвета.Выгрузить());
	ДанныеЗапроса.Вставить("ЗапросОтвет", ЗапросОтвет);
	ДанныеЗапроса.Вставить("КодОтвета", КодОтвета);
	ДанныеЗапроса.Вставить("ЛогинBasicAuth", ЛогинBasicAuth);
	ДанныеЗапроса.Вставить("НаименованиеТокена", НаименованиеТокена);
	ДанныеЗапроса.Вставить("ПараметрыЗапроса", ПараметрыЗапроса.Выгрузить());
	ДанныеЗапроса.Вставить("ПарольBasicAuth", ПарольBasicAuth);
	ДанныеЗапроса.Вставить("ТипАвторизации", ТипАвторизации);
	ДанныеЗапроса.Вставить("ТокенАвторизации", ТокенАвторизации);
	ДанныеЗапроса.Вставить("ВариантТелаЗапроса", ВариантТелаЗапроса);
	ДанныеЗапроса.Вставить("ПутьКФайлуВх", ПутьКФайлуВх);
	ДанныеЗапроса.Вставить("ПоляFormData", ПоляFormData.Выгрузить());
	ДанныеЗапроса.Вставить("ФорматОтветаДляСохранения", ФорматОтветаДляСохранения);
	
	Возврат ДанныеЗапроса;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРеквизитыИзДанныхЗапроса(Знач ДанныеЗапроса)
	
	HTTPМетод = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "HTTPМетод", "GET");
	Если ПустаяСтрока(HTTPМетод) Тогда
		HTTPМетод = "GET";
	КонецЕсли;
	
	URI = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "URI", "");
	ТелоЗапроса = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ТелоЗапроса", "");
	ВремяВыполненияЗапроса = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ВремяВыполненияЗапроса", "");
	ЗапросОтвет = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ЗапросОтвет", "");
	КодОтвета = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "КодОтвета", 0);
	ЛогинBasicAuth = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ЛогинBasicAuth", "");
	НаименованиеТокена = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "НаименованиеТокена", "");
	ПарольBasicAuth = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ПарольBasicAuth", "");
	ТипАвторизации = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ТипАвторизации", "");
	ТокенАвторизации = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ТокенАвторизации", "");
	
	ВариантТелаЗапроса = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ВариантТелаЗапроса", "NONE");
	Если ПустаяСтрока(ВариантТелаЗапроса) Тогда
		ВариантТелаЗапроса = "NONE";
	КонецЕсли;
	
	ПутьКФайлуВх = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ПутьКФайлуВх", "");
	ФорматОтветаДляСохранения = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ФорматОтветаДляСохранения", "");
	
	ЗагрузитьТаблицуИзДанныхЗапроса(ЗаголовкиЗапроса, ДанныеЗапроса, "ЗаголовкиЗапроса");
	ЗагрузитьТаблицуИзДанныхЗапроса(ЗаголовкиОтвета, ДанныеЗапроса, "ЗаголовкиОтвета");
	ЗагрузитьТаблицуИзДанныхЗапроса(ПараметрыЗапроса, ДанныеЗапроса, "ПараметрыЗапроса");
	ЗагрузитьТаблицуИзДанныхЗапроса(ПоляFormData, ДанныеЗапроса, "ПоляFormData");
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРеквизитыТекущегоЗапроса()
	
	HTTPМетод = "GET";
	URI = "";
	ТелоЗапроса = "";
	ВремяВыполненияЗапроса = "";
	ЗапросОтвет = "";
	КодОтвета = 0;
	ЛогинBasicAuth = "";
	НаименованиеТокена = "";
	ПарольBasicAuth = "";
	ТипАвторизации = "";
	ТокенАвторизации = "";
	ВариантТелаЗапроса = "NONE";
	ПутьКФайлуВх = "";
	ФорматОтветаДляСохранения = "";
	ЗаголовкиЗапроса.Очистить();
	ЗаголовкиОтвета.Очистить();
	ПараметрыЗапроса.Очистить();
	ПоляFormData.Очистить();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеДанныхЗапроса(Знач ДанныеЗапроса, Знач ИмяСвойства, Знач ЗначениеПоУмолчанию)
	
	Если ТипЗнч(ДанныеЗапроса) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Если Не ДанныеЗапроса.Свойство(ИмяСвойства) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ЗначениеСвойства = ДанныеЗапроса[ИмяСвойства];
	Если ЗначениеСвойства = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат ЗначениеСвойства;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьТаблицуИзДанныхЗапроса(ТаблицаФормы, Знач ДанныеЗапроса, Знач ИмяСвойства)
	
	ТаблицаФормы.Очистить();
	
	ЗначениеТаблицы = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, ИмяСвойства, Неопределено);
	Если ТипЗнч(ЗначениеТаблицы) = Тип("ТаблицаЗначений") Тогда
		ТаблицаФормы.Загрузить(ЗначениеТаблицы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьПлоскиеРеквизитыЗапроса(Знач НастройкиФормы)
	
	HTTPМетод = НастройкиФормы.Получить("HTTPМетод");
	URI = НастройкиФормы.Получить("URI");
	ТелоЗапроса = НастройкиФормы.Получить("ТелоЗапроса");
	ВремяВыполненияЗапроса = НастройкиФормы.Получить("ВремяВыполненияЗапроса");
	
	ЗаголовкиЗапроса_ХР = НастройкиФормы.Получить("ЗаголовкиЗапроса");
	Если ЗаголовкиЗапроса_ХР <> Неопределено Тогда
		ЗаголовкиЗапроса.Загрузить(ЗначениеИзСтрокиВнутр(ЗаголовкиЗапроса_ХР));
	КонецЕсли;
	
	ЗаголовкиОтвета_ХР = НастройкиФормы.Получить("ЗаголовкиОтвета");
	Если ЗаголовкиОтвета_ХР <> Неопределено Тогда
		ЗаголовкиОтвета.Загрузить(ЗначениеИзСтрокиВнутр(ЗаголовкиОтвета_ХР));
	КонецЕсли;
	
	ЗапросОтвет = НастройкиФормы.Получить("ЗапросОтвет");
	КодОтвета = НастройкиФормы.Получить("КодОтвета");
	ЛогинBasicAuth = НастройкиФормы.Получить("ЛогинBasicAuth");
	НаименованиеТокена = НастройкиФормы.Получить("НаименованиеТокена");
	
	ПараметрыЗапроса_ХР = НастройкиФормы.Получить("ПараметрыЗапроса");
	Если ПараметрыЗапроса_ХР <> Неопределено Тогда
		ПараметрыЗапроса.Загрузить(ЗначениеИзСтрокиВнутр(ПараметрыЗапроса_ХР));
	КонецЕсли;
	
	ПарольBasicAuth = НастройкиФормы.Получить("ПарольBasicAuth");
	ТипАвторизации = НастройкиФормы.Получить("ТипАвторизации");
	ТокенАвторизации = НастройкиФормы.Получить("ТокенАвторизации");
	ВариантТелаЗапроса = НастройкиФормы.Получить("ВариантТелаЗапроса");
	ПутьКФайлуВх = НастройкиФормы.Получить("ПутьКФайлуВх");
	
	ПоляFormData_ХР = НастройкиФормы.Получить("ПоляFormData");
	Если ПоляFormData_ХР <> Неопределено Тогда
		ПоляFormData.Загрузить(ЗначениеИзСтрокиВнутр(ПоляFormData_ХР));
	КонецЕсли;
	
КонецПроцедуры

