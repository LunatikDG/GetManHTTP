// Процедура заполняет реквизит формы заголовков из соответствия
//
// Параметры:
//	Соответствие - Произвольный - Заголовки результата запроса
//
&НаСервере
Процедура ЗаполнитьЗаголовкиОтвета(Знач Соответствие)

	ЗаголовкиОтвета.Загрузить(СоответствиеВЗаголовки(Соответствие));

КонецПроцедуры

// Преобразует таблицу значений в массив структур.
// Может использоваться для передачи на клиент данных в том случае, если таблица
// значений содержит только такие значения, которые могут
// быть переданы с сервера на клиент.
//
// Полученный массив содержит структуры, каждая из которых повторяет
// структуру колонок таблицы значений.
//
// Не рекомендуется использовать для преобразования таблиц значений
// с большим количеством строк.
//
// Возвращаемое значение:
//  Произвольный - коллекция строк таблицы в виде структур.
//
&НаСервере
Функция ЗаголовкиВСоответствие()
	
	Соответствие = Новый Соответствие;
	ЗаголовкиЗапросаТЗ = ЗаголовкиЗапроса.Выгрузить();
	
	Если ТипЗнч(ЗаголовкиЗапросаТЗ) <> Тип("ТаблицаЗначений") Тогда
		Возврат Соответствие;
	КонецЕсли;
	
	// Legacy-миграция: если колонки «Активен» нет, считаем что все заголовки активны.
	ОбеспечитьКолонкуАктивенВТаблицеЗначений(ЗаголовкиЗапросаТЗ);
	
	Если ЗаголовкиЗапросаТЗ.Количество() = 0 Тогда
		Возврат Соответствие;
	КонецЕсли;
	
	Если ЗаголовкиЗапросаТЗ.Колонки.Количество() < МинимумКолонокТаблицыЗаголовковДляПреобразования() Тогда
		Возврат Соответствие;
	КонецЕсли;
	
	Для Каждого Строка Из ЗаголовкиЗапросаТЗ Цикл
		
		Если Строка.Активен = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = Строка.КлючЗаголовка;
		Значение = Строка.ЗначениеЗаголовка;
		
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		
		Соответствие.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

// Преобразует таблицу значений в массив структур.
// Может использоваться для передачи на клиент данных в том случае, если таблица
// значений содержит только такие значения, которые могут
// быть переданы с сервера на клиент.
//
// Полученный массив содержит структуры, каждая из которых повторяет
// структуру колонок таблицы значений.
//
// Не рекомендуется использовать для преобразования таблиц значений
// с большим количеством строк.
//
// Параметры:
//  Соответствие - Соответствие - коллекция строк таблицы в виде структур.
//  
// Возвращаемое значение:
// 	ТаблицаЗначений:
// 		* КлючЗаголовка - Строка - Ключ соответствия
// 		* ЗначениеЗаголовка - Строка - Значение соответствия
// 		* ОписаниеЗаголовка - Строка - Описание ключа соответствия
//
&НаСервере
Функция СоответствиеВЗаголовки(Знач Соответствие)
	
	ТЗ_Заголовки = Новый ТаблицаЗначений();
	ТЗ_Заголовки.Колонки.Добавить("КлючЗаголовка");
	ТЗ_Заголовки.Колонки.Добавить("ЗначениеЗаголовка");
	ТЗ_Заголовки.Колонки.Добавить("ОписаниеЗаголовка");
	
    // Проходим по всем строкам таблицы значений
    Для Каждого Элемент Из Соответствие Цикл
    	
    	НоваяСтрока = ТЗ_Заголовки.Добавить();
    	
    	НоваяСтрока.КлючЗаголовка = Элемент.Ключ;
    	НоваяСтрока.ЗначениеЗаголовка = Элемент.Значение;
    	
    КонецЦикла;
    
    Возврат ТЗ_Заголовки;
    
КонецФункции

&НаСервере
Функция ПараметрыВСтроку()
	
	СтрокаПараметров = "";
	
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		
		Если Параметр.Активен = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(Параметр.КлючПараметра) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПараметров = СтрокаПараметров + СтрШаблон(
			"%1=%2&",
			Параметр.КлючПараметра,
			Параметр.ЗначениеПараметра);
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(СтрокаПараметров) Тогда
		СтрокаПараметров = "?" + Лев(СтрокаПараметров, СтрДлина(СтрокаПараметров) - 1);
	КонецЕсли;
	
	Возврат СтрокаПараметров;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОбеспечитьКолонкуАктивенВТаблицеЗначений(ТаблицаПараметров)
	
	Если ТипЗнч(ТаблицаПараметров) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаПараметров.Колонки.Найти("Активен") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаПараметров.Колонки.Добавить("Активен", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаПараметра Из ТаблицаПараметров Цикл
		СтрокаПараметра.Активен = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СобратьURIСПараметрамиЗапросаНаСервере()
	
	Если ПустаяСтрока(URI) Тогда
		Возврат URI;
	КонецЕсли;
	
	КомпонентыURI = РазобратьСтрокуURI(URI);
	ЧастиПути = ОтделитьQueryИЯкорьОтПути(КомпонентыURI.ПутьНаСервере);
	КомпонентыURI.ПутьНаСервере = ЧастиПути.Путь + ПараметрыВСтроку();
	
	Возврат СобратьСтрокуURI(КомпонентыURI, ЧастиПути.Якорь);
	
КонецФункции

&НаСервере
Процедура СинхронизироватьПараметрыЗапросаИзURIНаСервере(Знач ЗаменятьАктивные = Истина)
	
	КомпонентыURI = РазобратьСтрокуURI(URI);
	ЧастиПути = ОтделитьQueryИЯкорьОтПути(КомпонентыURI.ПутьНаСервере);
	
	Если ЗаменятьАктивные Тогда
		
		ИндексСтроки = ПараметрыЗапроса.Количество() - 1;
		Пока ИндексСтроки >= 0 Цикл
			
			Если ПараметрыЗапроса[ИндексСтроки].Активен <> Ложь Тогда
				ПараметрыЗапроса.Удалить(ИндексСтроки);
			КонецЕсли;
			
			ИндексСтроки = ИндексСтроки - 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(ЧастиПути.QueryСтрока) Тогда
		ДобавитьПараметрыИзQueryСтроки(ЧастиПути.QueryСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СинхронизироватьПараметрыИURIИзСтрокиURIНаСервере()
	
	СинхронизироватьПараметрыЗапросаИзURIНаСервере(Истина);
	Возврат СобратьURIСПараметрамиЗапросаНаСервере();
	
КонецФункции

&НаСервере
Процедура НормализоватьURIИПараметрыЗапросаНаСервере()
	
	// При загрузке: query из URI вливается в таблицу, затем URI собирается целиком из таблицы.
	СинхронизироватьПараметрыЗапросаИзURIНаСервере(Ложь);
	URI = СобратьURIСПараметрамиЗапросаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПараметрыИзQueryСтроки(Знач QueryСтрока)
	
	Если ПустаяСтрока(QueryСтрока) Тогда
		Возврат;
	КонецЕсли;
	
	Фрагменты = СтрРазделить(QueryСтрока, "&", Ложь);
	
	Для Каждого Фрагмент Из Фрагменты Цикл
		
		Если ПустаяСтрока(Фрагмент) Тогда
			Продолжить;
		КонецЕсли;
		
		ПозицияРавно = СтрНайти(Фрагмент, "=");
		Если ПозицияРавно = 0 Тогда
			КлючПараметра = Фрагмент;
			ЗначениеПараметра = "";
		Иначе
			КлючПараметра = Лев(Фрагмент, ПозицияРавно - 1);
			ЗначениеПараметра = Сред(Фрагмент, ПозицияРавно + 1);
		КонецЕсли;
		
		Если ПустаяСтрока(КлючПараметра) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПараметра = НайтиСтрокуПараметраЗапроса(КлючПараметра);
		Если СтрокаПараметра = Неопределено Тогда
			СтрокаПараметра = ПараметрыЗапроса.Добавить();
			СтрокаПараметра.КлючПараметра = КлючПараметра;
		КонецЕсли;
		
		СтрокаПараметра.ЗначениеПараметра = ЗначениеПараметра;
		СтрокаПараметра.Активен = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НайтиСтрокуПараметраЗапроса(Знач КлючПараметра)
	
	Для Каждого СтрокаПараметра Из ПараметрыЗапроса Цикл
		Если СтрокаПараметра.КлючПараметра = КлючПараметра Тогда
			Возврат СтрокаПараметра;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

