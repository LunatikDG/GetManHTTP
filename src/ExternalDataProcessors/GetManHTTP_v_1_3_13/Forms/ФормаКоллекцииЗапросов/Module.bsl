// BSLLS:UnusedLocalVariable-off

#Область ОбработчикиСобытийФормы

// BSLLS:UnusedLocalMethod-off

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Наименование") Тогда
		Наименование = Параметры.Наименование;
	Иначе
		Наименование = "";
	КонецЕсли;
	
	Если Параметры.Свойство("ИспользоватьТаймаутПоУмолчанию") Тогда
		ИспользоватьТаймаутПоУмолчанию = Параметры.ИспользоватьТаймаутПоУмолчанию;
	Иначе
		ИспользоватьТаймаутПоУмолчанию = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("ТаймаутКоллекции") Тогда
		ТаймаутКоллекции = Параметры.ТаймаутКоллекции;
	Иначе
		ТаймаутКоллекции = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьДоступностьТаймаутаКоллекции();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура ИспользоватьТаймаутПоУмолчаниюПриИзменении(Элемент)
	
	ОбновитьДоступностьТаймаутаКоллекции();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиКомандФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура ПрименитьНастройкиКоллекции(Команда)
	
	Если ПустаяСтрока(СокрЛП(Наименование)) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите наименование коллекции";
		Сообщение.Поле = "Наименование";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если Не ИспользоватьТаймаутПоУмолчанию И ТаймаутКоллекции < 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Таймаут коллекции не может быть отрицательным";
		Сообщение.Поле = "ТаймаутКоллекции";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование", СокрЛП(Наименование));
	Результат.Вставить("ИспользоватьТаймаутПоУмолчанию", ИспользоватьТаймаутПоУмолчанию);
	Результат.Вставить("ТаймаутКоллекции", ТаймаутКоллекции);
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьНастройкиКоллекции(Команда)
	
	Закрыть();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьДоступностьТаймаутаКоллекции()
	
	Элементы.ТаймаутКоллекции.Доступность = Не ИспользоватьТаймаутПоУмолчанию;
	
КонецПроцедуры

#КонецОбласти

// BSLLS:UnusedLocalVariable-on
