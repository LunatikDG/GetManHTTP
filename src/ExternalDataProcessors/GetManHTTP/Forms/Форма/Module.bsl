// Проверяет выполнение всех условий для отправки HTTP-запроса
//
// Возвращаемое значение:
//	Структура:
//		* УсловияВыполнены - Булево - Признак того может ли быть отправлен HTTP-запроса
//
&НаКлиенте
Функция УсловияОтправкиВыполнены()
	Результат = Новый Структура;
	
	Результат.Вставить("УсловияВыполнены", Ложь);
	
	// Проверяем поля
	Если НЕ ПустаяСтрока(URI) И НЕ ПустаяСтрока(HTTPМетод) Тогда
		Результат.УсловияВыполнены = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разбирает строку URI на составные части и возвращает в виде структуры.
// На основе RFC 3986.
//
// Параметры:
//  СтрокаURI - Строка - ссылка на ресурс в формате:
//                       <схема>://<логин>:<пароль>@<хост>:<порт>/<путь>?<параметры>#<якорь>.
//
// Возвращаемое значение:
//  Структура - см. РазобратьСтрокуURI, с учётом авторизации и параметров запроса формы.
//
&НаКлиенте
Функция СтруктураURI(Знач СтрокаURI) Экспорт
	
	Результат = РазобратьСтрокуURI(СтрокаURI);
	
	ДополнитьАвторизациюВСтруктурURI(Результат);
	ДополнитьПараметрыЗапросаВСтруктуруURI(Результат);

	Возврат Результат;
	
КонецФункции

// Дополняет структуру URI авторизацией по схеме текущего типа.
// 
// Параметры:
//	URI - Структура:
//			- см. СтруктураURI
&НаКлиенте
Процедура ДополнитьАвторизациюВСтруктурURI(URI)

	ЭффективнаяАвторизация = ПолучитьЭффективнуюАвторизациюТекущегоЭлементаНаСервере();
	URI.ТипАвторизации = ЭффективнаяАвторизация.ТипАвторизации;
	ПрименитьПравилаАвторизацииКСтруктуреURI(
		URI,
		ЭффективнаяАвторизация.ТипАвторизации,
		ЭффективнаяАвторизация.ЗначенияПараметров);

КонецПроцедуры

// Дополнить структуру URI параметрами запроса
// Параметры:
//	URI - Структура:
//			- см. СтруктураURI
&НаКлиенте
Процедура ДополнитьПараметрыЗапросаВСтруктуруURI(URI)

	ЧастиПути = ОтделитьQueryИЯкорьОтПути(URI.ПутьНаСервере);
	СтрокаПараметров = ПараметрыВСтроку();
	ЭффективнаяАвторизация = ПолучитьЭффективнуюАвторизациюТекущегоЭлементаНаСервере();
	СтрокаАвторизации = СтрокаПараметровАвторизацииЗапроса(
		ЭффективнаяАвторизация.ТипАвторизации,
		ЭффективнаяАвторизация.ЗначенияПараметров);
	
	Если Не ПустаяСтрока(СтрокаАвторизации) Тогда
		Если ПустаяСтрока(СтрокаПараметров) Тогда
			СтрокаПараметров = "?" + СтрокаАвторизации;
		Иначе
			СтрокаПараметров = СтрокаПараметров + "&" + СтрокаАвторизации;
		КонецЕсли;
	КонецЕсли;
	
	URI.ПутьНаСервере = ЧастиПути.Путь + СтрокаПараметров;

КонецПроцедуры

// Отделяет query (?...) и якорь (#...) от пути (часть после хоста в URI).
// Вызывается с клиента и с сервера.
//
// Параметры:
//  ПутьНаСервере - Строка - путь с опциональными query и якорем.
//
// Возвращаемое значение:
//  Структура - Путь, QueryСтрока (без ?), Якорь (с #).
//
&НаКлиентеНаСервереБезКонтекста
Функция ОтделитьQueryИЯкорьОтПути(Знач ПутьНаСервере)
	
	Результат = Новый Структура;
	Результат.Вставить("Путь", ПутьНаСервере);
	Результат.Вставить("QueryСтрока", "");
	Результат.Вставить("Якорь", "");
	
	ПозицияРешетки = СтрНайти(ПутьНаСервере, "#");
	Если ПозицияРешетки > 0 Тогда
		Результат.Якорь = Сред(ПутьНаСервере, ПозицияРешетки);
		ПутьНаСервере = Лев(ПутьНаСервере, ПозицияРешетки - 1);
		Результат.Путь = ПутьНаСервере;
	КонецЕсли;
	
	ПозицияВопроса = СтрНайти(ПутьНаСервере, "?");
	Если ПозицияВопроса > 0 Тогда
		Результат.QueryСтрока = Сред(ПутьНаСервере, ПозицияВопроса + 1);
		Результат.Путь = Лев(ПутьНаСервере, ПозицияВопроса - 1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разбирает строку URI на составные части (RFC 3986), без дополнения данными формы.
//
// Параметры:
//  СтрокаURI - Строка - см. СтруктураURI.
//
// Возвращаемое значение:
//  Структура - составные части URI:
//   * Схема - Строка
//   * Логин - Строка
//   * Пароль - Строка
//   * ИмяСервера - Строка
//   * Хост - Строка
//   * Порт - Число, Неопределено
//   * ПутьНаСервере - Строка
//   * ТипАвторизации - Строка (пустая в этой функции)
//
&НаКлиентеНаСервереБезКонтекста
Функция РазобратьСтрокуURI(Знач СтрокаURI)
	
	СтрокаURI = СокрЛП(СтрокаURI);
	
	Схема = "";
	Позиция = СтрНайти(СтрокаURI, "://");
	Если Позиция > 0 Тогда
		Схема = НРег(Лев(СтрокаURI, Позиция - 1));
		СтрокаURI = Сред(СтрокаURI, Позиция + ДлинаПрефиксаПослеРазделителяСхемыURI());
	КонецЕсли;
	
	СтрокаСоединения = СтрокаURI;
	ПутьНаСервере = "";
	Позиция = СтрНайти(СтрокаСоединения, "/");
	Если Позиция > 0 Тогда
		ПутьНаСервере = Сред(СтрокаСоединения, Позиция + 1);
		СтрокаСоединения = Лев(СтрокаСоединения, Позиция - 1);
	КонецЕсли;
	
	СтрокаАвторизации = "";
	ИмяСервера = СтрокаСоединения;
	Позиция = СтрНайти(СтрокаСоединения, "@");
	Если Позиция > 0 Тогда
		СтрокаАвторизации = Лев(СтрокаСоединения, Позиция - 1);
		ИмяСервера = Сред(СтрокаСоединения, Позиция + 1);
	КонецЕсли;
	
	Логин = СтрокаАвторизации;
	Пароль = "";
	Позиция = СтрНайти(СтрокаАвторизации, ":");
	Если Позиция > 0 Тогда
		Логин = Лев(СтрокаАвторизации, Позиция - 1);
		Пароль = Сред(СтрокаАвторизации, Позиция + 1);
	КонецЕсли;
	
	Хост = ИмяСервера;
	Порт = "";
	Позиция = СтрНайти(ИмяСервера, ":");
	Если Позиция > 0 Тогда
		Хост = Лев(ИмяСервера, Позиция - 1);
		Порт = Сред(ИмяСервера, Позиция + 1);
		Если Не СтрокаСодержитТолькоЦифры(Порт) Тогда
			Порт = "";
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Схема", Схема);
	Результат.Вставить("Логин", Логин);
	Результат.Вставить("Пароль", Пароль);
	Результат.Вставить("ИмяСервера", ИмяСервера);
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Порт", ?(ПустаяСтрока(Порт), Неопределено, Число(Порт)));
	Результат.Вставить("ПутьНаСервере", ПутьНаСервере);
	Результат.Вставить("ТипАвторизации", "");
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаСодержитТолькоЦифры(Знач Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтрДлина(Значение) = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Цифры = "0123456789";
	
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(Цифры, Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Собирает строку URI из разобранных компонентов (без query; якорь передается отдельно).
//
// Параметры:
//  КомпонентыURI - Структура - см. РазобратьСтрокуURI (используются Схема, ИмяСервера, ПутьНаСервере).
//  Якорь         - Строка - фрагмент с ведущим #, если есть.
//
// Возвращаемое значение:
//  Строка - собранный URI.
//
&НаКлиентеНаСервереБезКонтекста
Функция СобратьСтрокуURI(КомпонентыURI, Знач Якорь = "")
	
	Результат = "";
	
	Если Не ПустаяСтрока(КомпонентыURI.Схема) Тогда
		Результат = КомпонентыURI.Схема + "://";
	КонецЕсли;
	
	Результат = Результат + КомпонентыURI.ИмяСервера;
	
	Если Не ПустаяСтрока(КомпонентыURI.ПутьНаСервере) Тогда
		Результат = Результат + "/" + КомпонентыURI.ПутьНаСервере;
	КонецЕсли;
	
	Если Не ПустаяСтрока(Якорь) Тогда
		Результат = Результат + Якорь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДлинаПрефиксаПослеРазделителяСхемыURI()
	
	Возврат 3;
	
КонецФункции

#Область HTTPВыполнениеБезКонтекста

&НаКлиентеНаСервереБезКонтекста
Функция НовыйРезультатВыполненияHTTP()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("Заголовки", Новый Соответствие);
	Результат.Вставить("ТелоСтрока", "");
	Результат.Вставить("ВремяВыполненияМс", 0);
	Результат.Вставить("ОписаниеОшибки", "");
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СоздатьHTTPСоединениеПоПараметрам(Знач СтруктураURI, Знач ТаймаутСоединения)
	
	Порт = СтруктураURI.Порт;
	Если Порт = Неопределено Тогда
		Если СтруктураURI.Схема = "https" Тогда
			Порт = 443;
		Иначе
			Порт = 80;
		КонецЕсли;
	КонецЕсли;
	
	Если ТаймаутСоединения = Неопределено Тогда
		ТаймаутСоединения = 0;
	КонецЕсли;
	
	ЗащищенноеСоединение = Неопределено;
	Если СтруктураURI.Схема = "https" Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	КонецЕсли;
	
	Если СтруктураURI.ТипАвторизации = "BasicAuth"
		Или Не ПустаяСтрока(СтруктураURI.Логин)
		Или Не ПустаяСтрока(СтруктураURI.Пароль) Тогда
		Возврат Новый HTTPСоединение(
			СтруктураURI.Хост,
			Порт,
			СтруктураURI.Логин,
			СтруктураURI.Пароль,
			,
			ТаймаутСоединения,
			ЗащищенноеСоединение);
	Иначе
		Возврат Новый HTTPСоединение(
			СтруктураURI.Хост,
			Порт,
			,
			,
			,
			ТаймаутСоединения,
			ЗащищенноеСоединение);
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьТелоFormDataДляHTTP(Знач ПоляFormData)
	
	Результат = Новый Структура;
	Результат.Вставить("Тело", "");
	Результат.Вставить("Граница", "");
	
	ГраницаFormData = "GetManBoundary" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ЧастиТела = Новый Массив;
	
	Для Каждого СтрокаПоля Из ПоляFormData Цикл
		
		КлючПоля = Строка(СтрокаПоля.Ключ);
		ЗначениеПоля = Строка(СтрокаПоля.Значение);
		
		Если ПустаяСтрока(КлючПоля) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = СтрЗаменить(КлючПоля, """", "");
		
		ЧастиТела.Добавить("--" + ГраницаFormData);
		ЧастиТела.Добавить("Content-Disposition: form-data; name=""" + ИмяПоля + """");
		ЧастиТела.Добавить("");
		ЧастиТела.Добавить(ЗначениеПоля);
		
	КонецЦикла;
	
	Если ЧастиТела.Количество() = 0 Тогда
		ВызватьИсключение "Не заполнены поля form-data";
	КонецЕсли;
	
	ЧастиТела.Добавить("--" + ГраницаFormData + "--");
	ЧастиТела.Добавить("");
	
	РазделительСтрок = Символы.ВК + Символы.ПС;
	Результат.Тело = СтрСоединить(ЧастиТела, РазделительСтрок);
	Результат.Граница = ГраницаFormData;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьHTTPЗапросПоПараметрам(Знач ПараметрыВыполнения)
	
	HTTPЗапрос = Новый HTTPЗапрос(ПараметрыВыполнения.СтруктураURI.ПутьНаСервере);
	HTTPЗапрос.Заголовки = ПараметрыВыполнения.ЗаголовкиHTTP;
	
	ГраницаFormData = "";
	ВариантТела = ПараметрыВыполнения.ВариантТелаЗапроса;
	
	Если ВариантТела = "JSON" ИЛИ ВариантТела = "XML" Тогда
		Если ЗначениеЗаполнено(ПараметрыВыполнения.ТелоЗапроса) Тогда
			HTTPЗапрос.УстановитьТелоИзСтроки(ПараметрыВыполнения.ТелоЗапроса);
		КонецЕсли;
	КонецЕсли;
	
	Если ВариантТела = "BINARY" Тогда
		
		ДвоичноеТело = Неопределено;
		
		Если Не ПустаяСтрока(ПараметрыВыполнения.АдресДвоичныхДанных) Тогда
			ДвоичноеТело = ПолучитьИзВременногоХранилища(ПараметрыВыполнения.АдресДвоичныхДанных);
		ИначеЕсли ЗначениеЗаполнено(ПараметрыВыполнения.ПутьКФайлуВх) Тогда
			ДвоичноеТело = Новый ДвоичныеДанные(ПараметрыВыполнения.ПутьКФайлуВх);
		Иначе
			ДвоичноеТело = Неопределено;
		КонецЕсли;
		
		Если ТипЗнч(ДвоичноеТело) = Тип("ДвоичныеДанные") Тогда
			HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ДвоичноеТело);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВариантТела = "FORM_DATA" Тогда
		ДанныеFormData = СформироватьТелоFormDataДляHTTP(ПараметрыВыполнения.ПоляFormData);
		ГраницаFormData = ДанныеFormData.Граница;
		HTTPЗапрос.УстановитьТелоИзСтроки(ДанныеFormData.Тело, КодировкаТекста.UTF8);
		HTTPЗапрос.Заголовки.Вставить(
			"Content-Type",
			"multipart/form-data; boundary=" + ГраницаFormData);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("HTTPЗапрос", HTTPЗапрос);
	Результат.Вставить("ГраницаFormData", ГраницаFormData);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьHTTPЗапросНаСервере(Знач ПараметрыВыполнения)
	
	РезультатВыполнения = НовыйРезультатВыполненияHTTP();
	
	Попытка
		
		HTTPСоединение = СоздатьHTTPСоединениеПоПараметрам(
			ПараметрыВыполнения.СтруктураURI,
			ПараметрыВыполнения.ТаймаутСоединения);
		
		ДанныеЗапроса = ПодготовитьHTTPЗапросПоПараметрам(ПараметрыВыполнения);
		HTTPЗапрос = ДанныеЗапроса.HTTPЗапрос;
		
		СтартЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
		HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод(ПараметрыВыполнения.HTTPМетод, HTTPЗапрос);
		КонецЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		РезультатВыполнения.Успех = Истина;
		РезультатВыполнения.КодСостояния = HTTPОтвет.КодСостояния;
		РезультатВыполнения.ТелоСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();
		РезультатВыполнения.Заголовки = HTTPОтвет.Заголовки;
		РезультатВыполнения.ВремяВыполненияМс = КонецЗамера - СтартЗамера;
		
	Исключение
		РезультатВыполнения.ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат РезультатВыполнения;
	
КонецФункции

#КонецОбласти

// Отправка HTTP-запроса в выбранном контексте (клиент или сервер).
//
// Параметры:
//	URI - Структура - см. СтруктураURI.
//
&НаКлиенте
Асинх Процедура ОтправитьHTTPЗапрос(URI)
	
	Если ЭтоРежимОтправкиСервер(РежимОтправкиЗапроса) Тогда
		ОтправитьHTTPЗапросЧерезСервер(URI);
	Иначе
		ЗначенияПоУмолчанию();
		КонтекстВыполненияЗапроса = ТекстКонтекстаВыполненияДляОтображения(Ложь);
		ПараметрыВыполнения = СобратьПараметрыВыполненияHTTPНаСервере(URI, "");
		РезультатВыполнения = Ждать ВыполнитьHTTPЗапросНаКлиентеАсинх(ПараметрыВыполнения);
		ПрименитьРезультатHTTPЗапросаНаКлиенте(РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьHTTPЗапросЧерезСервер(Знач URI)
	
	ЗначенияПоУмолчанию();
	КонтекстВыполненияЗапроса = ТекстКонтекстаВыполненияДляОтображения(Истина);
	
	Если ВариантТелаЗапроса = "BINARY" Тогда
		
		Если Не ЗначениеЗаполнено(ПутьКФайлуВх) Тогда
			ВывестиСообщениеПользователю("Предупреждение! Не выбран файл для отправки!");
			Возврат;
		КонецЕсли;
		
		#Если ВебКлиент Тогда
			ВывестиСообщениеПользователю("Отправка двоичного тела с сервера недоступна в веб-клиенте");
			Возврат;
		#Иначе
			Оповещение = Новый ОписаниеОповещения(
				"ОтправитьHTTPЗапросЧерезСерверПослеПомещенияФайла",
				ЭтотОбъект,
				URI);
			НачатьПомещениеФайлаНаСервер(
				Оповещение,
				,
				ПутьКФайлуВх,
				Ложь,
				УникальныйИдентификатор);
			Возврат;
		#КонецЕсли
		
	КонецЕсли;
	
	ВыполнитьHTTPЗапросВСерверномКонтекстеНаКлиенте(URI, "");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьHTTPЗапросЧерезСерверПослеПомещенияФайла(Результат, Знач URI) Экспорт
	
	АдресДвоичныхДанных = ИзвлечьАдресПомещенногоФайлаНаСервере(Результат);
	Если ПустаяСтрока(АдресДвоичныхДанных) Тогда
		ВывестиСообщениеПользователю("Не удалось передать файл на сервер для отправки запроса");
		Возврат;
	КонецЕсли;
	
	ВыполнитьHTTPЗапросВСерверномКонтекстеНаКлиенте(URI, АдресДвоичныхДанных);
	
КонецПроцедуры

&НаКлиенте
Функция ИзвлечьАдресПомещенногоФайлаНаСервере(Знач РезультатПомещения)
	
	Если РезультатПомещения = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(РезультатПомещения) = Тип("Структура") Тогда
		Если РезультатПомещения.Свойство("Адрес") И ЗначениеЗаполнено(РезультатПомещения.Адрес) Тогда
			Возврат РезультатПомещения.Адрес;
		КонецЕсли;
		Если РезультатПомещения.Свойство("ОписаниеОшибки")
			И ЗначениеЗаполнено(РезультатПомещения.ОписаниеОшибки) Тогда
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(РезультатПомещения) = Тип("Строка") Тогда
		Возврат РезультатПомещения;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьHTTPЗапросВСерверномКонтекстеНаКлиенте(Знач URI, Знач АдресДвоичныхДанных)
	
	ПараметрыВыполнения = СобратьПараметрыВыполненияHTTPНаСервере(URI, АдресДвоичныхДанных);
	РезультатВыполнения = ВыполнитьHTTPЗапросНаСервере(ПараметрыВыполнения);
	ПрименитьРезультатHTTPЗапросаНаКлиенте(РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьРезультатHTTPЗапросаНаКлиенте(Знач РезультатВыполнения)
	
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не РезультатВыполнения.Успех Тогда
		Если Не ПустаяСтрока(РезультатВыполнения.ОписаниеОшибки) Тогда
			ВывестиСообщениеПользователю(РезультатВыполнения.ОписаниеОшибки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
