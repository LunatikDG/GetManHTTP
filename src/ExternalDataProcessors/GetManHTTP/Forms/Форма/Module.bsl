		Обещание = HTTPСоединение.ВызватьHTTPМетодАсинх(ПараметрыВыполнения.HTTPМетод, HTTPЗапрос);
		HTTPОтвет = Ждать Обещание;
		КонецЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		РезультатВыполнения.Успех = Истина;
		РезультатВыполнения.КодСостояния = HTTPОтвет.КодСостояния;
		РезультатВыполнения.ТелоСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();
		РезультатВыполнения.Заголовки = HTTPОтвет.Заголовки;
		РезультатВыполнения.ВремяВыполненияМс = КонецЗамера - СтартЗамера;
		
	Исключение
		РезультатВыполнения.ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат РезультатВыполнения;
	
