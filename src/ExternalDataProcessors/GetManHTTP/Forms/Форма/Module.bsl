	Знач Секретный,
	Знач Многострочный,
	Знач ЗначениеПоУмолчанию)
	
	Поле = Новый Структура;
	Поле.Вставить("Ключ", Ключ);
	Поле.Вставить("Заголовок", Заголовок);
	Поле.Вставить("Секретный", Секретный);
	Поле.Вставить("Многострочный", Многострочный);
	Поле.Вставить("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию);
	
	Возврат Поле;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовоеПравилоАвторизацииБазовогоСоединения(Знач КлючЛогина, Знач КлючПароля)
	
	Правило = Новый Структура;
	Правило.Вставить("Вид", "ConnectionBasic");
	Правило.Вставить("КлючЛогина", КлючЛогина);
	Правило.Вставить("КлючПароля", КлючПароля);
	
