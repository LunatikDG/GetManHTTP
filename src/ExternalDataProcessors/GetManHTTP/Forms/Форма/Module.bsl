		МассивЗаголовковВJSON(ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ЗаголовкиЗапроса", Неопределено)));
	Элемент.Вставить(
		"query",
		МассивПараметровЗапросаВJSON(ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ПараметрыЗапроса", Неопределено)));
	
