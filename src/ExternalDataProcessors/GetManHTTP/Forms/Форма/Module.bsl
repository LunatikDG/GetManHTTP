&НаСервере
Функция НовыеДанныеАвторизацииПоУмолчаниюДляЭлемента()
	
	ДанныеАвторизации = Новый Структура;
	ДанныеАвторизации.Вставить("ТипАвторизации", ИдентификаторТипаАвторизацииНаследоватьОтВладельца());
	ДанныеАвторизации.Вставить("ПараметрыАвторизации", НовыйТаблицаПараметровАвторизации());
	
	Возврат ДанныеАвторизации;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьАвторизациюИзДанныхЗапросаСтроки(Знач ДанныеЗапросаСтрока)
	
	ТипАвторизации = ИдентификаторТипаАвторизацииНаследоватьОтВладельца();
	ПараметрыАвторизации.Очистить();
	
	Если ПустаяСтрока(ДанныеЗапросаСтрока) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЗапроса = ЗначениеИзСтрокиВнутр(ДанныеЗапросаСтрока);
	Если ТипЗнч(ДанныеЗапроса) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ТипАвторизации = ПолучитьЗначениеДанныхЗапроса(
		ДанныеЗапроса,
		"ТипАвторизации",
		ИдентификаторТипаАвторизацииНаследоватьОтВладельца());
	Если ПустаяСтрока(ТипАвторизации) Тогда
		ТипАвторизации = ИдентификаторТипаАвторизацииНаследоватьОтВладельца();
	КонецЕсли;
	
	ЗагрузитьТаблицуИзДанныхЗапроса(ПараметрыАвторизации, ДанныеЗапроса, "ПараметрыАвторизации");
	МигрироватьПараметрыАвторизацииИзУстаревшихПолей(ДанныеЗапроса);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЭффективнуюАвторизациюТекущегоЭлементаНаСервере()
	
	СинхронизироватьПараметрыАвторизацииИзПолейФормыНаСервере();
	
	Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
		
		ЭлементСтроки = НайтиЭлементДанныхФормыСпискаЗапросов(ИдентификаторТекущегоЗапроса);
		Если ЭлементСтроки <> Неопределено Тогда
			
			Если ЭлементСтроки.ЭтоГруппа Тогда
				ЭлементСтроки.ДанныеЗапроса = ЗначениеВСтрокуВнутр(СобратьДанныеАвторизацииТекущегоЭлемента());
			Иначе
				ЭлементСтроки.ДанныеЗапроса = ЗначениеВСтрокуВнутр(СобратьДанныеТекущегоЗапроса());
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат ПолучитьЭффективнуюАвторизациюПоИдентификаторуЭлемента(ИдентификаторТекущегоЗапроса);
		
	КонецЕсли;
	
	Возврат ПолучитьОписаниеАвторизацииКоллекцииНаСервере(ТекущаяКоллекция);
	
КонецФункции

&НаСервере
Функция ПолучитьЭффективнуюАвторизациюПоИдентификаторуЭлемента(Знач ИдентификаторЭлемента)
	
	ЭлементСтроки = НайтиЭлементДанныхФормыСпискаЗапросов(ИдентификаторЭлемента);
	
	Пока ЭлементСтроки <> Неопределено Цикл
		
		ОписаниеАвторизации = ПрочитатьОписаниеАвторизацииИзДанныхЗапроса(ЭлементСтроки.ДанныеЗапроса);
		Если Не ЭтоТипАвторизацииНаследоватьОтВладельца(ОписаниеАвторизации.ТипАвторизации) Тогда
			Возврат ОписаниеАвторизации;
		КонецЕсли;
		
		ЭлементСтроки = ЭлементСтроки.ПолучитьРодителя();
		
	КонецЦикла;
	
	Возврат ПолучитьОписаниеАвторизацииКоллекцииНаСервере(ТекущаяКоллекция);
	
КонецФункции

&НаСервере
Функция ПолучитьОписаниеАвторизацииКоллекцииНаСервере(Знач ИдентификаторКоллекции)
	
	Результат = НовыйОписаниеАвторизации();
	Результат.ТипАвторизации = ИдентификаторТипаАвторизацииБезАвторизации();
	
	СтрокаКоллекции = НайтиСтрокуКоллекцииЗапросов(ИдентификаторКоллекции);
	Если СтрокаКоллекции = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ТипАвторизации = ТипАвторизацииКоллекцииЭффективный(СтрокаКоллекции);
	Результат.ЗначенияПараметров = СоответствиеЗначенийПараметровАвторизации(
		ТаблицаПараметровАвторизацииИзСтрокиХранилища(СтрокаКоллекции.ПараметрыАвторизации));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПрочитатьОписаниеАвторизацииИзДанныхЗапроса(Знач ДанныеЗапросаСтрока)
	
	Результат = НовыйОписаниеАвторизации();
	Результат.ТипАвторизации = ИдентификаторТипаАвторизацииНаследоватьОтВладельца();
	
	Если ПустаяСтрока(ДанныеЗапросаСтрока) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДанныеЗапроса = ЗначениеИзСтрокиВнутр(ДанныеЗапросаСтрока);
	Если ТипЗнч(ДанныеЗапроса) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипИзДанных = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ТипАвторизации", "");
	Если ПустаяСтрока(ТипИзДанных) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ТипАвторизации = ТипИзДанных;
	
	ЗначениеТаблицы = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ПараметрыАвторизации", Неопределено);
	Если ТипЗнч(ЗначениеТаблицы) = Тип("ТаблицаЗначений") Тогда
		Результат.ЗначенияПараметров = СоответствиеЗначенийПараметровАвторизации(ЗначениеТаблицы);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовыйОписаниеАвторизации()
	
	Результат = Новый Структура;
	Результат.Вставить("ТипАвторизации", "");
	Результат.Вставить("ЗначенияПараметров", Новый Соответствие);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НовыйТаблицаПараметровАвторизации()
	
	ТаблицаПараметров = Новый ТаблицаЗначений;
	ТаблицаПараметров.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	ТаблицаПараметров.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"));
	ТаблицаПараметров.Колонки.Добавить("Секретный", Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаПараметров;
	
КонецФункции

&НаСервере
Функция ТаблицаПараметровАвторизацииИзСтрокиХранилища(Знач СтрокаХранилища)
	
	Если ПустаяСтрока(СтрокаХранилища) Тогда
		Возврат НовыйТаблицаПараметровАвторизации();
	КонецЕсли;
	
	ЗначениеТаблицы = ЗначениеИзСтрокиВнутр(СтрокаХранилища);
	Если ТипЗнч(ЗначениеТаблицы) <> Тип("ТаблицаЗначений") Тогда
		Возврат НовыйТаблицаПараметровАвторизации();
	КонецЕсли;
	
	Возврат ЗначениеТаблицы;
	
КонецФункции

&НаСервере
Функция МассивСтруктурПараметровАвторизацииИзТаблицы(Знач ТаблицаПараметров)
	
	Результат = Новый Массив;
	
	Для Каждого СтрокаПараметра Из ТаблицаПараметров Цикл
		
		Элемент = Новый Структура;
		Элемент.Вставить("Ключ", СтрокаПараметра.Ключ);
		Элемент.Вставить("Значение", СтрокаПараметра.Значение);
		Элемент.Вставить("Секретный", СтрокаПараметра.Секретный);
		Результат.Добавить(Элемент);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СериализоватьПараметрыАвторизацииИзЗначения(Знач ЗначениеПараметров)
	
	Если ТипЗнч(ЗначениеПараметров) = Тип("ТаблицаЗначений") Тогда
		Возврат ЗначениеВСтрокуВнутр(ЗначениеПараметров);
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеПараметров) = Тип("Массив") Тогда
		Возврат ЗначениеВСтрокуВнутр(ТаблицаПараметровАвторизацииИзМассиваСтруктур(ЗначениеПараметров));
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ТаблицаПараметровАвторизацииИзМассиваСтруктур(Знач МассивПараметров)
	
	ТаблицаПараметров = НовыйТаблицаПараметровАвторизации();
	
	Для Каждого ЭлементМассива Из МассивПараметров Цикл
		
		Если ТипЗнч(ЭлементМассива) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаПараметров.Добавить();
		Если ЭлементМассива.Свойство("Ключ") Тогда
			НоваяСтрока.Ключ = ЭлементМассива.Ключ;
		КонецЕсли;
		Если ЭлементМассива.Свойство("Значение") Тогда
			НоваяСтрока.Значение = ЭлементМассива.Значение;
		КонецЕсли;
		Если ЭлементМассива.Свойство("Секретный") Тогда
			НоваяСтрока.Секретный = ЭлементМассива.Секретный;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаПараметров;
	
КонецФункции

