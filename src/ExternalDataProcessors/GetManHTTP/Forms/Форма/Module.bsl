&НаСервере
Функция ОбъектPostmanRequestИзДанныхЗапроса(Знач ДанныеЗапросаСтрока)
	
	ДанныеЗапроса = ПрочитатьСтруктуруДанныхЗапросаСтроки(ДанныеЗапросаСтрока);
	Результат = Новый Структура;
	
	Метод = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "HTTPМетод", HTTPМетодGET());
	Результат.Вставить("method", Метод);
	Результат.Вставить(
		"header",
		МассивPostmanЗаголовков(ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ЗаголовкиЗапроса", Неопределено)));
	ОписаниеURL = ОбъектPostmanUrl(
		ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "URI", ""),
		ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ПараметрыЗапроса", Неопределено));
	Результат.Вставить("url", ОписаниеURL);
	
	ОписаниеТела = ОбъектPostmanBodyИзДанныхЗапроса(ДанныеЗапроса);
	Если ОписаниеТела <> Неопределено Тогда
		Результат.Вставить("body", ОписаниеТела);
	КонецЕсли;
	
	ТипАвторизацииЭлемента = ПолучитьЗначениеДанныхЗапроса(
		ДанныеЗапроса,
		КлючПоляТипАвторизацииВДанныхЗапроса(),
		ИдентификаторТипаАвторизацииНаследоватьОтВладельца());
	ТаблицаПараметровАвторизацииЭлемента = ПолучитьЗначениеДанныхЗапроса(
		ДанныеЗапроса,
		КлючПоляПараметрыАвторизацииВДанныхЗапроса(),
		НовыйТаблицаПараметровАвторизации());
	Если ТипЗнч(ТаблицаПараметровАвторизацииЭлемента) <> Тип("ТаблицаЗначений") Тогда
		ТаблицаПараметровАвторизацииЭлемента = НовыйТаблицаПараметровАвторизации();
	КонецЕсли;
	
	АвторизацияPostman = АвторизацияВPostmanAuth(
		ТипАвторизацииЭлемента,
		ТаблицаПараметровАвторизацииЭлемента);
	Если АвторизацияPostman <> Неопределено Тогда
		Результат.Вставить("auth", АвторизацияPostman);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОбъектPostmanBodyИзДанныхЗапроса(Знач ДанныеЗапроса)
	
	КлючMode = КлючJSONMode();
	КлючRaw = КлючJSONRaw();
	ВариантXML = ВариантТелаЗапросаXML();
	ВариантТела = ПолучитьЗначениеДанныхЗапроса(
		ДанныеЗапроса,
		"ВариантТелаЗапроса",
		ВариантТелаЗапросаОтсутствует());
	
	Если ВариантТела = ВариантТелаЗапросаОтсутствует() Или ПустаяСтрока(ВариантТела) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Если ВариантТела = "JSON" Или ВариантТела = ВариантXML Тогда
		Результат.Вставить(КлючMode, КлючRaw);
		Результат.Вставить(КлючRaw, ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ТелоЗапроса", ""));
		ОпцииRaw = Новый Структура;
		ОпцииRaw.Вставить("language", ?(ВариантТела = ВариантXML, "xml", "json"));
		Опции = Новый Структура;
		Опции.Вставить(КлючRaw, ОпцииRaw);
		Результат.Вставить("options", Опции);
	ИначеЕсли ВариантТела = "FORM_DATA" Тогда
		Результат.Вставить(КлючMode, "formdata");
		Результат.Вставить(
			"formdata",
			МассивPostmanFormData(ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ПоляFormData", Неопределено)));
	ИначеЕсли ВариантТела = "BINARY" Тогда
		Результат.Вставить(КлючMode, "file");
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("src", ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ПутьКФайлуВх", ""));
		Результат.Вставить("file", ОписаниеФайла);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОбъектPostmanUrl(Знач URI, Знач ПараметрыЗапросаТаблица)
	
	URI = СокрЛП(Строка(URI));
	Результат = Новый Структура;
	
	МассивQuery = МассивPostmanQueryИзТаблицыПараметров(ПараметрыЗапросаТаблица);
	
	Если Не ПустаяСтрока(URI) Тогда
		ЗаполнитьКомпонентыPostmanUrlИзСтроки(Результат, URI);
	КонецЕсли;
	
	Если Не Результат.Свойство("raw") Тогда
		Результат.Вставить("raw", URI);
	КонецЕсли;
	
	Результат.Вставить("query", МассивQuery);
	
	Если ПустаяСтрока(Результат.raw) И МассивQuery.Количество() > 0 Тогда
		Результат.raw = СобратьRawPostmanUrlИзQuery(МассивQuery);
	КонецЕсли;
	
	Если Не ПустаяСтрока(Результат.raw)
		И СтрНайти(Результат.raw, "?") = 0
		И МассивQuery.Количество() > 0 Тогда
		Результат.raw = Результат.raw + "?" + СобратьСтрокуQueryPostman(МассивQuery);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьКомпонентыPostmanUrlИзСтроки(Результат, Знач URI)
	
	Компоненты = РазобратьСтрокуURI(URI);
	Результат.Вставить("raw", URI);
	
	Если Не ПустаяСтрока(Компоненты.Схема) Тогда
		Результат.Вставить("protocol", Компоненты.Схема);
	КонецЕсли;
	
	Если Не ПустаяСтрока(Компоненты.Хост) Тогда
		Результат.Вставить("host", СтрРазделить(Компоненты.Хост, ".", Ложь));
	КонецЕсли;
	
	Если Компоненты.Порт <> Неопределено Тогда
		Результат.Вставить("port", ФорматЦелогоЧислаБезГруппировки(Компоненты.Порт));
	КонецЕсли;
	
	ЧастиПути = ОтделитьQueryИЯкорьОтПути(Компоненты.ПутьНаСервере);
	Если ПустаяСтрока(ЧастиПути.Путь) Тогда
		Результат.Вставить("path", Новый Массив);
	Иначе
		Результат.Вставить("path", СтрРазделить(ЧастиПути.Путь, "/", Ложь));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция МассивPostmanQueryИзТаблицыПараметров(Знач ПараметрыЗапросаТаблица)
	
	МассивQuery = Новый Массив;
	Если ТипЗнч(ПараметрыЗапросаТаблица) <> Тип("ТаблицаЗначений") Тогда
		Возврат МассивQuery;
	КонецЕсли;
	
	ЕстьОписаниеПараметра = ПараметрыЗапросаТаблица.Колонки.Найти("ОписаниеПараметра") <> Неопределено;
	ЕстьАктивен = ПараметрыЗапросаТаблица.Колонки.Найти("Активен") <> Неопределено;
	
	Для Каждого СтрокаПараметра Из ПараметрыЗапросаТаблица Цикл
		ЭлементQuery = Новый Структура;
		ЭлементQuery.Вставить("key", СтрокаПараметра.КлючПараметра);
		ЭлементQuery.Вставить("value", СтрокаПараметра.ЗначениеПараметра);
		Если ЕстьОписаниеПараметра Тогда
			ЭлементQuery.Вставить("description", СтрокаПараметра.ОписаниеПараметра);
		КонецЕсли;
		Если ЕстьАктивен И Не СтрокаПараметра.Активен Тогда
			ЭлементQuery.Вставить("disabled", Истина);
		КонецЕсли;
		МассивQuery.Добавить(ЭлементQuery);
	КонецЦикла;
	
	Возврат МассивQuery;
	
КонецФункции

&НаСервере
Функция СобратьСтрокуQueryPostman(Знач МассивQuery)
	
	Части = Новый Массив;
	
	Для Каждого ЭлементQuery Из МассивQuery Цикл
		Если ЭлементQuery.Свойство("disabled") И ЭлементQuery.disabled = Истина Тогда
			Продолжить;
		КонецЕсли;
		Ключ = "";
		Значение = "";
		Если ЭлементQuery.Свойство("key") Тогда
			Ключ = Строка(ЭлементQuery.key);
		КонецЕсли;
		Если ЭлементQuery.Свойство("value") Тогда
			Значение = Строка(ЭлементQuery.value);
		КонецЕсли;
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(Ключ + "=" + Значение);
	КонецЦикла;
	
	Возврат СтрСоединить(Части, "&");
	
КонецФункции

&НаСервере
Функция СобратьRawPostmanUrlИзQuery(Знач МассивQuery)
	
	СтрокаQuery = СобратьСтрокуQueryPostman(МассивQuery);
	Если ПустаяСтрока(СтрокаQuery) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "?" + СтрокаQuery;
	
КонецФункции

&НаСервере
Функция ПрочитатьСтруктуруДанныхЗапросаСтроки(Знач ДанныеЗапросаСтрока)
	
	Если ПустаяСтрока(ДанныеЗапросаСтрока) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
	Попытка
		ДанныеЗапроса = ЗначениеИзСтрокиВнутр(ДанныеЗапросаСтрока);
	Исключение
		Возврат Новый Структура;
	КонецПопытки;
	
	Если ТипЗнч(ДанныеЗапроса) <> Тип("Структура") Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
	Возврат ДанныеЗапроса;
	
КонецФункции

&НаСервере
Функция ПортативнаяАвторизацияВJSON(Знач ТипАвторизации, Знач ПараметрыАвторизации)
	
	Результат = Новый Структура;
	Результат.Вставить("type", ТипАвторизации);
	
	МассивПараметров = Новый Массив;
	Если ТипЗнч(ПараметрыАвторизации) = Тип("ТаблицаЗначений") Тогда
		Для Каждого СтрокаПараметра Из ПараметрыАвторизации Цикл
			Элемент = Новый Структура;
			Элемент.Вставить("key", СтрокаПараметра.Ключ);
			Элемент.Вставить("value", СтрокаПараметра.Значение);
			Элемент.Вставить("secret", СтрокаПараметра.Секретный);
			МассивПараметров.Добавить(Элемент);
		КонецЦикла;
	КонецЕсли;
	Результат.Вставить("params", МассивПараметров);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПортативнаяАвторизацияИзJSON(Знач ОписаниеАвторизации, Знач ТипПоУмолчанию)
	
	Результат = Новый Структура;
	Результат.Вставить(КлючПоляТипАвторизацииВДанныхЗапроса(), ТипПоУмолчанию);
	Результат.Вставить(КлючПоляПараметрыАвторизацииВДанныхЗапроса(), НовыйТаблицаПараметровАвторизации());
	
	Если ОписаниеАвторизации = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипАвторизацииИзJSON = ЗначениеСвойстваJSONКоллекции(
		ОписаниеАвторизации,
		КлючJSONType(),
		ТипПоУмолчанию);
	ТипАвторизации = СокрЛП(Строка(ТипАвторизацииИзJSON));
	Если Не ЭтоПоддерживаемыйТипАвторизацииКоллекции(ТипАвторизации) Тогда
		ТипАвторизации = ТипПоУмолчанию;
	КонецЕсли;
	Результат.ТипАвторизации = ТипАвторизации;
	
	МассивПараметров = ЗначениеСвойстваJSONКоллекции(ОписаниеАвторизации, "params", Новый Массив);
	Если ТипЗнч(МассивПараметров) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ЭлементПараметра Из МассивПараметров Цикл
		Если ТипЗнч(ЭлементПараметра) <> Тип("Соответствие")
			И ТипЗнч(ЭлементПараметра) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Результат.ПараметрыАвторизации.Добавить();
		НоваяСтрока.Ключ = Строка(ЗначениеСвойстваJSONКоллекции(ЭлементПараметра, "key", ""));
		НоваяСтрока.Значение = Строка(ЗначениеСвойстваJSONКоллекции(ЭлементПараметра, "value", ""));
		НоваяСтрока.Секретный = БулевоЗначениеJSONКоллекции(
			ЗначениеСвойстваJSONКоллекции(ЭлементПараметра, "secret", Ложь),
			Ложь);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЭтоПоддерживаемыйТипАвторизацииКоллекции(Знач ТипАвторизации)
	
	Возврат ТипАвторизации = "BasicAuth"
		Или ТипАвторизации = ИдентификаторТипаАвторизацииТокен()
		Или ТипАвторизации = ИдентификаторТипаАвторизацииБезАвторизации()
		Или ТипАвторизации = ИдентификаторТипаАвторизацииНаследоватьОтВладельца();
	
КонецФункции

&НаСервере
Функция АвторизацияИзPostmanAuth(Знач ОписаниеАвторизации, Знач ТипПоУмолчанию)
	
	Результат = Новый Структура;
	Результат.Вставить(КлючПоляТипАвторизацииВДанныхЗапроса(), ТипПоУмолчанию);
	Результат.Вставить(КлючПоляПараметрыАвторизацииВДанныхЗапроса(), НовыйТаблицаПараметровАвторизации());
	
	Если ОписаниеАвторизации = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипBearer = ТипАвторизацииPostmanBearer();
	ТипPostman = НРег(Строка(ЗначениеСвойстваJSONКоллекции(ОписаниеАвторизации, КлючJSONType(), "")));
	
	Если ТипPostman = "noauth" Тогда
		Результат.ТипАвторизации = ИдентификаторТипаАвторизацииБезАвторизации();
		Возврат Результат;
	КонецЕсли;
	
	Если ТипPostman = "basic" Тогда
		Результат.ТипАвторизации = "BasicAuth";
		ПараметрыBasic = ЗначениеСвойстваJSONКоллекции(ОписаниеАвторизации, "basic", Новый Массив);
		УстановитьЗначениеПараметраАвторизации(
			Результат.ПараметрыАвторизации,
			"login",
			ЗначениеПараметраPostmanAuth(ПараметрыBasic, "username"),
			Ложь);
		УстановитьЗначениеПараметраАвторизации(
			Результат.ПараметрыАвторизации,
			"password",
			ЗначениеПараметраPostmanAuth(ПараметрыBasic, "password"),
			Истина);
		Возврат Результат;
	КонецЕсли;
	
	Если ТипPostman = ТипBearer Тогда
		Результат.ТипАвторизации = ИдентификаторТипаАвторизацииТокен();
		ПараметрыBearer = ЗначениеСвойстваJSONКоллекции(ОписаниеАвторизации, ТипBearer, Новый Массив);
		УстановитьЗначениеПараметраАвторизации(
			Результат.ПараметрыАвторизации,
			КлючПоляАвторизацииПрефиксТокена(),
			"Bearer",
			Ложь);
		УстановитьЗначениеПараметраАвторизации(
			Результат.ПараметрыАвторизации,
			КлючПоляАвторизацииТокен(),
			ЗначениеПараметраPostmanAuth(ПараметрыBearer, "token"),
			Истина);
		Возврат Результат;
	КонецЕсли;
	
	// apikey, jwt, oauth1, oauth2 и прочее - не поддерживаются.
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция АвторизацияВPostmanAuth(Знач ТипАвторизации, Знач ПараметрыАвторизации)
	
	КлючType = КлючJSONType();
	ТипСтрока = ТипЗначенияPostmanСтрока();
	ТипBearer = ТипАвторизацииPostmanBearer();
	
	Если ЭтоТипАвторизацииНаследоватьОтВладельца(ТипАвторизации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипАвторизации = ИдентификаторТипаАвторизацииБезАвторизации() Тогда
		Результат = Новый Структура;
		Результат.Вставить(КлючType, "noauth");
		Возврат Результат;
	КонецЕсли;
	
	Если ТипАвторизации = "BasicAuth" Тогда
		Результат = Новый Структура;
		Результат.Вставить(КлючType, "basic");
		МассивПараметров = Новый Массив;
		Логин = ЗначениеПараметраАвторизацииИзТаблицы(ПараметрыАвторизации, "login");
		Пароль = ЗначениеПараметраАвторизацииИзТаблицы(ПараметрыАвторизации, "password");
		МассивПараметров.Добавить(ПараметрPostmanAuth("username", Логин, ТипСтрока));
		МассивПараметров.Добавить(ПараметрPostmanAuth("password", Пароль, ТипСтрока));
		Результат.Вставить("basic", МассивПараметров);
		Возврат Результат;
	КонецЕсли;
	
	Если ТипАвторизации = ИдентификаторТипаАвторизацииТокен() Тогда
		Токен = ЗначениеПараметраАвторизацииИзТаблицы(ПараметрыАвторизации, КлючПоляАвторизацииТокен());
		Префикс = ЗначениеПараметраАвторизацииИзТаблицы(ПараметрыАвторизации, КлючПоляАвторизацииПрефиксТокена());
		Если НРег(СокрЛП(Префикс)) <> ТипBearer И Не ПустаяСтрока(Префикс) Тогда
			Токен = СокрЛП(Префикс) + " " + Токен;
		КонецЕсли;
		Результат = Новый Структура;
		Результат.Вставить(КлючType, ТипBearer);
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(ПараметрPostmanAuth("token", Токен, ТипСтрока));
		Результат.Вставить(ТипBearer, МассивПараметров);
		Возврат Результат;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПараметрPostmanAuth(Знач Ключ, Знач Значение, Знач ТипЗначения)
	
	Результат = Новый Структура;
	Результат.Вставить("key", Ключ);
	Результат.Вставить("value", Значение);
	Результат.Вставить(КлючJSONType(), ТипЗначения);
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗначениеПараметраPostmanAuth(Знач МассивПараметров, Знач КлючПараметра)
	
	Если ТипЗнч(МассивПараметров) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	
	Для Каждого ЭлементПараметра Из МассивПараметров Цикл
		Если ТипЗнч(ЭлементПараметра) <> Тип("Соответствие")
			И ТипЗнч(ЭлементПараметра) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Если Строка(ЗначениеСвойстваJSONКоллекции(ЭлементПараметра, "key", "")) = КлючПараметра Тогда
			Возврат Строка(ЗначениеСвойстваJSONКоллекции(ЭлементПараметра, "value", ""));
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
