// Реквизиты формы (Form.form): BSL LS без связи с метаданными считает их локальными переменными.
// BSLLS:UnusedLocalVariable-off

#Область ОбработчикиСобытийФормы

// BSLLS:UnusedLocalMethod-off

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбеспечитьРеквизитСписокЗапросовДеревом();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	НастроитьКоманднуюПанельСпискаЗапросов();
	УстановитьДоступностьОбластиЗапроса(Ложь);
	ВосстановитьНастройкиОбработки();
	ИнициализироватьСписокЗапросовПослеОткрытия();
	ПодключитьАвтосохранениеНастроек();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если АвтосохранениеВключено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗакрытиеПодтверждено Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
	ПоказатьВопрос(
		ОписаниеОповещения,
		"Сохранить данные формы?",
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	ОтключитьОбработчикОжидания("АвтосохранениеНастроек");
	
	// При завершении работы платформы хранилище системных настроек недоступно.
	// При выключенном автосохранении сохранение выполняется по ответу в ПередЗакрытием.
	Если Не ЗавершениеРаботы И АвтосохранениеВключено Тогда
		СохранитьНастройкиОбработки();
	КонецЕсли;
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура ТипАвторизацииПриИзменении(Элемент)
	
	СкрытьГруппыАвторизаций();
	
	Если ТипАвторизации = "BasicAuth" Тогда
		Элементы.ЛогинПароль.Видимость = Истина;
	ИначеЕсли ТипАвторизации = "Token" Тогда
		Элементы.ГруппаТокен.Видимость = Истина;
	Иначе
		Элементы.ЛогинПароль.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТелоЗапросаПриИзменении(Элемент)
	БьютифицированныйЗапрос(ТелоЗапроса, "ТелоЗапроса", ВариантТелаЗапроса);
КонецПроцедуры

&НаКлиенте
Процедура ВариантТелаЗапросаПриИзменении(Элемент)
	
	Если ВариантТелаЗапроса = "NONE" Тогда
		ТелоЗапроса = "";
		ПутьКФайлуВх = "";
	КонецЕсли;
	
	ОтобразитьВариантТелаЗапроса();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура СписокЗапросовПриАктивизацииСтроки(Элемент)
	
	Если ИдетПереключениеЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоГруппа Тогда
		
		ИдетПереключениеЗапроса = Истина;
		
		Попытка
			Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
				ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
			КонецЕсли;
			
			ИдентификаторТекущегоЗапроса = "";
			ОчиститьФормуЗапросаНаСервере();
			УстановитьДоступностьОбластиЗапроса(Ложь);
		Исключение
			ИдетПереключениеЗапроса = Ложь;
			ВызватьИсключение;
		КонецПопытки;
		
		ИдетПереключениеЗапроса = Ложь;
		Возврат;
		
	КонецЕсли;
	
	Если ТекущиеДанные.Идентификатор = ИдентификаторТекущегоЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
			ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
		КонецЕсли;
		
		ИдентификаторТекущегоЗапроса = ТекущиеДанные.Идентификатор;
		ЗагрузитьЗапросИзСпискаНаСервере(ИдентификаторТекущегоЗапроса);
		УстановитьДоступностьОбластиЗапроса(Истина);
		ОбновитьОтображениеФормыЗапроса();
	Исключение
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеЗапроса = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗапросовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Если ИдетПереключениеЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	Если Копирование Тогда
		СкопироватьЗапрос(Неопределено);
	ИначеЕсли Группа Тогда
		ДобавитьПапку(Неопределено);
	Иначе
		ДобавитьЗапрос(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗапросовОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	
	Если ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторТекущейСтроки = "";
	ТекущиеДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ИдентификаторТекущейСтроки = ТекущиеДанные.Идентификатор;
	КонецЕсли;
	
	НормализоватьСтруктуруСпискаЗапросовПослеИзмененияНаСервере();
	
	Если Не ПустаяСтрока(ИдентификаторТекущейСтроки) Тогда
		УстановитьТекущуюСтрокуСпискаЗапросов(ИдентификаторТекущейСтроки);
	КонецЕсли;
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиКомандФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура Отправить(Команда)
	
	ПроверкаУсловий = УсловияОтправкиВыполнены();
	
	Если ПроверкаУсловий.УсловияВыполнены  Тогда
		ОтправитьHTTPЗапросАсинх(СтруктураURI(URI));
	Иначе
		ВывестиСообщениеПользователю("Запрос не может быть отправлен, поскольку не все обязательные поля были заполнены");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВходящийФайл(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл который хотите передать";
	Диалог.Показать(Новый ОписаниеОповещения("ВыбратьФайлЗавершение", ЭтотОбъект));
	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтветВФайл(Команда)
	
	Если ПустаяСтрока(ЗапросОтвет) Тогда
		ВывестиСообщениеПользователю("Нет данных для сохранения");
		Возврат;
	КонецЕсли;
	
	ФорматОтвета = ФорматОтветаДляСохранения;
	Если ПустаяСтрока(ФорматОтвета) Тогда
		ФорматОтвета = ОпределитьФорматОтветаДляСохранения();
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить результат запроса";
	ЗаполнитьПараметрыДиалогаСохраненияПоФормату(Диалог, ФорматОтвета);
	Диалог.Показать(Новый ОписаниеОповещения("СохранитьОтветВФайлЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура Настройки(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Таймаут", Таймаут);
	ПараметрыФормы.Вставить("АвтосохранениеВключено", АвтосохранениеВключено);
	ПараметрыФормы.Вставить("ИнтервалАвтосохранения", ИнтервалАвтосохранения);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("НастройкиЗавершение", ЭтотОбъект);
	
	ОткрытьФорму(
		ПолучитьИмяОбработки() + ".Форма.ФормаНастроек",
		ПараметрыФормы,
		,
		,
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПапку(Команда)
	
	Если ИдетПереключениеЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторТекущейСтроки = "";
	ТекущаяСтрокаЭтоГруппа = Ложь;
	ТекущиеДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ИдентификаторТекущейСтроки = ТекущиеДанные.Идентификатор;
		ТекущаяСтрокаЭтоГруппа = ТекущиеДанные.ЭтоГруппа;
	КонецЕсли;
	
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
			ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
		КонецЕсли;
		
		НовыйИдентификатор = ДобавитьПапкуВСписокНаСервере(ИдентификаторТекущейСтроки, ТекущаяСтрокаЭтоГруппа);
		НормализоватьСтруктуруСпискаЗапросовПослеИзмененияНаСервере();
		ИдентификаторТекущегоЗапроса = "";
		УстановитьТекущуюСтрокуСпискаЗапросов(НовыйИдентификатор);
		ОчиститьФормуЗапросаНаСервере();
		УстановитьДоступностьОбластиЗапроса(Ложь);
	Исключение
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеЗапроса = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗапрос(Команда)
	
	Если ИдетПереключениеЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторТекущейСтроки = "";
	ТекущаяСтрокаЭтоГруппа = Ложь;
	ТекущиеДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ИдентификаторТекущейСтроки = ТекущиеДанные.Идентификатор;
		ТекущаяСтрокаЭтоГруппа = ТекущиеДанные.ЭтоГруппа;
	КонецЕсли;
	
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
			ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
		КонецЕсли;
		
		НовыйИдентификатор = ДобавитьЗапросВСписокНаСервере(ИдентификаторТекущейСтроки, ТекущаяСтрокаЭтоГруппа, Истина);
		ИдентификаторТекущегоЗапроса = НовыйИдентификатор;
		УстановитьТекущуюСтрокуСпискаЗапросов(НовыйИдентификатор);
		ЗагрузитьЗапросИзСпискаНаСервере(НовыйИдентификатор);
		УстановитьДоступностьОбластиЗапроса(Истина);
		ОбновитьОтображениеФормыЗапроса();
	Исключение
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеЗапроса = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьЗапрос(Команда)
	
	Если ИдетПереключениеЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторИсходнойСтроки = ТекущиеДанные.Идентификатор;
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
			ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
		КонецЕсли;
		
		НовыйИдентификатор = СкопироватьЭлементСпискаЗапросовНаСервере(ИдентификаторИсходнойСтроки);
		Если ПустаяСтрока(НовыйИдентификатор) Тогда
			Возврат;
		КонецЕсли;
		
		НормализоватьСтруктуруСпискаЗапросовПослеИзмененияНаСервере();
		УстановитьТекущуюСтрокуСпискаЗапросов(НовыйИдентификатор);
		
		Если Не ТекущиеДанные.ЭтоГруппа Тогда
			ИдентификаторТекущегоЗапроса = НовыйИдентификатор;
			ЗагрузитьЗапросИзСпискаНаСервере(НовыйИдентификатор);
			УстановитьДоступностьОбластиЗапроса(Истина);
			ОбновитьОтображениеФормыЗапроса();
		Иначе
			ИдентификаторТекущегоЗапроса = "";
			ОчиститьФормуЗапросаНаСервере();
			УстановитьДоступностьОбластиЗапроса(Ложь);
		КонецЕсли;
	Исключение
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеЗапроса = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНаименованиеСпискаЗапросов(Команда)
	
	Если Элементы.СписокЗапросов.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийЭлемент = Элементы.СписокЗапросов;
	ПодключитьОбработчикОжидания("СписокЗапросовНачатьИзменениеСтроки", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗапросовНачатьИзменениеСтроки()
	
	Если Элементы.СписокЗапросов.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.СписокЗапросов.ИзменитьСтроку();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗапрос(Команда)
	
	ТекущиеДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторУдаляемого = ТекущиеДанные.Идентификатор;
	
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		РезультатУдаления = УдалитьЭлементИзСпискаНаСервере(ИдентификаторУдаляемого);
		ИдентификаторТекущегоЗапроса = РезультатУдаления.ИдентификаторЗапроса;
		УстановитьТекущуюСтрокуСпискаЗапросов(РезультатУдаления.ИдентификаторСтрокиСписка);
		
		Если РезультатУдаления.ЭтоГруппа Тогда
			ОчиститьФормуЗапросаНаСервере();
			УстановитьДоступностьОбластиЗапроса(Ложь);
		Иначе
			ЗагрузитьЗапросИзСпискаНаСервере(ИдентификаторТекущегоЗапроса);
			УстановитьДоступностьОбластиЗапроса(Истина);
			ОбновитьОтображениеФормыЗапроса();
		КонецЕсли;
	Исключение
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеЗапроса = Ложь;
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Клиент

// BSLLS:UnusedLocalMethod-off - вызов платформой через ПодключитьОбработчикОжидания.

&НаКлиенте
Процедура АвтосохранениеНастроек()
	
	// Не сохраняем во время ввода - контекстный вызов сбивает каретку и выделение.
	Если ИдетВводДанныхНаФорме() Тогда
		Возврат;
	КонецЕсли;
	
	СохранитьНастройкиОбработки();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

&НаКлиенте
Функция ИдетВводДанныхНаФорме()
	
	Если ТекущийЭлемент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипЭлемента = ТипЗнч(ТекущийЭлемент);
	Возврат ТипЭлемента = Тип("ПолеФормы") Или ТипЭлемента = Тип("ТаблицаФормы");
	
КонецФункции

&НаКлиенте
Процедура ПодключитьАвтосохранениеНастроек()
	
	ОтключитьОбработчикОжидания("АвтосохранениеНастроек");
	
	Если АвтосохранениеВключено И ИнтервалАвтосохранения >= 1 Тогда
		ПодключитьОбработчикОжидания("АвтосохранениеНастроек", ИнтервалАвтосохранения, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьОбластиЗапроса(Знач Доступна)
	
	Элементы.ГруппаПраво.Доступность = Доступна;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеФормыЗапроса()
	
	ОтобразитьВариантТелаЗапроса();
	СкрытьГруппыАвторизаций();
	ТипАвторизацииПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьСписокЗапросовПослеОткрытия()
	
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		ДанныеИнициализации = ИнициализироватьСписокЗапросовПослеОткрытияНаСервере();
		ИдентификаторТекущегоЗапроса = ДанныеИнициализации.ИдентификаторЗапроса;
		УстановитьТекущуюСтрокуСпискаЗапросов(ДанныеИнициализации.ИдентификаторСтрокиСписка);
		
		Если ДанныеИнициализации.ЭтоГруппа Тогда
			УстановитьДоступностьОбластиЗапроса(Ложь);
		Иначе
			УстановитьДоступностьОбластиЗапроса(Истина);
			ОбновитьОтображениеФормыЗапроса();
		КонецЕсли;
	Исключение
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеЗапроса = Ложь;
	
	НастроитьКоманднуюПанельСпискаЗапросов();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьКоманднуюПанельСпискаЗапросов()
	
	Элементы.СписокЗапросов.ИзменятьСоставСтрок = Истина;
	Элементы.СписокЗапросов.ИзменятьПорядокСтрок = Истина;
	Элементы.ДобавитьЗапрос.Доступность = Истина;
	Элементы.УдалитьЗапрос.Доступность = Истина;
	
	ИменаКнопокКонтекстногоМенюСписка = Новый Массив;
	ИменаКнопокКонтекстногоМенюСписка.Добавить("СписокЗапросовДобавитьПапкуКонтекст");
	ИменаКнопокКонтекстногоМенюСписка.Добавить("СписокЗапросовДобавитьЗапросКонтекст");
	ИменаКнопокКонтекстногоМенюСписка.Добавить("СписокЗапросовСкопироватьКонтекст");
	ИменаКнопокКонтекстногоМенюСписка.Добавить("СписокЗапросовИзменитьКонтекст");
	ИменаКнопокКонтекстногоМенюСписка.Добавить("СписокЗапросовУдалитьКонтекст");
	ИменаКнопокКонтекстногоМенюСписка.Добавить("СписокЗапросовРасширенныйПоискКонтекст");
	ИменаКнопокКонтекстногоМенюСписка.Добавить("СписокЗапросовНаименованиеДобавитьПапкуКонтекст");
	ИменаКнопокКонтекстногоМенюСписка.Добавить("СписокЗапросовНаименованиеДобавитьЗапросКонтекст");
	ИменаКнопокКонтекстногоМенюСписка.Добавить("СписокЗапросовНаименованиеСкопироватьКонтекст");
	ИменаКнопокКонтекстногоМенюСписка.Добавить("СписокЗапросовНаименованиеИзменитьКонтекст");
	ИменаКнопокКонтекстногоМенюСписка.Добавить("СписокЗапросовНаименованиеУдалитьКонтекст");
	ИменаКнопокКонтекстногоМенюСписка.Добавить("СписокЗапросовНаименованиеРасширенныйПоискКонтекст");
	
	Для Каждого ИмяКнопки Из ИменаКнопокКонтекстногоМенюСписка Цикл
		
		ЭлементКнопки = Элементы.Найти(ИмяКнопки);
		Если ЭлементКнопки <> Неопределено Тогда
			ЭлементКнопки.Доступность = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущуюСтрокуСпискаЗапросов(Знач ИдентификаторСтрокиСписка)
	
	ИдентификаторСтроки = НайтиИдентификаторСтрокиСпискаЗапросовНаСервере(ИдентификаторСтрокиСписка);
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.СписокЗапросов.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;
	
КонецПроцедуры

