// BSLLS:UnusedLocalVariable-off
#Область ОбработчикиСобытийФормы
// BSLLS:UnusedLocalMethod-off

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Наименование") Тогда
		Наименование = Параметры.Наименование;
	Иначе
		Наименование = "";
	КонецЕсли;
	
	Если Параметры.Свойство("ИспользоватьТаймаутПоУмолчанию") Тогда
		ИспользоватьТаймаутПоУмолчанию = Параметры.ИспользоватьТаймаутПоУмолчанию;
	Иначе
		ИспользоватьТаймаутПоУмолчанию = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("ТаймаутКоллекции") Тогда
		ТаймаутКоллекции = Параметры.ТаймаутКоллекции;
	Иначе
		ТаймаутКоллекции = 0;
	КонецЕсли;
	
	Если Параметры.Свойство("ТипАвторизации") И Не ПустаяСтрока(Параметры.ТипАвторизации) Тогда
		ТипАвторизации = Параметры.ТипАвторизации;
	Иначе
		ТипАвторизации = "NoAuth";
	КонецЕсли;
	
	ЗагрузитьПараметрыАвторизацииИзПараметровФормы();
	ПерестроитьПараметрыАвторизацииПоСхемеНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьДоступностьТаймаутаКоллекции();
	ОтобразитьПоляАвторизацииПоСхеме();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура ИспользоватьТаймаутПоУмолчаниюПриИзменении(Элемент)
	
	ОбновитьДоступностьТаймаутаКоллекции();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипАвторизацииПриИзменении(Элемент)
	
	ПараметрыАвторизации.Очистить();
	ПерестроитьПараметрыАвторизацииПоСхеме();
	ОтобразитьПоляАвторизацииПоСхеме();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеАвторизацииПриИзменении(Элемент)
	
	СинхронизироватьПараметрыАвторизацииИзПолейФормы();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиКомандФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура ПрименитьНастройкиКоллекции(Команда)
	
	Если ПустаяСтрока(СокрЛП(Наименование)) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите наименование коллекции";
		Сообщение.Поле = "Наименование";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если Не ИспользоватьТаймаутПоУмолчанию И ТаймаутКоллекции < 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Таймаут коллекции не может быть отрицательным";
		Сообщение.Поле = "ТаймаутКоллекции";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	СинхронизироватьПараметрыАвторизацииИзПолейФормы();
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование", СокрЛП(Наименование));
	Результат.Вставить("ИспользоватьТаймаутПоУмолчанию", ИспользоватьТаймаутПоУмолчанию);
	Результат.Вставить("ТаймаутКоллекции", ТаймаутКоллекции);
	Результат.Вставить("ТипАвторизации", ТипАвторизации);
	Результат.Вставить("ПараметрыАвторизации", ПараметрыАвторизацииВМассивСтруктур());
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьНастройкиКоллекции(Команда)
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортироватьКоллекцию(Команда)
	
	Если ВладелецФормы = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Импорт коллекции доступен только из главной формы обработки";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ВладелецФормы.ИмпортироватьКоллекциюИзФайла();
	
КонецПроцедуры

&НаКлиенте
Процедура ЭкспортироватьКоллекцию(Команда)
	
	Если ВладелецФормы = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Экспорт коллекции доступен только из главной формы обработки";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ВладелецФормы.ЭкспортироватьТекущуюКоллекциюВФайл();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьПараметрыАвторизацииИзПараметровФормы()
	
	ПараметрыАвторизации.Очистить();
	Если Не Параметры.Свойство("ПараметрыАвторизации") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Параметры.ПараметрыАвторизации) = Тип("ТаблицаЗначений") Тогда
		ПараметрыАвторизации.Загрузить(Параметры.ПараметрыАвторизации);
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Параметры.ПараметрыАвторизации) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементМассива Из Параметры.ПараметрыАвторизации Цикл
		
		Если ТипЗнч(ЭлементМассива) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ПараметрыАвторизации.Добавить();
		Если ЭлементМассива.Свойство("Ключ") Тогда
			НоваяСтрока.Ключ = ЭлементМассива.Ключ;
		КонецЕсли;
		Если ЭлементМассива.Свойство("Значение") Тогда
			НоваяСтрока.Значение = ЭлементМассива.Значение;
		КонецЕсли;
		Если ЭлементМассива.Свойство("Секретный") Тогда
			НоваяСтрока.Секретный = ЭлементМассива.Секретный;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьТаймаутаКоллекции()
	
	Элементы.ТаймаутКоллекции.Доступность = Не ИспользоватьТаймаутПоУмолчанию;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьПоляАвторизацииПоСхеме()
	
	Схема = ОписаниеСхемыАвторизацииКоллекции(ТипАвторизации);
	ЗначенияПараметров = СоответствиеЗначенийПараметровАвторизацииКоллекции(ПараметрыАвторизации);
	МаксимумПолей = МаксимумПолейАвторизацииНаФормеКоллекции();
	КоличествоПолейСхемы = Схема.Поля.Количество();
	
	Для Индекс = 1 По МаксимумПолей Цикл
		
		ИндексСтрокой = ФорматЦелогоБезГруппировкиКоллекции(Индекс);
		ИмяЭлемента = "ПолеАвторизации" + ИндексСтрокой;
		ИмяРеквизита = "ЗначениеАвторизации" + ИндексСтрокой;
		ЭлементПоля = Элементы[ИмяЭлемента];
		
		Если Индекс > КоличествоПолейСхемы Тогда
			ЭлементПоля.Видимость = Ложь;
			ЭтотОбъект[ИмяРеквизита] = "";
			Продолжить;
		КонецЕсли;
		
		ОписаниеПоля = Схема.Поля[Индекс - 1];
		ЗначениеПоля = ЗначенияПараметров.Получить(ОписаниеПоля.Ключ);
		Если ЗначениеПоля = Неопределено Тогда
			ЗначениеПоля = ОписаниеПоля.ЗначениеПоУмолчанию;
		КонецЕсли;
		
		ЭтотОбъект[ИмяРеквизита] = ЗначениеПоля;
		ЭлементПоля.Видимость = Истина;
		ЭлементПоля.Заголовок = ОписаниеПоля.Заголовок;
		ЭлементПоля.РежимПароля = ОписаниеПоля.Секретный;
		ЭлементПоля.МногострочныйРежим = ОписаниеПоля.Многострочный;
		ЭлементПоля.Высота = ?(ОписаниеПоля.Многострочный, 5, 1);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьПараметрыАвторизацииИзПолейФормы()
	
	Схема = ОписаниеСхемыАвторизацииКоллекции(ТипАвторизации);
	КоличествоПолейСхемы = Мин(Схема.Поля.Количество(), МаксимумПолейАвторизацииНаФормеКоллекции());
	
	Для Индекс = 1 По КоличествоПолейСхемы Цикл
		
		ОписаниеПоля = Схема.Поля[Индекс - 1];
		ИмяРеквизита = "ЗначениеАвторизации" + ФорматЦелогоБезГруппировкиКоллекции(Индекс);
		УстановитьЗначениеПараметраАвторизацииКоллекции(
			ПараметрыАвторизации,
			ОписаниеПоля.Ключ,
			ЭтотОбъект[ИмяРеквизита],
			ОписаниеПоля.Секретный);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерестроитьПараметрыАвторизацииПоСхеме()
	
	ПерестроитьПараметрыАвторизацииПоСхемеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПерестроитьПараметрыАвторизацииПоСхемеНаСервере()
	
	Схема = ОписаниеСхемыАвторизацииКоллекции(ТипАвторизации);
	СтарыеЗначения = Новый Соответствие;
	
	Для Каждого СтрокаПараметра Из ПараметрыАвторизации Цикл
		СтарыеЗначения.Вставить(СтрокаПараметра.Ключ, СтрокаПараметра.Значение);
	КонецЦикла;
	
	ПараметрыАвторизации.Очистить();
	
	Для Каждого ОписаниеПоля Из Схема.Поля Цикл
		
		ЗначениеПоля = СтарыеЗначения.Получить(ОписаниеПоля.Ключ);
		Если ЗначениеПоля = Неопределено Тогда
			ЗначениеПоля = ОписаниеПоля.ЗначениеПоУмолчанию;
		КонецЕсли;
		
		УстановитьЗначениеПараметраАвторизацииКоллекции(
			ПараметрыАвторизации,
			ОписаниеПоля.Ключ,
			ЗначениеПоля,
			ОписаниеПоля.Секретный);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыАвторизацииВМассивСтруктур()
	
	Результат = Новый Массив;
	
	Для Каждого СтрокаПараметра Из ПараметрыАвторизации Цикл
		
		Элемент = Новый Структура;
		Элемент.Вставить("Ключ", СтрокаПараметра.Ключ);
		Элемент.Вставить("Значение", СтрокаПараметра.Значение);
		Элемент.Вставить("Секретный", СтрокаПараметра.Секретный);
		Результат.Добавить(Элемент);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеСхемыАвторизацииКоллекции(Знач ТипАвторизации)
	
	Схема = Новый Структура;
	Схема.Вставить("Поля", Новый Массив);
	
	Если ТипАвторизации = "BasicAuth" Тогда
		
		ПолеЛогина = НовоеПолеСхемыАвторизацииКоллекции("login", "Логин", Ложь, Ложь, "");
		ПолеПароля = НовоеПолеСхемыАвторизацииКоллекции("password", "Пароль", Истина, Ложь, "");
		Схема.Поля.Добавить(ПолеЛогина);
		Схема.Поля.Добавить(ПолеПароля);
		
	ИначеЕсли ТипАвторизации = ИдентификаторТипаАвторизацииТокенКоллекции() Тогда
		
		ПолеПрефикса = НовоеПолеСхемыАвторизацииКоллекции(
			"tokenPrefix",
			"Префикс токена",
			Ложь,
			Ложь,
			ИдентификаторТипаАвторизацииТокенКоллекции());
		ПолеТокена = НовоеПолеСхемыАвторизацииКоллекции(
			"token",
			"Токен",
			Истина,
			Ложь,
			"");
		Схема.Поля.Добавить(ПолеПрефикса);
		Схема.Поля.Добавить(ПолеТокена);
		
	Иначе
		Возврат Схема;
	КонецЕсли;
	
	Возврат Схема;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовоеПолеСхемыАвторизацииКоллекции(
	Знач Ключ,
	Знач Заголовок,
	Знач Секретный,
	Знач Многострочный,
	Знач ЗначениеПоУмолчанию)
	
	Поле = Новый Структура;
	Поле.Вставить("Ключ", Ключ);
	Поле.Вставить("Заголовок", Заголовок);
	Поле.Вставить("Секретный", Секретный);
	Поле.Вставить("Многострочный", Многострочный);
	Поле.Вставить("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию);
	
	Возврат Поле;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция МаксимумПолейАвторизацииНаФормеКоллекции()
	
	Возврат 6;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФорматЦелогоБезГруппировкиКоллекции(Знач Число)
	
	Возврат Формат(Число, "ЧГ=0");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИдентификаторТипаАвторизацииТокенКоллекции()
	
	Возврат "Token";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СоответствиеЗначенийПараметровАвторизацииКоллекции(Знач ТаблицаПараметров)
	
	Результат = Новый Соответствие;
	
	Для Каждого СтрокаПараметра Из ТаблицаПараметров Цикл
		Результат.Вставить(СтрокаПараметра.Ключ, СтрокаПараметра.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗначениеПараметраАвторизацииКоллекции(ТаблицаПараметров, Знач Ключ, Знач Значение, Знач Секретный)
	
	Для Каждого СтрокаПараметра Из ТаблицаПараметров Цикл
		
		Если СтрокаПараметра.Ключ = Ключ Тогда
			СтрокаПараметра.Значение = Значение;
			СтрокаПараметра.Секретный = Секретный;
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	НоваяСтрока = ТаблицаПараметров.Добавить();
	НоваяСтрока.Ключ = Ключ;
	НоваяСтрока.Значение = Значение;
	НоваяСтрока.Секретный = Секретный;
	
КонецПроцедуры

#КонецОбласти

// BSLLS:UnusedLocalVariable-on
