Функция НовоеПолеСхемыАвторизации(
	Знач Ключ,
	Знач Заголовок,
	Знач Секретный,
	Знач Многострочный,
	Знач ЗначениеПоУмолчанию,
	Знач ВариантыВыбора = Неопределено)
	
	Поле = Новый Структура;
	Поле.Вставить("Ключ", Ключ);
	Поле.Вставить("Заголовок", Заголовок);
	Поле.Вставить("Секретный", Секретный);
	Поле.Вставить("Многострочный", Многострочный);
	Поле.Вставить("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию);
	Если ВариантыВыбора = Неопределено Тогда
		Поле.Вставить("ВариантыВыбора", Новый Массив);
	Иначе
		Поле.Вставить("ВариантыВыбора", ВариантыВыбора);
	КонецЕсли;
	
	Возврат Поле;
	
КонецФункции

