// BSLLS:UnusedLocalVariable-off

#Область ОбработчикиСобытийФормы

// BSLLS:UnusedLocalMethod-off

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Таймаут") Тогда
		Таймаут = Параметры.Таймаут;
	Иначе
		Таймаут = 0;
	КонецЕсли;
	
	Если Параметры.Свойство("АвтосохранениеВключено") Тогда
		АвтосохранениеВключено = Параметры.АвтосохранениеВключено;
	Иначе
		АвтосохранениеВключено = Ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("ИнтервалАвтосохранения") Тогда
		ИнтервалАвтосохранения = Параметры.ИнтервалАвтосохранения;
	Иначе
		ИнтервалАвтосохранения = 30;
	КонецЕсли;
	
	Если Параметры.Свойство("РежимОтправкиПоУмолчанию") Тогда
		РежимОтправкиПоУмолчанию = Параметры.РежимОтправкиПоУмолчанию;
	Иначе
		РежимОтправкиПоУмолчанию = "Клиент";
	КонецЕсли;
	
	Если Параметры.Свойство("ИсторияВключена") Тогда
		ИсторияВключена = Параметры.ИсторияВключена;
	Иначе
		ИсторияВключена = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("КаталогИсторииЗапросов") Тогда
		КаталогИсторииЗапросов = Параметры.КаталогИсторииЗапросов;
	Иначе
		КаталогИсторииЗапросов = "";
	КонецЕсли;
	
	Если Параметры.Свойство("МаксЗаписейИсторииЗапросов") Тогда
		МаксЗаписейИсторииЗапросов = Параметры.МаксЗаписейИсторииЗапросов;
	Иначе
		МаксЗаписейИсторииЗапросов = 200;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьДоступностьИнтервалаАвтосохранения();
	ОбновитьДоступностьНастроекИстории();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура АвтосохранениеВключеноПриИзменении(Элемент)
	
	ОбновитьДоступностьИнтервалаАвтосохранения();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиКомандФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура ПрименитьНастройки(Команда)
	
	Если АвтосохранениеВключено И ИнтервалАвтосохранения < 1 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Интервал автосохранения должен быть не меньше 1 секунды";
		Сообщение.Поле = "ИнтервалАвтосохранения";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если ИсторияВключена И МаксЗаписейИсторииЗапросов < 1 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Максимальное число записей истории должно быть не меньше 1";
		Сообщение.Поле = "МаксЗаписейИсторииЗапросов";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Результат = СформироватьРезультатПримененияНастроекНаСервере();
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьНастройки(Команда)
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталогИстории(Команда)
	
#Если ВебКлиент Тогда
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Выбор каталога истории недоступен в веб-клиенте";
	Сообщение.Сообщить();
	Возврат;
#Иначе
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Каталог истории запросов";
	Если Не ПустаяСтрока(КаталогИсторииЗапросов) Тогда
		Диалог.Каталог = КаталогИсторииЗапросов;
	КонецЕсли;
	Диалог.Показать(Новый ОписаниеОповещения("ВыбратьКаталогИсторииЗавершение", ЭтотОбъект));
#КонецЕсли
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СформироватьРезультатПримененияНастроекНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("Таймаут", Таймаут);
	Результат.Вставить("АвтосохранениеВключено", АвтосохранениеВключено);
	Результат.Вставить("ИнтервалАвтосохранения", ИнтервалАвтосохранения);
	Результат.Вставить("РежимОтправкиПоУмолчанию", РежимОтправкиПоУмолчанию);
	Результат.Вставить("ИсторияВключена", ИсторияВключена);
	Результат.Вставить("КаталогИсторииЗапросов", КаталогИсторииЗапросов);
	Результат.Вставить("МаксЗаписейИсторииЗапросов", МаксЗаписейИсторииЗапросов);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьДоступностьИнтервалаАвтосохранения()
	
	Элементы.ИнтервалАвтосохранения.Доступность = АвтосохранениеВключено;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьНастроекИстории()
	
#Если ВебКлиент Тогда
	Элементы.ИсторияВключена.Доступность = Ложь;
	Элементы.КаталогИсторииЗапросов.Доступность = Ложь;
	Элементы.КнопкаВыбратьКаталогИстории.Доступность = Ложь;
	Элементы.МаксЗаписейИсторииЗапросов.Доступность = Ложь;
	ИсторияВключена = Ложь;
#Иначе
	Элементы.ИсторияВключена.Доступность = Истина;
	Элементы.КаталогИсторииЗапросов.Доступность = Истина;
	Элементы.КнопкаВыбратьКаталогИстории.Доступность = Истина;
	Элементы.МаксЗаписейИсторииЗапросов.Доступность = Истина;
#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталогИсторииЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КаталогИсторииЗапросов = ВыбранныеФайлы[0];
	
КонецПроцедуры

#КонецОбласти

// BSLLS:UnusedLocalVariable-on
