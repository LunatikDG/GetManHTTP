КонецПроцедуры

&НаСервере
Процедура ЗаписатьДеревоВКоллекциюНаСервере(Знач ИдентификаторКоллекции)
	
	Если ПустаяСтрока(ИдентификаторКоллекции) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКоллекций = ТаблицаКоллекцийЗапросов();
	СтрокаКоллекции = НайтиСтрокуКоллекцииЗапросов(ИдентификаторКоллекции, ТаблицаКоллекций);
	Если СтрокаКоллекции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаКоллекции.ДанныеСписка = ЗначениеВСтрокуВнутр(ДеревоСписокЗапросов());
	ЗаписатьТаблицуКоллекцийЗапросов(ТаблицаКоллекций);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДеревоИзКоллекцииНаСервере(Знач ИдентификаторКоллекции)
	
	СтрокаКоллекции = НайтиСтрокуКоллекцииЗапросов(ИдентификаторКоллекции);
	Если СтрокаКоллекции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаКоллекции.ДанныеСписка) Тогда
		ПустоеДерево = ДеревоСписокЗапросов();
		ПустоеДерево.Строки.Очистить();
		ЗаписатьДеревоСписокЗапросов(ПустоеДерево);
		Возврат;
	КонецЕсли;
	
	ЗагрузитьСписокЗапросовИзХранилища(СтрокаКоллекции.ДанныеСписка);
	
КонецПроцедуры

&НаСервере
Процедура ОбернутьДеревоВЕдинственнуюКоллекциюНаСервере()
	
	ТаблицаКоллекций = ТаблицаКоллекцийЗапросов();
	ТаблицаКоллекций.Очистить();
	
	ИдентификаторКоллекции = НовыйИдентификаторКоллекцииЗапросов();
	СтрокаКоллекции = ТаблицаКоллекций.Добавить();
	СтрокаКоллекции.Идентификатор = ИдентификаторКоллекции;
	СтрокаКоллекции.Наименование = ИмяКоллекцииЗапросовПоУмолчанию();
	СтрокаКоллекции.ИспользоватьТаймаутПоУмолчанию = Истина;
	СтрокаКоллекции.Таймаут = 0;
	СтрокаКоллекции.ТипАвторизации = ИдентификаторТипаАвторизацииБезАвторизации();
	СтрокаКоллекции.ПараметрыАвторизации = "";
	СтрокаКоллекции.ДанныеСписка = ЗначениеВСтрокуВнутр(ДеревоСписокЗапросов());
	
	ТекущаяКоллекция = ИдентификаторКоллекции;
	ЗаписатьТаблицуКоллекцийЗапросов(ТаблицаКоллекций);
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьВосстановлениеКоллекцийЗапросовНаСервере()
	
	ТаблицаКоллекций = ТаблицаКоллекцийЗапросов();
	ОбеспечитьКолонкиАвторизацииВТаблицеКоллекций(ТаблицаКоллекций);
	ЗаписатьТаблицуКоллекцийЗапросов(ТаблицаКоллекций);
	
	Если ТаблицаКоллекций.Количество() = 0 Тогда
		ОбернутьДеревоВЕдинственнуюКоллекциюНаСервере();
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ТекущаяКоллекция)
		Или НайтиСтрокуКоллекцииЗапросов(ТекущаяКоллекция, ТаблицаКоллекций) = Неопределено Тогда
		ТекущаяКоллекция = ТаблицаКоллекций[0].Идентификатор;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПервоначальногоВыбораПослеСменыКоллекцииНаСервере()
	
	ОбеспечитьРеквизитСписокЗапросовДеревом();
	ОбеспечитьМинимумОдинЗапросНаСервере(Истина);
	НормализоватьСтруктуруСпискаЗапросовПослеИзмененияНаСервере();
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗапроса", "");
	Результат.Вставить("ИдентификаторСтрокиСписка", "");
	Результат.Вставить("ЭтоГруппа", Ложь);
	Результат.Вставить("ИдентификаторКоллекции", ТекущаяКоллекция);
	
	ДанныеВыбора = ПолучитьДанныеПервоначальногоВыбораСпискаНаСервере();
	Результат.ИдентификаторЗапроса = ДанныеВыбора.ИдентификаторЗапроса;
	Результат.ИдентификаторСтрокиСписка = ДанныеВыбора.ИдентификаторСтрокиСписка;
	Результат.ЭтоГруппа = ДанныеВыбора.ЭтоГруппа;
	
	ИдентификаторТекущегоЗапроса = ДанныеВыбора.ИдентификаторЗапроса;
	Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
		
		Если ДанныеВыбора.ЭтоГруппа Тогда
			ЗагрузитьАвторизациюЭлементаИзСпискаНаСервере(ИдентификаторТекущегоЗапроса);
		Иначе
			ЗагрузитьЗапросИзСпискаНаСервере(ИдентификаторТекущегоЗапроса);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПереключитьКоллекциюЗапросовНаСервере(Знач НовыйИдентификаторКоллекции, Знач СтарыйИдентификаторКоллекции)
	
	Если НовыйИдентификаторКоллекции = СтарыйИдентификаторКоллекции Тогда
		Возврат ПолучитьДанныеПервоначальногоВыбораПослеСменыКоллекцииНаСервере();
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
		ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
	КонецЕсли;
	
	ЗаписатьДеревоВКоллекциюНаСервере(СтарыйИдентификаторКоллекции);
	
	Если НайтиСтрокуКоллекцииЗапросов(НовыйИдентификаторКоллекции) = Неопределено Тогда
		ВызватьИсключение "Коллекция запросов не найдена";
	КонецЕсли;
	
	ТекущаяКоллекция = НовыйИдентификаторКоллекции;
	ЗагрузитьДеревоИзКоллекцииНаСервере(ТекущаяКоллекция);
	
	Возврат ПолучитьДанныеПервоначальногоВыбораПослеСменыКоллекцииНаСервере();
	
КонецФункции

&НаСервере
Функция ДобавитьКоллекциюЗапросовНаСервере()
	
	Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
		ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
	КонецЕсли;
	
	ЗаписатьДеревоВТекущуюКоллекциюНаСервере();
	
	ТаблицаКоллекций = ТаблицаКоллекцийЗапросов();
	ИдентификаторКоллекции = НовыйИдентификаторКоллекцииЗапросов();
	СтрокаКоллекции = ТаблицаКоллекций.Добавить();
	СтрокаКоллекции.Идентификатор = ИдентификаторКоллекции;
	СтрокаКоллекции.Наименование = ИмяКоллекцииЗапросовПоУмолчанию();
	СтрокаКоллекции.ИспользоватьТаймаутПоУмолчанию = Истина;
	СтрокаКоллекции.Таймаут = 0;
	СтрокаКоллекции.ТипАвторизации = ИдентификаторТипаАвторизацииБезАвторизации();
	СтрокаКоллекции.ПараметрыАвторизации = "";
	СтрокаКоллекции.ДанныеСписка = "";
	
	ЗаписатьТаблицуКоллекцийЗапросов(ТаблицаКоллекций);
	
	ТекущаяКоллекция = ИдентификаторКоллекции;
	ЗагрузитьДеревоИзКоллекцииНаСервере(ТекущаяКоллекция);
	
	Возврат ПолучитьДанныеПервоначальногоВыбораПослеСменыКоллекцииНаСервере();
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеПодтвержденияУдаленияКоллекцииНаСервере(Знач ИдентификаторКоллекции)
	
	Результат = Новый Структура;
	Результат.Вставить("МожноУдалить", Ложь);
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Сообщение", "");
	
	ТаблицаКоллекций = ТаблицаКоллекцийЗапросов();
	
	Если ТаблицаКоллекций.Количество() <= 1 Тогда
		Результат.Сообщение = "Нельзя удалить единственную коллекцию запросов";
		Возврат Результат;
	КонецЕсли;
	
	СтрокаКоллекции = НайтиСтрокуКоллекцииЗапросов(ИдентификаторКоллекции, ТаблицаКоллекций);
	Если СтрокаКоллекции = Неопределено Тогда
		Результат.Сообщение = "Коллекция запросов не найдена";
		Возврат Результат;
	КонецЕсли;
	
	Результат.МожноУдалить = Истина;
	Результат.Наименование = СтрокаКоллекции.Наименование;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция УдалитьКоллекциюЗапросовНаСервере(Знач ИдентификаторУдаляемойКоллекции)
	
	ТаблицаКоллекций = ТаблицаКоллекцийЗапросов();
	
	Если ТаблицаКоллекций.Количество() <= 1 Тогда
		ВызватьИсключение "Нельзя удалить единственную коллекцию запросов";
	КонецЕсли;
	
	СтрокаУдаляемой = НайтиСтрокуКоллекцииЗапросов(ИдентификаторУдаляемойКоллекции, ТаблицаКоллекций);
	Если СтрокаУдаляемой = Неопределено Тогда
		ВызватьИсключение "Коллекция запросов не найдена";
	КонецЕсли;
	
	Если ИдентификаторУдаляемойКоллекции = ОтображаемаяКоллекция Тогда
		Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
			ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
		КонецЕсли;
	Иначе
		ЗаписатьДеревоВКоллекциюНаСервере(ОтображаемаяКоллекция);
	КонецЕсли;
	
	ТаблицаКоллекций.Удалить(СтрокаУдаляемой);
	ЗаписатьТаблицуКоллекцийЗапросов(ТаблицаКоллекций);
	
	Если ИдентификаторУдаляемойКоллекции = ТекущаяКоллекция
		Или ИдентификаторУдаляемойКоллекции = ОтображаемаяКоллекция Тогда
		
		ТекущаяКоллекция = ТаблицаКоллекций[0].Идентификатор;
		ОтображаемаяКоллекция = ТекущаяКоллекция;
		ЗагрузитьДеревоИзКоллекцииНаСервере(ТекущаяКоллекция);
	КонецЕсли;
	
	Возврат ПолучитьДанныеПервоначальногоВыбораПослеСменыКоллекцииНаСервере();
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыТекущейКоллекцииНаСервере()
	
	СтрокаКоллекции = НайтиСтрокуКоллекцииЗапросов(ТекущаяКоллекция);
	Если СтрокаКоллекции = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Наименование", СтрокаКоллекции.Наименование);
	ПараметрыФормы.Вставить("ИспользоватьТаймаутПоУмолчанию", СтрокаКоллекции.ИспользоватьТаймаутПоУмолчанию);
	ПараметрыФормы.Вставить("ТаймаутКоллекции", СтрокаКоллекции.Таймаут);
	ПараметрыФормы.Вставить("ТипАвторизации", ТипАвторизацииКоллекцииЭффективный(СтрокаКоллекции));
	ТаблицаПараметровАвторизации = ТаблицаПараметровАвторизацииИзСтрокиХранилища(
		СтрокаКоллекции.ПараметрыАвторизации);
	МассивПараметровАвторизации = МассивСтруктурПараметровАвторизацииИзТаблицы(ТаблицаПараметровАвторизации);
	ПараметрыФормы.Вставить("ПараметрыАвторизации", МассивПараметровАвторизации);
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаСервере
Процедура ПрименитьНастройкиТекущейКоллекцииНаСервере(Знач Результат)
	
	СтрокаКоллекции = НайтиСтрокуКоллекцииЗапросов(ТекущаяКоллекция);
	Если СтрокаКоллекции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКоллекций = ТаблицаКоллекцийЗапросов();
	ОбеспечитьКолонкиАвторизацииВТаблицеКоллекций(ТаблицаКоллекций);
	СтрокаКоллекции = НайтиСтрокуКоллекцииЗапросов(ТекущаяКоллекция, ТаблицаКоллекций);
	
	СтрокаКоллекции.Наименование = Результат.Наименование;
	СтрокаКоллекции.ИспользоватьТаймаутПоУмолчанию = Результат.ИспользоватьТаймаутПоУмолчанию;
	СтрокаКоллекции.Таймаут = Результат.ТаймаутКоллекции;
	СтрокаКоллекции.ТипАвторизации = Результат.ТипАвторизации;
	СтрокаКоллекции.ПараметрыАвторизации = СериализоватьПараметрыАвторизацииИзЗначения(Результат.ПараметрыАвторизации);
	
	ЗаписатьТаблицуКоллекцийЗапросов(ТаблицаКоллекций);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеСпискаВыбораКоллекцийНаСервере()
	
	Результат = Новый Массив;
	ТаблицаКоллекций = ТаблицаКоллекцийЗапросов();
	
	Для Каждого СтрокаКоллекции Из ТаблицаКоллекций Цикл
		ЭлементСписка = Новый Структура;
		ЭлементСписка.Вставить("Идентификатор", СтрокаКоллекции.Идентификатор);
		ЭлементСписка.Вставить("Наименование", СтрокаКоллекции.Наименование);
		Результат.Добавить(ЭлементСписка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЭффективныйТаймаутДляHTTPЗапросаНаСервере()
	
	СтрокаКоллекции = НайтиСтрокуКоллекцииЗапросов(ТекущаяКоллекция);
	Если СтрокаКоллекции <> Неопределено
		И Не СтрокаКоллекции.ИспользоватьТаймаутПоУмолчанию Тогда
		Возврат СтрокаКоллекции.Таймаут;
	КонецЕсли;
	
	Если Таймаут = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Таймаут;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьКоллекцииЗапросовИзХранилища(Знач КоллекцииЗапросов_ХР, Знач ИдентификаторТекущейКоллекции)
	
	ЗагруженнаяТаблица = ЗначениеИзСтрокиВнутр(КоллекцииЗапросов_ХР);
	Если ТипЗнч(ЗагруженнаяТаблица) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ОбеспечитьКолонкиАвторизацииВТаблицеКоллекций(ЗагруженнаяТаблица);
	ЗаписатьТаблицуКоллекцийЗапросов(ЗагруженнаяТаблица);
	
	Если Не ПустаяСтрока(ИдентификаторТекущейКоллекции) Тогда
		ТекущаяКоллекция = ИдентификаторТекущейКоллекции;
	КонецЕсли;
	
	ЗавершитьВосстановлениеКоллекцийЗапросовНаСервере();
	ЗагрузитьДеревоИзКоллекцииНаСервере(ТекущаяКоллекция);
	
КонецПроцедуры

&НаСервере
Процедура ОбеспечитьКолонкиАвторизацииВТаблицеКоллекций(ТаблицаКоллекций)
	
	Если ТипЗнч(ТаблицаКоллекций) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаКоллекций.Колонки.Найти("ТипАвторизации") = Неопределено Тогда
		ДлинаТипаАвторизации = 64;
		ТаблицаКоллекций.Колонки.Добавить(
			"ТипАвторизации",
			Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(ДлинаТипаАвторизации)));
	КонецЕсли;
	
	Если ТаблицаКоллекций.Колонки.Найти("ПараметрыАвторизации") = Неопределено Тогда
		ТаблицаКоллекций.Колонки.Добавить("ПараметрыАвторизации", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	Для Каждого СтрокаКоллекции Из ТаблицаКоллекций Цикл
		Если ПустаяСтрока(СтрокаКоллекции.ТипАвторизации) Тогда
			СтрокаКоллекции.ТипАвторизации = ИдентификаторТипаАвторизацииБезАвторизации();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ТипАвторизацииКоллекцииЭффективный(Знач СтрокаКоллекции)
	
	Если СтрокаКоллекции = Неопределено Или ПустаяСтрока(СтрокаКоллекции.ТипАвторизации) Тогда
		Возврат ИдентификаторТипаАвторизацииБезАвторизации();
	КонецЕсли;
	
	Возврат СтрокаКоллекции.ТипАвторизации;
	
КонецФункции

#КонецОбласти

#Область НастройкиОбработки

&НаСервере
Функция КлючХраненияКоллекцийЗапросовВНастройках()
	
	Возврат "КоллекцииЗапросов";
	
КонецФункции

&НаСервере
Функция КлючХраненияТекущейКоллекцииВНастройках()
	
	Возврат "ТекущаяКоллекция";
	
КонецФункции

&НаСервере
Функция ИмяРеквизитаСпискаЗапросов()
	
	Возврат "СписокЗапросов";
	
КонецФункции

&НаСервере
Процедура СохранитьНастройкиОбработки(Знач СохранятьСписокЗапросов = Истина)

	Если СохранятьСписокЗапросов Тогда
		ЗавершитьВосстановлениеКоллекцийЗапросовНаСервере();
	КонецЕсли;
	
	Настройки = Новый Соответствие();
	Настройки.Вставить("ВерсияФорматаНастроек", ТекущаяВерсияФорматаНастроекОбработки());
	Настройки.Вставить("Таймаут", Таймаут);
	Настройки.Вставить("АвтосохранениеВключено", АвтосохранениеВключено);
	Настройки.Вставить("ИнтервалАвтосохранения", ИнтервалАвтосохранения);
	Настройки.Вставить("РежимОтправкиПоУмолчанию", РежимОтправкиПоУмолчанию);
	
	Если СохранятьСписокЗапросов Тогда
		
		Если Не ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
			ЗаписатьТекущийЗапросВСписокНаСервере(ИдентификаторТекущегоЗапроса);
		КонецЕсли;
		
		ЗаписатьДеревоВТекущуюКоллекциюНаСервере();
		Настройки.Вставить(КлючХраненияКоллекцийЗапросовВНастройках(), ЗначениеВСтрокуВнутр(ТаблицаКоллекцийЗапросов()));
		Настройки.Вставить(КлючХраненияТекущейКоллекцииВНастройках(), ТекущаяКоллекция);
	Иначе
		СохраненныеКоллекции = ПолучитьСохраненныеКоллекцииЗапросовИзХранилища();
		Если СохраненныеКоллекции <> Неопределено Тогда
			Настройки.Вставить(КлючХраненияКоллекцийЗапросовВНастройках(), СохраненныеКоллекции.КоллекцииЗапросов);
			Настройки.Вставить(КлючХраненияТекущейКоллекцииВНастройках(), СохраненныеКоллекции.ТекущаяКоллекция);
		Иначе
			ЗаписатьДеревоВТекущуюКоллекциюНаСервере();
			Настройки.Вставить(КлючХраненияКоллекцийЗапросовВНастройках(), ЗначениеВСтрокуВнутр(ТаблицаКоллекцийЗапросов()));
			Настройки.Вставить(КлючХраненияТекущейКоллекцииВНастройках(), ТекущаяКоллекция);
		КонецЕсли;
	КонецЕсли;
	
	ХранилищеСистемныхНастроек.Сохранить(КлючХраненияНастроекОбработки(), "Основные", Настройки);

КонецПроцедуры

&НаСервере
Функция ПолучитьСохраненныеКоллекцииЗапросовИзХранилища()
	
	НастройкиФормы = ХранилищеСистемныхНастроек.Загрузить(КлючХраненияНастроекОбработки(), "Основные");
	Если НастройкиФормы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КоллекцииЗапросов_ХР = НастройкиФормы.Получить(КлючХраненияКоллекцийЗапросовВНастройках());
	Если КоллекцииЗапросов_ХР = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить(КлючХраненияКоллекцийЗапросовВНастройках(), КоллекцииЗапросов_ХР);
	Результат.Вставить(
		КлючХраненияТекущейКоллекцииВНастройках(),
		НастройкиФормы.Получить(КлючХраненияТекущейКоллекцииВНастройках()));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ВосстановитьНастройкиОбработки()

	НастройкиФормы = ХранилищеСистемныхНастроек.Загрузить(КлючХраненияНастроекОбработки(), "Основные");
	
	Если НастройкиФормы = Неопределено Тогда
		УстановитьНастройкиПоУмолчанию();
		ЗавершитьВосстановлениеКоллекцийЗапросовНаСервере();
		Возврат;
	КонецЕсли;
	
	СохраненныйТаймаут = НастройкиФормы.Получить("Таймаут");
	Если СохраненныйТаймаут = Неопределено Тогда
		Таймаут = 0;
	Иначе
		Таймаут = СохраненныйТаймаут;
	КонецЕсли;
	
	СохраненноеАвтосохранение = НастройкиФормы.Получить("АвтосохранениеВключено");
	Если СохраненноеАвтосохранение = Неопределено Тогда
		АвтосохранениеВключено = Ложь;
	Иначе
		АвтосохранениеВключено = СохраненноеАвтосохранение;
	КонецЕсли;
	
	СохраненныйИнтервал = НастройкиФормы.Получить("ИнтервалАвтосохранения");
	Если СохраненныйИнтервал = Неопределено Тогда
		ИнтервалАвтосохранения = 30;
	Иначе
		ИнтервалАвтосохранения = СохраненныйИнтервал;
	КонецЕсли;
	
	СохраненныйРежимОтправки = НастройкиФормы.Получить("РежимОтправкиПоУмолчанию");
	Если СохраненныйРежимОтправки = Неопределено Или ПустаяСтрока(СохраненныйРежимОтправки) Тогда
		РежимОтправкиПоУмолчанию = "Клиент";
	Иначе
		РежимОтправкиПоУмолчанию = СохраненныйРежимОтправки;
	КонецЕсли;
	
	ВерсияФормата = НастройкиФормы.Получить("ВерсияФорматаНастроек");
	Если ВерсияФормата <> Неопределено И ВерсияФормата >= ТекущаяВерсияФорматаНастроекОбработки() Тогда
		
		КоллекцииЗапросов_ХР = НастройкиФормы.Получить(КлючХраненияКоллекцийЗапросовВНастройках());
		Если КоллекцииЗапросов_ХР <> Неопределено Тогда
			ИдентификаторСохраненнойКоллекции = НастройкиФормы.Получить(КлючХраненияТекущейКоллекцииВНастройках());
			ЗагрузитьКоллекцииЗапросовИзХранилища(КоллекцииЗапросов_ХР, ИдентификаторСохраненнойКоллекции);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	СписокЗапросов_ХР = НастройкиФормы.Получить(ИмяРеквизитаСпискаЗапросов());
	Если СписокЗапросов_ХР <> Неопределено Тогда
		ЗагрузитьСписокЗапросовИзХранилища(СписокЗапросов_ХР);
		ОбернутьДеревоВЕдинственнуюКоллекциюНаСервере();
		Возврат;
	КонецЕсли;
	
	ЗавершитьВосстановлениеКоллекцийЗапросовНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНастройкиПоУмолчанию()
	
	Таймаут = 0;
	АвтосохранениеВключено = Ложь;
	ИнтервалАвтосохранения = 30;
	РежимОтправкиПоУмолчанию = "Клиент";
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСоСпискомЗапросов

&НаСервере
Функция ДеревоСписокЗапросов()
	
	Возврат РеквизитФормыВЗначение(ИмяРеквизитаСпискаЗапросов());
	
КонецФункции

&НаСервере
Процедура ЗаписатьДеревоСписокЗапросов(Знач ДеревоЗапросов)
	
	ЗначениеВРеквизитФормы(ДеревоЗапросов, ИмяРеквизитаСпискаЗапросов());
	
КонецПроцедуры

&НаСервере
Процедура ОбеспечитьРеквизитСписокЗапросовДеревом()
	
	Список = РеквизитФормыВЗначение(ИмяРеквизитаСпискаЗапросов());
	
	Если ТипЗнч(Список) = Тип("ТаблицаЗначений") Тогда
		ЗагрузитьСписокЗапросовИзПлоскойТаблицы(Список);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбеспечитьМинимумОдинЗапросНаСервере(Знач ОчищатьФормуПриСоздании = Ложь)
	
	Если КоличествоЗапросовВДереве() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьЗапросВСписокНаСервере("", Ложь, ОчищатьФормуПриСоздании);
	
КонецПроцедуры

&НаСервере
Функция ИнициализироватьСписокЗапросовПослеОткрытияНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗапроса", "");
	Результат.Вставить("ИдентификаторСтрокиСписка", "");
	Результат.Вставить("ЭтоГруппа", Ложь);
	
	ОбеспечитьРеквизитСписокЗапросовДеревом();
	ОбеспечитьМинимумОдинЗапросНаСервере(Истина);
	НормализоватьСтруктуруСпискаЗапросовПослеИзмененияНаСервере();
	
	ДанныеВыбора = ПолучитьДанныеПервоначальногоВыбораСпискаНаСервере();
	Результат.ИдентификаторЗапроса = ДанныеВыбора.ИдентификаторЗапроса;
	Результат.ИдентификаторСтрокиСписка = ДанныеВыбора.ИдентификаторСтрокиСписка;
	Результат.ЭтоГруппа = ДанныеВыбора.ЭтоГруппа;
	
	ИдентификаторТекущегоЗапроса = ДанныеВыбора.ИдентификаторЗапроса;
	
	Если ПустаяСтрока(ИдентификаторТекущегоЗапроса) Тогда
		ОчиститьРеквизитыТекущегоЗапроса();
	ИначеЕсли ДанныеВыбора.ЭтоГруппа Тогда
		ЗагрузитьАвторизациюЭлементаИзСпискаНаСервере(ИдентификаторТекущегоЗапроса);
	Иначе
		ЗагрузитьЗапросИзСпискаНаСервере(ИдентификаторТекущегоЗапроса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьСписокЗапросовИзХранилища(Знач СписокЗапросов_ХР)
	
	ЗагруженноеЗначение = ЗначениеИзСтрокиВнутр(СписокЗапросов_ХР);
	
	Если ТипЗнч(ЗагруженноеЗначение) = Тип("ДеревоЗначений") Тогда
		ЗначениеВРеквизитФормы(ЗагруженноеЗначение, ИмяРеквизитаСпискаЗапросов());
	КонецЕсли;
	
	Если ТипЗнч(ЗагруженноеЗначение) = Тип("ТаблицаЗначений") Тогда
		ЗагрузитьСписокЗапросовИзПлоскойТаблицы(ЗагруженноеЗначение);
	КонецЕсли;
	
	НормализоватьСписокЗапросовПослеЗагрузки();
	ОбеспечитьМинимумОдинЗапросНаСервере(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокЗапросовИзПлоскойТаблицы(Знач ТаблицаЗапросов)
	
	Дерево = ДеревоСписокЗапросов();
	Дерево.Строки.Очистить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗапросов Цикл
		НоваяСтрока = Дерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, , "Картинка");
		НоваяСтрока.ЭтоГруппа = Ложь;
		УстановитьКартинкуСтрокиСписка(НоваяСтрока);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, ИмяРеквизитаСпискаЗапросов());
	
КонецПроцедуры

&НаСервере
Процедура НормализоватьСписокЗапросовПослеЗагрузки()
	
	Дерево = ДеревоСписокЗапросов();
	ОбновитьКартинкиИСоставСтрокСпискаЗапросов(Дерево.Строки);
	ЗаписатьДеревоСписокЗапросов(Дерево);
	НормализоватьСтруктуруЭлементовДанныхФормыСписка(СписокЗапросов.ПолучитьЭлементы());
	
КонецПроцедуры

&НаСервере
Процедура НормализоватьСтруктуруСпискаЗапросовПослеИзмененияНаСервере()
	
	ИсправитьНедопустимуюВложенностьВДанныхФормыСписка(СписокЗапросов.ПолучитьЭлементы());
	НормализоватьСтруктуруЭлементовДанныхФормыСписка(СписокЗапросов.ПолучитьЭлементы());
	
КонецПроцедуры

&НаСервере
Процедура ИсправитьНедопустимуюВложенностьВДанныхФормыСписка(ЭлементыДерева)
	
	Для Каждого ЭлементСтроки Из ЭлементыДерева Цикл
		
		Пока Не ЭлементСтроки.ЭтоГруппа И ЭлементСтроки.ПолучитьЭлементы().Количество() > 0 Цикл
			ВынестиПодчиненныйЭлементЗапросаВДанныхФормы(ЭлементСтроки);
		КонецЦикла;
		
		ИсправитьНедопустимуюВложенностьВДанныхФормыСписка(ЭлементСтроки.ПолучитьЭлементы());
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВынестиПодчиненныйЭлементЗапросаВДанныхФормы(ЭлементЗапроса)
	
	Подчиненные = ЭлементЗапроса.ПолучитьЭлементы();
	Если Подчиненные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПодчиненныйЭлемент = Подчиненные.Получить(0);
	Родитель = ЭлементЗапроса.ПолучитьРодителя();
	
	Если Родитель = Неопределено Тогда
		КоллекцияРодителя = СписокЗапросов.ПолучитьЭлементы();
	Иначе
		КоллекцияРодителя = Родитель.ПолучитьЭлементы();
	КонецЕсли;
	
	ИндексЗапроса = ИндексЭлементаДанныхФормыВКоллекции(КоллекцияРодителя, ЭлементЗапроса);
	Если ИндексЗапроса < 0 Тогда
		Возврат;
	КонецЕсли;
	
	НовыйЭлемент = КоллекцияРодителя.Вставить(ИндексЗапроса + 1);
	СкопироватьЭлементДанныхФормыСписка(ПодчиненныйЭлемент, НовыйЭлемент);
	Подчиненные.Удалить(ПодчиненныйЭлемент);
	
КонецПроцедуры

&НаСервере
Процедура СкопироватьЭлементДанныхФормыСписка(Источник, Приемник)
	
	ЗаполнитьЗначенияСвойств(Приемник, Источник);
	УстановитьКартинкуЭлементаДанныхФормыСписка(Приемник);
	
	Пока Источник.ПолучитьЭлементы().Количество() > 0 Цикл
		ПодчиненныйИсточник = Источник.ПолучитьЭлементы().Получить(0);
		ПодчиненныйПриемник = Приемник.ПолучитьЭлементы().Добавить();
		СкопироватьЭлементДанныхФормыСписка(ПодчиненныйИсточник, ПодчиненныйПриемник);
		Источник.ПолучитьЭлементы().Удалить(ПодчиненныйИсточник);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ИндексЭлементаДанныхФормыВКоллекции(КоллекцияЭлементов, ЭлементСтроки)
	
	Индекс = 0;
	Для Каждого ЭлементКоллекции Из КоллекцияЭлементов Цикл
		Если ЭлементКоллекции = ЭлементСтроки Тогда
			Возврат Индекс;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат -1;
	
КонецФункции

&НаСервере
Процедура НормализоватьСтруктуруЭлементовДанныхФормыСписка(ЭлементыДерева)
	
	Для Каждого ЭлементСтроки Из ЭлементыДерева Цикл
		
		Подчиненные = ЭлементСтроки.ПолучитьЭлементы();
		НормализоватьЭлементДанныхФормыСписка(ЭлементСтроки);
		НормализоватьСтруктуруЭлементовДанныхФормыСписка(Подчиненные);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НормализоватьЭлементДанныхФормыСписка(ЭлементСтроки)
	
	Если ЭлементСтроки.ДанныеЗапроса = Неопределено Тогда
		ЭлементСтроки.ДанныеЗапроса = "";
	КонецЕсли;
	
	Если ПустаяСтрока(ЭлементСтроки.Идентификатор) Тогда
		ЭлементСтроки.Идентификатор = XMLСтрока(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	УстановитьКартинкуЭлементаДанныхФормыСписка(ЭлементСтроки);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКартинкуЭлементаДанныхФормыСписка(ЭлементСтроки)
	
	Если ЭлементСтроки.ЭтоГруппа Тогда
		ЭлементСтроки.Картинка = БиблиотекаКартинок.Папка;
	Иначе
		ЭлементСтроки.Картинка = БиблиотекаКартинок.Документ;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиЭлементДанныхФормыСпискаЗапросов(Знач ИдентификаторСтроки, Знач ЭлементыДерева = Неопределено)
	
	Если ПустаяСтрока(ИдентификаторСтроки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭлементыДерева = Неопределено Тогда
		ЭлементыДерева = СписокЗапросов.ПолучитьЭлементы();
	КонецЕсли;
	
	Для Каждого ЭлементСтроки Из ЭлементыДерева Цикл
		
		Если ЭлементСтроки.Идентификатор = ИдентификаторСтроки Тогда
			Возврат ЭлементСтроки;
		КонецЕсли;
		
		НайденныйЭлемент = НайтиЭлементДанныхФормыСпискаЗапросов(
			ИдентификаторСтроки,
			ЭлементСтроки.ПолучитьЭлементы());
		Если НайденныйЭлемент <> Неопределено Тогда
			Возврат НайденныйЭлемент;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция УдалитьЭлементДанныхФормыСпискаЗапросовПоИдентификатору(
	Знач ИдентификаторСтроки,
	Знач КоллекцияЭлементов = Неопределено)
	
	Если КоллекцияЭлементов = Неопределено Тогда
		КоллекцияЭлементов = СписокЗапросов.ПолучитьЭлементы();
	КонецЕсли;
	
	ЭлементДляУдаления = Неопределено;
	
	Для Каждого ЭлементСтроки Из КоллекцияЭлементов Цикл
		
		Если ЭлементСтроки.Идентификатор = ИдентификаторСтроки Тогда
			ЭлементДляУдаления = ЭлементСтроки;
			Прервать;
		КонецЕсли;
		
		Если УдалитьЭлементДанныхФормыСпискаЗапросовПоИдентификатору(
			ИдентификаторСтроки,
			ЭлементСтроки.ПолучитьЭлементы()) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЭлементДляУдаления <> Неопределено Тогда
		КоллекцияЭлементов.Удалить(ЭлементДляУдаления);
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ОбновитьКартинкиИСоставСтрокСпискаЗапросов(КоллекцияСтрок)
	
	Для Каждого СтрокаСписка Из КоллекцияСтрок Цикл
		НормализоватьСтрокуСпискаЗапросов(СтрокаСписка);
		ОбновитьКартинкиИСоставСтрокСпискаЗапросов(СтрокаСписка.Строки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НормализоватьСтрокуСпискаЗапросов(СтрокаСписка)
	
	Если Не СтрокаСписка.ЭтоГруппа Тогда
		СтрокаСписка.ЭтоГруппа = Ложь;
	КонецЕсли;
	
	Если СтрокаСписка.ДанныеЗапроса = Неопределено Тогда
		СтрокаСписка.ДанныеЗапроса = "";
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаСписка.Идентификатор) Тогда
		СтрокаСписка.Идентификатор = XMLСтрока(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	УстановитьКартинкуСтрокиСписка(СтрокаСписка);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКартинкуСтрокиСписка(СтрокаСписка)
	
	Если СтрокаСписка.ЭтоГруппа Тогда
		СтрокаСписка.Картинка = БиблиотекаКартинок.Папка;
	Иначе
		СтрокаСписка.Картинка = БиблиотекаКартинок.Документ;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПервоначальногоВыбораСпискаНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗапроса", "");
	Результат.Вставить("ИдентификаторСтрокиСписка", "");
	Результат.Вставить("ЭтоГруппа", Ложь);
	
	ИдентификаторЗапроса = НайтиПервыйЗапросВДереве();
	Если Не ПустаяСтрока(ИдентификаторЗапроса) Тогда
		Результат.ИдентификаторЗапроса = ИдентификаторЗапроса;
		Результат.ИдентификаторСтрокиСписка = ИдентификаторЗапроса;
		Возврат Результат;
	КонецЕсли;
	
	ПерваяСтрока = НайтиПервуюСтрокуВДереве();
	Если ПерваяСтрока <> Неопределено Тогда
		Результат.ИдентификаторЗапроса = ПерваяСтрока.Идентификатор;
		Результат.ИдентификаторСтрокиСписка = ПерваяСтрока.Идентификатор;
		Результат.ЭтоГруппа = ПерваяСтрока.ЭтоГруппа;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НайтиИдентификаторСтрокиСпискаЗапросовНаСервере(Знач ИдентификаторСтрокиСписка)
	
	Возврат НайтиИдентификаторЭлементаДанныхФормыДерева(
		СписокЗапросов.ПолучитьЭлементы(),
		ИдентификаторСтрокиСписка);
	
КонецФункции

&НаСервере
Функция НайтиИдентификаторЭлементаДанныхФормыДерева(ЭлементыДерева, Знач ИдентификаторСтрокиСписка)
	
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		
		Если ЭлементДерева.Идентификатор = ИдентификаторСтрокиСписка Тогда
			Возврат ЭлементДерева.ПолучитьИдентификатор();
		КонецЕсли;
		
		НайденныйИдентификатор = НайтиИдентификаторЭлементаДанныхФормыДерева(
			ЭлементДерева.ПолучитьЭлементы(),
			ИдентификаторСтрокиСписка);
		Если НайденныйИдентификатор <> Неопределено Тогда
			Возврат НайденныйИдентификатор;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ЗаписатьТекущийЭлементВСписокНаСервере(Знач ИдентификаторЭлемента)
	
	Если ПустаяСтрока(ИдентификаторЭлемента) Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементСтроки = НайтиЭлементДанныхФормыСпискаЗапросов(ИдентификаторЭлемента);
	Если ЭлементСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭлементСтроки.ЭтоГруппа Тогда
		ЭлементСтроки.ДанныеЗапроса = ЗначениеВСтрокуВнутр(СобратьДанныеАвторизацииТекущегоЭлемента());
		Возврат;
	КонецЕсли;
	
	НормализоватьURIИПараметрыЗапросаНаСервере();
	ЭлементСтроки.ДанныеЗапроса = ЗначениеВСтрокуВнутр(СобратьДанныеТекущегоЗапроса());
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьТекущийЗапросВСписокНаСервере(Знач ИдентификаторЗапроса)
	
	ЗаписатьТекущийЭлементВСписокНаСервере(ИдентификаторЗапроса);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьАвторизациюЭлементаИзСпискаНаСервере(Знач ИдентификаторЭлемента)
	
	ОчиститьРеквизитыТекущегоЗапроса();
	
	ЭлементСтроки = НайтиЭлементДанныхФормыСпискаЗапросов(ИдентификаторЭлемента);
	Если ЭлементСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьАвторизациюИзДанныхЗапросаСтроки(ЭлементСтроки.ДанныеЗапроса);
	ПерестроитьПараметрыАвторизацииПоСхемеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЗапросИзСпискаНаСервере(Знач ИдентификаторЗапроса)
	
	ЭлементСтроки = НайтиЭлементДанныхФормыСпискаЗапросов(ИдентификаторЗапроса);
	Если ЭлементСтроки = Неопределено Или ЭлементСтроки.ЭтоГруппа Тогда
		ОчиститьРеквизитыТекущегоЗапроса();
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ЭлементСтроки.ДанныеЗапроса) Тогда
		ОчиститьРеквизитыТекущегоЗапроса();
		Возврат;
	КонецЕсли;
	
	ДанныеЗапроса = ЗначениеИзСтрокиВнутр(ЭлементСтроки.ДанныеЗапроса);
	ЗаполнитьРеквизитыИзДанныхЗапроса(ДанныеЗапроса);
	
КонецПроцедуры

&НаСервере
Функция ДобавитьПапкуВСписокНаСервере(Знач ИдентификаторТекущейСтроки, Знач ТекущаяСтрокаЭтоГруппа)
	
	Дерево = ДеревоСписокЗапросов();
	РодительскаяСтрока = ОпределитьРодителяПриДобавлении(
		ИдентификаторТекущейСтроки, ТекущаяСтрокаЭтоГруппа, Истина, Дерево);
	НомерПапки = КоличествоПапокВДереве(Дерево.Строки) + 1;
	НоваяСтрока = ДобавитьСтрокуСпискаЗапросов(Дерево, РодительскаяСтрока);
	
	НоваяСтрока.Идентификатор = XMLСтрока(Новый УникальныйИдентификатор);
	НоваяСтрока.ЭтоГруппа = Истина;
	НоваяСтрока.ДанныеЗапроса = ЗначениеВСтрокуВнутр(НовыеДанныеАвторизацииПоУмолчаниюДляЭлемента());
	НоваяСтрока.Наименование = "Папка " + Формат(НомерПапки, "ЧГ=0");
	УстановитьКартинкуСтрокиСписка(НоваяСтрока);
	ЗаписатьДеревоСписокЗапросов(Дерево);
	
	Возврат НоваяСтрока.Идентификатор;
	
КонецФункции

&НаСервере
Функция ДобавитьЗапросВСписокНаСервере(
	Знач ИдентификаторТекущейСтроки,
	Знач ТекущаяСтрокаЭтоГруппа,
	Знач ОчищатьФорму = Истина)
	
	Дерево = ДеревоСписокЗапросов();
	РодительскаяСтрока = ОпределитьРодителяПриДобавлении(
		ИдентификаторТекущейСтроки, ТекущаяСтрокаЭтоГруппа, Ложь, Дерево);
	НомерЗапроса = КоличествоЗапросовВДереве(Дерево.Строки) + 1;
	НоваяСтрока = ДобавитьСтрокуСпискаЗапросов(Дерево, РодительскаяСтрока);
	
	НоваяСтрока.Идентификатор = XMLСтрока(Новый УникальныйИдентификатор);
	НоваяСтрока.ЭтоГруппа = Ложь;
	НоваяСтрока.Наименование = "Запрос " + Формат(НомерЗапроса, "ЧГ=0");
	
	Если ОчищатьФорму Тогда
		ОчиститьРеквизитыТекущегоЗапроса();
	КонецЕсли;
	
	НоваяСтрока.ДанныеЗапроса = ЗначениеВСтрокуВнутр(СобратьДанныеТекущегоЗапроса());
	УстановитьКартинкуСтрокиСписка(НоваяСтрока);
	ЗаписатьДеревоСписокЗапросов(Дерево);
	
	Возврат НоваяСтрока.Идентификатор;
	
КонецФункции

&НаСервере
Функция СкопироватьЭлементСпискаЗапросовНаСервере(Знач ИдентификаторИсходнойСтроки)
	
	Дерево = ДеревоСписокЗапросов();
	ИсходнаяСтрока = НайтиСтрокуСпискаЗапросов(ИдентификаторИсходнойСтроки, Дерево.Строки);
	Если ИсходнаяСтрока = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	КоллекцияРодителя = ПолучитьКоллекциюСтрокСпискаЗапросов(Дерево, ИсходнаяСтрока);
	ИндексИсходнойСтроки = КоллекцияРодителя.Индекс(ИсходнаяСтрока);
	НоваяСтрока = КоллекцияРодителя.Вставить(ИндексИсходнойСтроки + 1);
	
	СкопироватьСтрокуСпискаЗапросов(ИсходнаяСтрока, НоваяСтрока, Дерево);
	ЗаписатьДеревоСписокЗапросов(Дерево);
	
	Возврат НоваяСтрока.Идентификатор;
	
КонецФункции

&НаСервере
Процедура СкопироватьСтрокуСпискаЗапросов(ИсходнаяСтрока, НоваяСтрока, Знач Дерево)
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрока, , "Строки");
	НоваяСтрока.Идентификатор = XMLСтрока(Новый УникальныйИдентификатор);
	
	Если ИсходнаяСтрока.ЭтоГруппа Тогда
		НоваяСтрока.Наименование = ИсходнаяСтрока.Наименование + " (копия)";
	Иначе
		НоваяСтрока.Наименование = СформироватьИмяКопииЗапроса(ИсходнаяСтрока.Наименование);
	КонецЕсли;
	
	УстановитьКартинкуСтрокиСписка(НоваяСтрока);
	
	Для Каждого ПодчиненнаяСтрока Из ИсходнаяСтрока.Строки Цикл
		НоваяПодчиненнаяСтрока = НоваяСтрока.Строки.Добавить();
		СкопироватьСтрокуСпискаЗапросов(ПодчиненнаяСтрока, НоваяПодчиненнаяСтрока, Дерево);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СформироватьИмяКопииЗапроса(Знач ИсходноеНаименование)
	
	Если ПустаяСтрока(ИсходноеНаименование) Тогда
		Возврат "Запрос (копия)";
	КонецЕсли;
	
	Возврат ИсходноеНаименование + " (копия)";
	
КонецФункции

&НаСервере
Функция УдалитьЭлементИзСпискаНаСервере(Знач ИдентификаторСтрокиСписка)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗапроса", "");
	Результат.Вставить("ИдентификаторСтрокиСписка", "");
	Результат.Вставить("ЭтоГруппа", Ложь);
	
	Если УдалитьЭлементДанныхФормыСпискаЗапросовПоИдентификатору(ИдентификаторСтрокиСписка) Тогда
		Возврат ЗаполнитьРезультатПослеУдаленияИзСписка(Результат);
	КонецЕсли;
	
	Дерево = ДеревоСписокЗапросов();
	СтрокаСписка = НайтиСтрокуСпискаЗапросов(ИдентификаторСтрокиСписка, Дерево.Строки);
	Если СтрокаСписка = Неопределено Тогда
		Возврат ЗаполнитьРезультатПослеУдаленияИзСписка(Результат);
	КонецЕсли;
	
	КоллекцияСтрок = ПолучитьКоллекциюСтрокСпискаЗапросов(Дерево, СтрокаСписка);
	КоллекцияСтрок.Удалить(СтрокаСписка);
	ЗаписатьДеревоСписокЗапросов(Дерево);
	
	Возврат ЗаполнитьРезультатПослеУдаленияИзСписка(Результат);
	
КонецФункции

&НаСервере
Функция ЗаполнитьРезультатПослеУдаленияИзСписка(Результат)
	
	Если КоличествоЗапросовВДереве() = 0 Тогда
		ИдентификаторЗапроса = ДобавитьЗапросВСписокНаСервере("", Ложь, Истина);
		Результат.ИдентификаторЗапроса = ИдентификаторЗапроса;
		Результат.ИдентификаторСтрокиСписка = ИдентификаторЗапроса;
		Возврат Результат;
	КонецЕсли;
	
	ИдентификаторЗапроса = НайтиПервыйЗапросВДереве();
	Если Не ПустаяСтрока(ИдентификаторЗапроса) Тогда
		Результат.ИдентификаторЗапроса = ИдентификаторЗапроса;
		Результат.ИдентификаторСтрокиСписка = ИдентификаторЗапроса;
		Возврат Результат;
	КонецЕсли;
	
	ПерваяСтрока = НайтиПервуюСтрокуВДереве();
	Если ПерваяСтрока <> Неопределено Тогда
		Результат.ИдентификаторЗапроса = ПерваяСтрока.Идентификатор;
		Результат.ИдентификаторСтрокиСписка = ПерваяСтрока.Идентификатор;
		Результат.ЭтоГруппа = ПерваяСтрока.ЭтоГруппа;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОпределитьРодителяПриДобавлении(
	Знач ИдентификаторТекущейСтроки,
	Знач ТекущаяСтрокаЭтоГруппа,
	Знач ДобавляемПапку,
	Знач Дерево)
	
	Если ПустаяСтрока(ИдентификаторТекущейСтроки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекущаяСтрока = НайтиСтрокуСпискаЗапросов(ИдентификаторТекущейСтроки, Дерево.Строки);
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДобавляемПапку Тогда
		Если ТекущаяСтрокаЭтоГруппа Тогда
			Возврат ТекущаяСтрока;
		КонецЕсли;
		Возврат ТекущаяСтрока.Родитель;
	КонецЕсли;
	
	Если ТекущаяСтрокаЭтоГруппа Тогда
		Возврат ТекущаяСтрока;
	КонецЕсли;
	
	Возврат ТекущаяСтрока.Родитель;
	
КонецФункции

&НаСервере
Функция ДобавитьСтрокуСпискаЗапросов(Знач Дерево, Знач РодительскаяСтрока)
	
	Если РодительскаяСтрока = Неопределено Тогда
		Возврат Дерево.Строки.Добавить();
	КонецЕсли;
	
	Возврат РодительскаяСтрока.Строки.Добавить();
	
КонецФункции

&НаСервере
Функция ПолучитьКоллекциюСтрокСпискаЗапросов(Знач Дерево, Знач СтрокаСписка)
	
	Если СтрокаСписка.Родитель = Неопределено Тогда
		Возврат Дерево.Строки;
	КонецЕсли;
	
	Возврат СтрокаСписка.Родитель.Строки;
	
КонецФункции

&НаСервере
Функция НайтиСтрокуСпискаЗапросов(Знач ИдентификаторСтрокиСписка, Знач КоллекцияСтрок = Неопределено)
	
	Если ПустаяСтрока(ИдентификаторСтрокиСписка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если КоллекцияСтрок = Неопределено Тогда
		КоллекцияСтрок = ДеревоСписокЗапросов().Строки;
	КонецЕсли;
	
	Для Каждого СтрокаСписка Из КоллекцияСтрок Цикл
		
		Если СтрокаСписка.Идентификатор = ИдентификаторСтрокиСписка Тогда
			Возврат СтрокаСписка;
		КонецЕсли;
		
		НайденнаяСтрока = НайтиСтрокуСпискаЗапросов(ИдентификаторСтрокиСписка, СтрокаСписка.Строки);
		Если НайденнаяСтрока <> Неопределено Тогда
			Возврат НайденнаяСтрока;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция НайтиПервыйЗапросВДереве(Знач КоллекцияСтрок = Неопределено)
	
	Если КоллекцияСтрок = Неопределено Тогда
		КоллекцияСтрок = ДеревоСписокЗапросов().Строки;
	КонецЕсли;
	
	Для Каждого СтрокаСписка Из КоллекцияСтрок Цикл
		
		Если Не СтрокаСписка.ЭтоГруппа Тогда
			Возврат СтрокаСписка.Идентификатор;
		КонецЕсли;
		
		ИдентификаторЗапроса = НайтиПервыйЗапросВДереве(СтрокаСписка.Строки);
		Если Не ПустаяСтрока(ИдентификаторЗапроса) Тогда
			Возврат ИдентификаторЗапроса;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция НайтиПервуюСтрокуВДереве(Знач КоллекцияСтрок = Неопределено)
	
	Если КоллекцияСтрок = Неопределено Тогда
		КоллекцияСтрок = ДеревоСписокЗапросов().Строки;
	КонецЕсли;
	
	Если КоллекцияСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат КоллекцияСтрок[0];
	
КонецФункции

&НаСервере
Функция КоличествоЗапросовВДереве(Знач КоллекцияСтрок = Неопределено)
	
	Если КоллекцияСтрок = Неопределено Тогда
		КоллекцияСтрок = ДеревоСписокЗапросов().Строки;
	КонецЕсли;
	
	Количество = 0;
	
	Для Каждого СтрокаСписка Из КоллекцияСтрок Цикл
		
		Если Не СтрокаСписка.ЭтоГруппа Тогда
			Количество = Количество + 1;
		КонецЕсли;
		
		Количество = Количество + КоличествоЗапросовВДереве(СтрокаСписка.Строки);
		
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

