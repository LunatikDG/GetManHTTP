&НаКлиенте
Процедура ВывестиСообщениеПользователю(ТекстСообщения)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Таймаут = Результат.Таймаут;
	АвтосохранениеВключено = Результат.АвтосохранениеВключено;
	ИнтервалАвтосохранения = Результат.ИнтервалАвтосохранения;
	РежимОтправкиПоУмолчанию = Результат.РежимОтправкиПоУмолчанию;
	
	ПодключитьАвтосохранениеНастроек();
	СохранитьНастройкиОбработки(АвтосохранениеВключено);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиКоллекцииЗапросовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПрименитьНастройкиТекущейКоллекцииНаСервере(Результат);
	ОбновитьСписокВыбораКоллекцийНаКлиенте();
	СохранитьНастройкиОбработки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокВыбораКоллекцийНаКлиенте()
	
	ДанныеСписка = ПолучитьДанныеСпискаВыбораКоллекцийНаСервере();
	Элементы.КоллекцияЗапросов.СписокВыбора.Очистить();
	
	Для Каждого ЭлементСписка Из ДанныеСписка Цикл
		Элементы.КоллекцияЗапросов.СписокВыбора.Добавить(
			ЭлементСписка.Идентификатор,
			ЭлементСписка.Наименование);
	КонецЦикла;
	
	Элементы.КнопкаУдалитьКоллекциюЗапросов.Доступность = ДанныеСписка.Количество() > 1;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьПереключениеКоллекцииНаКлиенте(ДанныеПереключения)
	
	ИдентификаторТекущегоЗапроса = ДанныеПереключения.ИдентификаторЗапроса;
	УстановитьТекущуюСтрокуСпискаЗапросов(ДанныеПереключения.ИдентификаторСтрокиСписка);
	
	Если ДанныеПереключения.ЭтоГруппа Тогда
		ЗагрузитьАвторизациюЭлементаИзСпискаНаСервере(ДанныеПереключения.ИдентификаторЗапроса);
		УстановитьРежимОбластиЗапроса("ТолькоАвторизация");
		ОтобразитьПоляАвторизацииПоСхеме();
	Иначе
		УстановитьДоступностьОбластиЗапроса(Истина);
		ОбновитьОтображениеФормыЗапроса();
	КонецЕсли;
	
	НастроитьКоманднуюПанельСпискаЗапросов();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКоллекциюЗапросовЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторУдаляемой = ДополнительныеПараметры.ИдентификаторКоллекции;
	
	ИдетПереключениеКоллекции = Истина;
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		ДанныеПереключения = УдалитьКоллекциюЗапросовНаСервере(ИдентификаторУдаляемой);
		ТекущаяКоллекция = ДанныеПереключения.ИдентификаторКоллекции;
		ОтображаемаяКоллекция = ТекущаяКоллекция;
		ПрименитьПереключениеКоллекцииНаКлиенте(ДанныеПереключения);
	Исключение
		ИдетПереключениеКоллекции = Ложь;
		ИдетПереключениеЗапроса = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	ИдетПереключениеКоллекции = Ложь;
	ИдетПереключениеЗапроса = Ложь;
	ОбновитьСписокВыбораКоллекцийНаКлиенте();
	СохранитьНастройкиОбработки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьНастройкиОбработки(Истина);
	КонецЕсли;
	
	ЗакрытиеПодтверждено = Истина;
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлЗавершение(ВыбранныеФайлы, Параметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		ВывестиСообщениеПользователю("Не выбрано ни одного файла");
		Возврат;
	КонецЕсли;
	
	ПутьКФайлуВх = ВыбранныеФайлы[0];
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтветВФайлЗавершение(ВыбранныеФайлы, Параметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = ВыбранныеФайлы[0];
	
	#Если НЕ ВебКлиент Тогда
		ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
		ЗаписьТекста.Записать(ЗапросОтвет);
		ЗаписьТекста.Закрыть();
		ВывестиСообщениеПользователю("Ответ сохранен в файл: " + ПутьКФайлу);
	#Иначе
		ВывестиСообщениеПользователю("Сохранение в файл недоступно в веб-клиенте");
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ЭкспортироватьТекущуюКоллекциюВФайл(Знач ФорматЭкспорта = Неопределено) Экспорт
	
	#Если ВебКлиент Тогда
		ВывестиСообщениеПользователю("Экспорт коллекции недоступен в веб-клиенте");
		Возврат;
	#КонецЕсли
	
	Если ФорматЭкспорта = Неопределено Или ПустаяСтрока(ФорматЭкспорта) Тогда
		ОткрытьДиалогЭкспортаТекущейКоллекцииСВыборомФормата();
	Иначе
		ОткрытьДиалогЭкспортаТекущейКоллекции(ФорматЭкспорта);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДиалогЭкспортаТекущейКоллекцииСВыборомФормата()
	
	ИмяПоУмолчанию = ИмяФайлаЭкспортаТекущейКоллекцииПоУмолчанию();
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Экспорт коллекции";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр =
		"GetManHTTP (*.json)|*.json|Postman Collection v2.1 (*.postman_collection.json)|*.postman_collection.json";
	Диалог.ИндексФильтра = 0;
	Диалог.Расширение = "json";
	Диалог.ПолноеИмяФайла = ИмяПоУмолчанию;
	ОповещениеЭкспорта = Новый ОписаниеОповещения(
		"ЭкспортироватьТекущуюКоллекциюВФайлЗавершениеСАвтоФорматом",
		ЭтотОбъект);
	Диалог.Показать(ОповещениеЭкспорта);
	
КонецПроцедуры

&НаКлиенте
Процедура ЭкспортироватьТекущуюКоллекциюВФайлЗавершениеСАвтоФорматом(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = ВыбранныеФайлы[0];
	ФорматЭкспорта = ОпределитьФорматЭкспортаКоллекцииПоИмениФайла(ПутьКФайлу);
	ЗаписатьЭкспортКоллекцииВФайл(ПутьКФайлу, ФорматЭкспорта);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДиалогЭкспортаТекущейКоллекции(Знач ФорматЭкспорта)
	
	ИмяПоУмолчанию = ИмяФайлаЭкспортаТекущейКоллекцииПоУмолчанию();
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Экспорт коллекции";
	Диалог.МножественныйВыбор = Ложь;
	
	Если ФорматЭкспорта = ИдентификаторФорматаЭкспортаPostman() Тогда
		Диалог.Фильтр = "Postman Collection v2.1 (*.postman_collection.json)|*.postman_collection.json";
		Диалог.Расширение = "postman_collection.json";
		Если СтрНайти(НРег(ИмяПоУмолчанию), ".postman_collection.json") = 0 Тогда
			ИмяПоУмолчанию = СтрЗаменить(ИмяПоУмолчанию, ".json", "") + ".postman_collection.json";
		КонецЕсли;
	Иначе
		Диалог.Фильтр = "GetManHTTP (*.json)|*.json";
		Диалог.Расширение = "json";
	КонецЕсли;
	
	Диалог.ПолноеИмяФайла = ИмяПоУмолчанию;
	ПараметрыОповещения = Новый Структура("ФорматЭкспорта", ФорматЭкспорта);
	ОповещениеЭкспорта = Новый ОписаниеОповещения(
		"ЭкспортироватьТекущуюКоллекциюВФайлЗавершение",
		ЭтотОбъект,
		ПараметрыОповещения);
	Диалог.Показать(ОповещениеЭкспорта);
	
КонецПроцедуры

&НаКлиенте
Процедура ЭкспортироватьТекущуюКоллекциюВФайлЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьЭкспортКоллекцииВФайл(ВыбранныеФайлы[0], ДополнительныеПараметры.ФорматЭкспорта);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЭкспортКоллекцииВФайл(Знач ПутьКФайлу, Знач ФорматЭкспорта)
	
	Попытка
		ТекстJSON = СформироватьТекстЭкспортаТекущейКоллекцииНаСервере(ФорматЭкспорта);
	Исключение
		ВывестиСообщениеПользователю("Не удалось экспортировать коллекцию: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	#Если НЕ ВебКлиент Тогда
		ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
		ЗаписьТекста.Записать(ТекстJSON);
		ЗаписьТекста.Закрыть();
		ВывестиСообщениеПользователю("Коллекция экспортирована: " + ПутьКФайлу);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Функция ОпределитьФорматЭкспортаКоллекцииПоИмениФайла(Знач ПутьКФайлу)
	
	Если СтрНайти(НРег(ПутьКФайлу), ".postman_collection.json") > 0 Тогда
		Возврат ИдентификаторФорматаЭкспортаPostman();
	КонецЕсли;
	
	Возврат ИдентификаторФорматаЭкспортаGetManHTTP();
	
КонецФункции

&НаКлиенте
Процедура ИмпортироватьКоллекциюИзФайла() Экспорт
	
	#Если ВебКлиент Тогда
		ВывестиСообщениеПользователю("Импорт коллекции недоступен в веб-клиенте");
		Возврат;
	#КонецЕсли
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Импорт коллекции";
	Диалог.Фильтр =
		"Коллекции JSON (*.json;*.postman_collection.json)|*.json;*.postman_collection.json|"
		+ "Все файлы (*.*)|*.*";
	Диалог.МножественныйВыбор = Ложь;
	ОповещениеИмпорта = Новый ОписаниеОповещения("ИмпортироватьКоллекциюИзФайлаЗавершение", ЭтотОбъект);
	Диалог.Показать(ОповещениеИмпорта);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортироватьКоллекциюИзФайлаЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = ВыбранныеФайлы[0];
	
	#Если НЕ ВебКлиент Тогда
		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
		ТекстJSON = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
	#Иначе
		Возврат;
	#КонецЕсли
	
	Если ПустаяСтрока(ТекстJSON) Тогда
		ВывестиСообщениеПользователю("Файл коллекции пуст");
		Возврат;
	КонецЕсли;
	
	Попытка
		СведенияОбИмпорте = ПолучитьСведенияОбИмпортеКоллекцииНаСервере(ТекстJSON);
	Исключение
		ВывестиСообщениеПользователю("Не удалось прочитать коллекцию: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если Не ПустаяСтрока(СведенияОбИмпорте.Ошибка) Тогда
		ВывестиСообщениеПользователю(СведенияОбИмпорте.Ошибка);
		Возврат;
	КонецЕсли;
	
	ПараметрыИмпорта = Новый Структура;
	ПараметрыИмпорта.Вставить("ТекстJSON", ТекстJSON);
	
	Если СведенияОбИмпорте.УжеСуществует Тогда
		ТекстВопроса = СтрШаблон(
			"Коллекция «%1» уже есть в обработке. Заменить её содержимое?",
			СведенияОбИмпорте.Наименование);
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ИмпортироватьКоллекциюПодтверждениеЗамены",
			ЭтотОбъект,
			ПараметрыИмпорта);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	ЗавершитьИмпортКоллекцииИзJSON(ТекстJSON);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортироватьКоллекциюПодтверждениеЗамены(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗавершитьИмпортКоллекцииИзJSON(ДополнительныеПараметры.ТекстJSON);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьИмпортКоллекцииИзJSON(Знач ТекстJSON)
	
	ИдетПереключениеКоллекции = Истина;
	ИдетПереключениеЗапроса = Истина;
	
	Попытка
		ДанныеПереключения = ПрименитьИмпортКоллекцииИзJSONНаСервере(ТекстJSON);
		ТекущаяКоллекция = ДанныеПереключения.ИдентификаторКоллекции;
		ОтображаемаяКоллекция = ТекущаяКоллекция;
		ПрименитьПереключениеКоллекцииНаКлиенте(ДанныеПереключения);
		ОбновитьСписокВыбораКоллекцийНаКлиенте();
		СохранитьНастройкиОбработки();
		ВывестиСообщениеПользователю("Коллекция импортирована: " + ДанныеПереключения.НаименованиеКоллекции);
	Исключение
		ИдетПереключениеКоллекции = Ложь;
		ИдетПереключениеЗапроса = Ложь;
		ВывестиСообщениеПользователю("Не удалось импортировать коллекцию: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ИдетПереключениеКоллекции = Ложь;
	ИдетПереключениеЗапроса = Ложь;
	
КонецПроцедуры

&НаКлиенте
Функция ИмяФайлаЭкспортаТекущейКоллекцииПоУмолчанию()
	
	ИмяКоллекции = ПолучитьИмяТекущейКоллекцииДляЭкспортаНаСервере();
	ИмяКоллекции = СокрЛП(ИмяКоллекции);
	Если ПустаяСтрока(ИмяКоллекции) Тогда
		ИмяКоллекции = "collection";
	КонецЕсли;
	
	Возврат ИмяКоллекции + ".json";
	
КонецФункции

// Определяет формат ответа для диалога сохранения: сначала Content-Type, затем тело.
//
// Возвращаемое значение:
//  Строка - "JSON", "XML", "HTML" или пустая строка.
//
&НаКлиенте
Функция ОпределитьФорматОтветаДляСохранения()
	
	Возврат ОпределитьФорматСодержимого(ЗапросОтвет);
	
КонецФункции

// Определяет формат по заголовкам HTTP-ответа и телу.
//
// Параметры:
//  Заголовки - Соответствие - заголовки HTTP-ответа.
//  ТекстОтвета - Строка - тело ответа.
//
// Возвращаемое значение:
//  Строка - "JSON", "XML", "HTML" или пустая строка.
//
&НаКлиенте
Функция ОпределитьФорматПоЗаголовкамИТелу(Знач Заголовки, Знач ТекстОтвета)
	
	ФорматИзЗаголовка = ОпределитьФорматПоСоответствиюЗаголовков(Заголовки);
	Если Не ПустаяСтрока(ФорматИзЗаголовка) Тогда
		Возврат ФорматИзЗаголовка;
	КонецЕсли;
	
	Возврат ОпределитьФорматСодержимого(ТекстОтвета);
	
КонецФункции

// Определяет формат по соответствию заголовков ответа.
//
// Параметры:
//  Заголовки - Соответствие - заголовки HTTP-ответа.
//
// Возвращаемое значение:
//  Строка - "JSON", "XML", "HTML" или пустая строка.
//
&НаКлиенте
Функция ОпределитьФорматПоСоответствиюЗаголовков(Знач Заголовки)
	
	Если Заголовки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ЗначениеContentType = Заголовки.Получить("Content-Type");
	Если ЗначениеContentType = Неопределено Тогда
		ЗначениеContentType = Заголовки.Получить("content-type");
	КонецЕсли;
	
	Если ЗначениеContentType = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ФорматИзContentType(Строка(ЗначениеContentType));
	
КонецФункции

&НаКлиенте
Функция ФорматИзContentType(Знач ЗначениеContentType)
	
	Значение = НРег(Строка(ЗначениеContentType));
	
	Если СтрНайти(Значение, "json") > 0 Тогда
		Возврат "JSON";
	КонецЕсли;
	
	// html раньше xml нельзя для application/xhtml+xml - это HTML.
	Если СтрНайти(Значение, "html") > 0 Тогда
		Возврат "HTML";
	КонецЕсли;
	
	Если СтрНайти(Значение, "xml") > 0 Тогда
		Возврат "XML";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Определяет формат текстового содержимого ответа.
//
// Параметры:
//  Содержимое - Строка - текст ответа.
//
// Возвращаемое значение:
//  Строка - "JSON", "XML", "HTML" или пустая строка, если формат не определен.
//
&НаКлиенте
Функция ОпределитьФорматСодержимого(Знач Содержимое)
	
	Текст = УбратьНевидимыйПрефикс(СокрЛП(Содержимое));
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Фрагмент = НРег(Лев(Текст, МаксимальнаяДлинаФрагментаДляОпределенияФормата()));
	
	Если СтрНачинаетсяС(Текст, "{") ИЛИ СтрНачинаетсяС(Текст, "[") Тогда
		Возврат "JSON";
	КонецЕсли;
	
	// XML объявление важнее HTML-тегов внутри (например <title> в slideshow).
	Если СтрНачинаетсяС(Фрагмент, "<?xml") Тогда
		Возврат "XML";
	КонецЕсли;
	
	Если ЭтоHTMLСодержимое(Фрагмент) Тогда
		Возврат "HTML";
	КонецЕсли;
	
	Если СтрНачинаетсяС(Текст, "<") Тогда
		Возврат "XML";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Удаляет BOM и прочие невидимые символы в начале строки.
//
// Параметры:
//  Текст - Строка - исходная строка.
//
// Возвращаемое значение:
//  Строка - строка без ведущих невидимых символов, с обрезкой пробелов по краям.
//
&НаКлиенте
Функция УбратьНевидимыйПрефикс(Знач Текст)
	
	Пока СтрДлина(Текст) > 0 Цикл
		
		КодСимвола = КодСимвола(Текст, 1);
		
		Если УдалятьНевидимыйСимволВНачалеСтроки(КодСимвола) Тогда
			Текст = Сред(Текст, ИндексСимволаПослеПервого());
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СокрЛП(Текст);
	
КонецФункции

// Проверяет, похож ли текст на HTML (по начальному фрагменту в нижнем регистре).
//
// Параметры:
//  ТекстНижнийРегистр - Строка - начало текста ответа в нижнем регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если содержимое похоже на HTML.
//
&НаКлиенте
Функция ЭтоHTMLСодержимое(Знач ТекстНижнийРегистр)
	
	Если СтрНайти(ТекстНижнийРегистр, "<!doctype html") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрНайти(ТекстНижнийРегистр, "<html") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрНайти(ТекстНижнийРегистр, "<head") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрНайти(ТекстНижнийРегистр, "<body") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Настраивает фильтр и расширение диалога сохранения по формату ответа.
// Индекс фильтра в платформе 0-based: 0=JSON, 1=XML, 2=HTML, 3=TXT.
//
// Параметры:
//  Диалог       - ДиалогВыбораФайла - диалог сохранения файла.
//  ФорматОтвета - Строка - "JSON", "XML", "HTML" или пустая строка.
//
&НаКлиенте
Процедура ЗаполнитьПараметрыДиалогаСохраненияПоФормату(Диалог, Знач ФорматОтвета)
	
	Диалог.Фильтр =
		"JSON (*.json)|*.json|"
		+ "XML (*.xml)|*.xml|"
		+ "HTML (*.html)|*.html|"
		+ "Текстовые файлы (*.txt)|*.txt|"
		+ "Все файлы (*.*)|*.*";
	
	Если ФорматОтвета = "JSON" Тогда
		РасширениеФайла = "json";
		ИндексТипа = 0;
	ИначеЕсли ФорматОтвета = "XML" Тогда
		РасширениеФайла = "xml";
		ИндексТипа = 1;
	ИначеЕсли ФорматОтвета = "HTML" Тогда
		РасширениеФайла = "html";
		ИндексТипа = 2;
	Иначе
		РасширениеФайла = "txt";
		ИндексТипа = 3;
	КонецЕсли;
	
	Диалог.ПолноеИмяФайла = "response." + РасширениеФайла;
	Диалог.Расширение = РасширениеФайла;
	Диалог.ИндексФильтра = ИндексТипа;
	
КонецПроцедуры

// Отображает нужный вариант тела запроса в зависимости от выбранного значения
//
&НаКлиенте
Процедура ОтобразитьВариантТелаЗапроса()
	
	ЭтоТекст = (ВариантТелаЗапроса = "JSON" ИЛИ ВариантТелаЗапроса = "XML");
	ЭтоBinary = (ВариантТелаЗапроса = "BINARY");
	ЭтоFormData = (ВариантТелаЗапроса = "FORM_DATA");
	
	Элементы.ТелоЗапроса.Видимость = ЭтоТекст;
	Элементы.ЗагрузитьВходящийФайл.Видимость = ЭтоBinary;
	Элементы.ПоляFormData.Видимость = ЭтоFormData;
	
КонецПроцедуры

// Приводит значения реквизитов в формы к изначальному виду
//
&НаКлиенте
Процедура ЗначенияПоУмолчанию()
	
	ЗапросОтвет = "";
	КодОтвета = 0;
	ФорматОтветаДляСохранения = "";
	КонтекстВыполненияЗапроса = "";
	
КонецПроцедуры

// Записывает текст в бьютифицированном виде (JSON или XML).
//
// Параметры:
//	СтрокаОтвета - Строка - Текст для форматирования.
//	Поле         - Строка - Имя реквизита формы для записи результата.
//	Формат       - Строка - "JSON", "XML" или "AUTO" (определение формата автоматически).
//
&НаКлиенте
Процедура БьютифицированныйЗапрос(Знач СтрокаОтвета, Знач Поле, Знач Формат = "JSON")

	Если ПустаяСтрока(СтрокаОтвета) ИЛИ ПустаяСтрока(Поле) Тогда
		Возврат;
	КонецЕсли;
	
	#Если НЕ ВебКлиент Тогда
		
		Если Формат = "AUTO" Тогда
			
			ФорматированиеВыполнено = БьютифицироватьJSON(СтрокаОтвета, Поле);
			
			Если Не ФорматированиеВыполнено Тогда
				ФорматированиеВыполнено = БьютифицироватьXML(СтрокаОтвета, Поле);
			КонецЕсли;
			
			Если Не ФорматированиеВыполнено Тогда
				ЭтотОбъект[Поле] = СтрокаОтвета;
			КонецЕсли;
			
		ИначеЕсли Формат = "XML" Тогда
			
			Если Не БьютифицироватьXML(СтрокаОтвета, Поле) Тогда
				ЭтотОбъект[Поле] = СтрокаОтвета;
			КонецЕсли;
			
		Иначе
			
			Если Не БьютифицироватьJSON(СтрокаОтвета, Поле) Тогда
				ЭтотОбъект[Поле] = СтрокаОтвета;
			КонецЕсли;
			
		КонецЕсли;
		
	#Иначе
		ЭтотОбъект[Поле] = СтрокаОтвета;
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Функция БьютифицироватьJSON(Знач СтрокаJSON, Знач Поле)
	
	СтрокаРезультата = БьютифицироватьJSONНаСервере(СтрокаJSON);
	Если ПустаяСтрока(СтрокаРезультата) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЭтотОбъект[Поле] = СтрокаРезультата;
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция БьютифицироватьJSONНаСервере(Знач СтрокаJSON)
	
	Попытка
		
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(СтрокаJSON);
		
		// Истина - читать объекты в Соответствие: ключи вроде "user-agent" / "x-forwarded-proto"
		// недопустимы как имена свойств Структуры и иначе роняют ПрочитатьJSON.
		Данные = ПрочитатьJSON(Чтение, Истина);
		
		Запись = Новый ЗаписьJSON();
		ПараметрыJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
		Запись.УстановитьСтроку(ПараметрыJSON);
		ЗаписатьJSON(Запись, Данные);
		
		Возврат Запись.Закрыть();
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция БьютифицироватьXML(Знач СтрокаXML, Знач Поле)
	
	СтрокаРезультата = БьютифицироватьXMLНаСервере(СтрокаXML);
	Если ПустаяСтрока(СтрокаРезультата) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЭтотОбъект[Поле] = СтрокаРезультата;
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция БьютифицироватьXMLНаСервере(Знач СтрокаXML)
	
	Попытка
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		ЗаписьDOM = Новый ЗаписьDOM;
		ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
		Возврат ЗаписьXML.Закрыть();
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Синхронизирует таблицу параметров авторизации с полями формы и обновляет видимость слотов.
//
&НаКлиенте
Процедура ОтобразитьПоляАвторизацииПоСхеме()
	
	Схема = ОписаниеСхемыАвторизации(ТипАвторизации);
	ЗначенияПараметров = СоответствиеЗначенийПараметровАвторизации(ПараметрыАвторизации);
	МаксимумПолей = МаксимумПолейАвторизацииНаФорме();
	КоличествоПолейСхемы = Схема.Поля.Количество();
	
	Если КоличествоПолейСхемы > МаксимумПолей Тогда
		ВызватьИсключение "Схема авторизации содержит больше полей, чем поддерживает форма ("
			+ ФорматЦелогоЧислаБезГруппировки(МаксимумПолей) + ")";
	КонецЕсли;
	
	Для Индекс = 1 По МаксимумПолей Цикл
		
		ИндексСтрокой = ФорматЦелогоЧислаБезГруппировки(Индекс);
		ИмяЭлемента = "ПолеАвторизации" + ИндексСтрокой;
		ИмяРеквизита = "ЗначениеАвторизации" + ИндексСтрокой;
		ЭлементПоля = Элементы[ИмяЭлемента];
		
		Если Индекс > КоличествоПолейСхемы Тогда
			ЭлементПоля.Видимость = Ложь;
			ЭтотОбъект[ИмяРеквизита] = "";
			Продолжить;
		КонецЕсли;
		
		ОписаниеПоля = Схема.Поля[Индекс - 1];
		ЗначениеПоля = ЗначенияПараметров.Получить(ОписаниеПоля.Ключ);
		Если ЗначениеПоля = Неопределено Тогда
			ЗначениеПоля = ОписаниеПоля.ЗначениеПоУмолчанию;
		КонецЕсли;
		
		ЭтотОбъект[ИмяРеквизита] = ЗначениеПоля;
		ЭлементПоля.Видимость = Истина;
		ЭлементПоля.Заголовок = ОписаниеПоля.Заголовок;
		ЭлементПоля.РежимПароля = ОписаниеПоля.Секретный;
		ЭлементПоля.МногострочныйРежим = ОписаниеПоля.Многострочный;
		ЭлементПоля.Высота = ?(ОписаниеПоля.Многострочный, 5, 1);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьПараметрыАвторизацииИзПолейФормы()
	
	Схема = ОписаниеСхемыАвторизации(ТипАвторизации);
	МаксимумПолей = МаксимумПолейАвторизацииНаФорме();
	КоличествоПолейСхемы = Мин(Схема.Поля.Количество(), МаксимумПолей);
	
	Для Индекс = 1 По КоличествоПолейСхемы Цикл
		
		ОписаниеПоля = Схема.Поля[Индекс - 1];
		ИмяРеквизита = "ЗначениеАвторизации" + ФорматЦелогоЧислаБезГруппировки(Индекс);
		УстановитьЗначениеПараметраАвторизации(
			ПараметрыАвторизации,
			ОписаниеПоля.Ключ,
			ЭтотОбъект[ИмяРеквизита],
			ОписаниеПоля.Секретный);
		
	КонецЦикла;
	
КонецПроцедуры

