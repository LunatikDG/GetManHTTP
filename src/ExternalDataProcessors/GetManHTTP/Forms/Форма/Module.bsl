	ОписаниеТела.Вставить(КлючJSONRaw(), ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ТелоЗапроса", ""));
	ОписаниеТела.Вставить("filePath", ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ПутьКФайлуВх", ""));
	ОписаниеТела.Вставить(
		"formData",
		МассивFormDataВJSON(ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ПоляFormData", Неопределено)));
	Элемент.Вставить("body", ОписаниеТела);
	
КонецПроцедуры

