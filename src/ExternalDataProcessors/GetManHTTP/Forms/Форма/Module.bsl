Функция МассивЗаголовковВJSON(Знач ТаблицаЗаголовков)
	
	Результат = Новый Массив;
	Если ТипЗнч(ТаблицаЗаголовков) <> Тип("ТаблицаЗначений") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЕстьОписаниеЗаголовка = ТаблицаЗаголовков.Колонки.Найти("ОписаниеЗаголовка") <> Неопределено;
	ЕстьАктивен = ТаблицаЗаголовков.Колонки.Найти("Активен") <> Неопределено;
	
	Для Каждого СтрокаЗаголовка Из ТаблицаЗаголовков Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("key", СтрокаЗаголовка.КлючЗаголовка);
		Элемент.Вставить("value", СтрокаЗаголовка.ЗначениеЗаголовка);
		Если ЕстьОписаниеЗаголовка Тогда
			Элемент.Вставить("description", СтрокаЗаголовка.ОписаниеЗаголовка);
		КонецЕсли;
		Если ЕстьАктивен И Не СтрокаЗаголовка.Активен Тогда
			Элемент.Вставить("disabled", Истина);
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция МассивПараметровЗапросаВJSON(Знач ТаблицаПараметров)
	
	Результат = Новый Массив;
	Если ТипЗнч(ТаблицаПараметров) <> Тип("ТаблицаЗначений") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЕстьОписаниеПараметра = ТаблицаПараметров.Колонки.Найти("ОписаниеПараметра") <> Неопределено;
	ЕстьАктивен = ТаблицаПараметров.Колонки.Найти("Активен") <> Неопределено;
	
	Для Каждого СтрокаПараметра Из ТаблицаПараметров Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("key", СтрокаПараметра.КлючПараметра);
		Элемент.Вставить("value", СтрокаПараметра.ЗначениеПараметра);
		Если ЕстьОписаниеПараметра Тогда
			Элемент.Вставить("description", СтрокаПараметра.ОписаниеПараметра);
		КонецЕсли;
		Если ЕстьАктивен И Не СтрокаПараметра.Активен Тогда
			Элемент.Вставить("disabled", Истина);
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция МассивFormDataВJSON(Знач ТаблицаПолей)
	
	Результат = Новый Массив;
	Если ТипЗнч(ТаблицаПолей) <> Тип("ТаблицаЗначений") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЕстьОписание = ТаблицаПолей.Колонки.Найти("Описание") <> Неопределено;
	
	Для Каждого СтрокаПоля Из ТаблицаПолей Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("key", СтрокаПоля.Ключ);
		Элемент.Вставить("value", СтрокаПоля.Значение);
		Элемент.Вставить("type", "text");
		Если ЕстьОписание Тогда
			Элемент.Вставить("description", СтрокаПоля.Описание);
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
