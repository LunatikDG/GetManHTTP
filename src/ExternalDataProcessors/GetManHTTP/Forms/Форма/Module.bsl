&НаСервере
Процедура ЗаполнитьРеквизитыИзДанныхЗапроса(Знач ДанныеЗапроса)
	
	HTTPМетод = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "HTTPМетод", "GET");
	Если ПустаяСтрока(HTTPМетод) Тогда
		HTTPМетод = "GET";
	КонецЕсли;
	
	URI = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "URI", "");
	ТелоЗапроса = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ТелоЗапроса", "");
	ВремяВыполненияЗапроса = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ВремяВыполненияЗапроса", "");
	ЗапросОтвет = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ЗапросОтвет", "");
	КодОтвета = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "КодОтвета", 0);
	ТипАвторизации = ПолучитьЗначениеДанныхЗапроса(
		ДанныеЗапроса,
		"ТипАвторизации",
		ИдентификаторТипаАвторизацииНаследоватьОтВладельца());
	Если ПустаяСтрока(ТипАвторизации) Тогда
		ТипАвторизации = ИдентификаторТипаАвторизацииНаследоватьОтВладельца();
	КонецЕсли;
	
	ВариантТелаЗапроса = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ВариантТелаЗапроса", "NONE");
	Если ПустаяСтрока(ВариантТелаЗапроса) Тогда
		ВариантТелаЗапроса = "NONE";
	КонецЕсли;
	
	ПутьКФайлуВх = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ПутьКФайлуВх", "");
	ФорматОтветаДляСохранения = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ФорматОтветаДляСохранения", "");
	РежимОтправкиЗапроса = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "РежимОтправкиЗапроса", "Клиент");
	КонтекстВыполненияЗапроса = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "КонтекстВыполненияЗапроса", "");
	
	ЗагрузитьТаблицуИзДанныхЗапроса(ЗаголовкиЗапроса, ДанныеЗапроса, "ЗаголовкиЗапроса");
	ЗагрузитьТаблицуИзДанныхЗапроса(ЗаголовкиОтвета, ДанныеЗапроса, "ЗаголовкиОтвета");
	ЗагрузитьТаблицуИзДанныхЗапроса(ПараметрыЗапроса, ДанныеЗапроса, "ПараметрыЗапроса");
	ЗагрузитьТаблицуИзДанныхЗапроса(ПоляFormData, ДанныеЗапроса, "ПоляFormData");
	ЗагрузитьТаблицуИзДанныхЗапроса(ПараметрыАвторизации, ДанныеЗапроса, "ПараметрыАвторизации");
	МигрироватьПараметрыАвторизацииИзУстаревшихПолей(ДанныеЗапроса);
	ПерестроитьПараметрыАвторизацииПоСхемеНаСервере();
	
	НормализоватьURIИПараметрыЗапросаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРеквизитыТекущегоЗапроса()
	
	HTTPМетод = "GET";
	URI = "";
	ТелоЗапроса = "";
	ВремяВыполненияЗапроса = "";
	ЗапросОтвет = "";
	КодОтвета = 0;
	ТипАвторизации = ИдентификаторТипаАвторизацииНаследоватьОтВладельца();
	ПараметрыАвторизации.Очистить();
	ЗначениеАвторизации1 = "";
	ЗначениеАвторизации2 = "";
	ЗначениеАвторизации3 = "";
	ЗначениеАвторизации4 = "";
	ЗначениеАвторизации5 = "";
	ЗначениеАвторизации6 = "";
	ВариантТелаЗапроса = "NONE";
	ПутьКФайлуВх = "";
	ФорматОтветаДляСохранения = "";
	ЗаголовкиЗапроса.Очистить();
	ЗаголовкиОтвета.Очистить();
	ПараметрыЗапроса.Очистить();
	ПоляFormData.Очистить();
	РежимОтправкиЗапроса = РежимОтправкиПоУмолчаниюЭффективный();
	КонтекстВыполненияЗапроса = "";
	
КонецПроцедуры

&НаСервере
Процедура МигрироватьПараметрыАвторизацииИзУстаревшихПолей(Знач ДанныеЗапроса)
	
	Если ПараметрыАвторизации.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипАвторизации = "BasicAuth" Тогда
		
		УстановитьЗначениеПараметраАвторизации(
			ПараметрыАвторизации,
			"login",
			ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ЛогинBasicAuth", ""),
			Ложь);
		УстановитьЗначениеПараметраАвторизации(
			ПараметрыАвторизации,
			"password",
			ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ПарольBasicAuth", ""),
			Истина);
		
	ИначеЕсли ТипАвторизации = ИдентификаторТипаАвторизацииТокен() Тогда
		
		ПрефиксТокена = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "НаименованиеТокена", "");
		Если ПустаяСтрока(ПрефиксТокена) Тогда
			ПрефиксТокена = ПрефиксТокенаАвторизацииПоУмолчанию();
		КонецЕсли;
		
		УстановитьЗначениеПараметраАвторизации(
			ПараметрыАвторизации,
			КлючПоляАвторизацииПрефиксТокена(),
			ПрефиксТокена,
			Ложь);
		УстановитьЗначениеПараметраАвторизации(
			ПараметрыАвторизации,
			КлючПоляАвторизацииТокен(),
			ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, "ТокенАвторизации", ""),
			Истина);
		
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеДанныхЗапроса(Знач ДанныеЗапроса, Знач ИмяСвойства, Знач ЗначениеПоУмолчанию)
	
	Если ТипЗнч(ДанныеЗапроса) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Если Не ДанныеЗапроса.Свойство(ИмяСвойства) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ЗначениеСвойства = ДанныеЗапроса[ИмяСвойства];
	Если ЗначениеСвойства = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат ЗначениеСвойства;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьТаблицуИзДанныхЗапроса(ТаблицаФормы, Знач ДанныеЗапроса, Знач ИмяСвойства)
	
	ТаблицаФормы.Очистить();
	
	ЗначениеТаблицы = ПолучитьЗначениеДанныхЗапроса(ДанныеЗапроса, ИмяСвойства, Неопределено);
	Если ТипЗнч(ЗначениеТаблицы) = Тип("ТаблицаЗначений") Тогда
		
		Если ИмяСвойства = "ПараметрыЗапроса" Или ИмяСвойства = "ЗаголовкиЗапроса" Тогда
			ОбеспечитьКолонкуАктивенВТаблицеЗначений(ЗначениеТаблицы);
		КонецЕсли;
		
		ТаблицаФормы.Загрузить(ЗначениеТаблицы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СобратьДанныеАвторизацииТекущегоЭлемента()
	
	СинхронизироватьПараметрыАвторизацииИзПолейФормыНаСервере();
	
	ДанныеАвторизации = Новый Структура;
	ДанныеАвторизации.Вставить("ТипАвторизации", ТипАвторизации);
	ДанныеАвторизации.Вставить("ПараметрыАвторизации", ПараметрыАвторизации.Выгрузить());
	
	Возврат ДанныеАвторизации;
	
