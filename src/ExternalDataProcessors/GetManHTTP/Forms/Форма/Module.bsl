&НаСервере
Функция ЗначениеСвойстваJSONКоллекции(Знач ОбъектJSON, Знач ИмяСвойства, Знач ЗначениеПоУмолчанию = Неопределено)
	
	Если ОбъектJSON = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектJSON) = Тип("Соответствие") Тогда
		Значение = ОбъектJSON.Получить(ИмяСвойства);
		Если Значение = Неопределено Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектJSON) = Тип("Структура") Тогда
		Если Не ОбъектJSON.Свойство(ИмяСвойства) Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Значение = ОбъектJSON[ИмяСвойства];
		Если Значение = Неопределено Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

&НаСервере
Функция БулевоЗначениеJSONКоллекции(Знач Значение, Знач ЗначениеПоУмолчанию)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		ЗначениеНижнийРегистр = НРег(СокрЛП(Значение));
		Если ЗначениеНижнийРегистр = "true" Или ЗначениеНижнийРегистр = "1" Тогда
			Возврат Истина;
		КонецЕсли;
		Если ЗначениеНижнийРегистр = "false" Или ЗначениеНижнийРегистр = "0" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

