// BSLLS:UnusedLocalVariable-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
#Область ОбработчикиСобытийФормы
// BSLLS:UnusedLocalMethod-off

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ИспользоватьТаймаутПоУмолчанию") Тогда
		ИспользоватьТаймаутПоУмолчанию = Параметры.ИспользоватьТаймаутПоУмолчанию;
	Иначе
		ИспользоватьТаймаутПоУмолчанию = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("ТаймаутНаследуемый") Тогда
		ТаймаутНаследуемый = Параметры.ТаймаутНаследуемый;
	Иначе
		ТаймаутНаследуемый = 0;
	КонецЕсли;
	
	Если Параметры.Свойство("ТаймаутЗапроса") Тогда
		ТаймаутЗапроса = Параметры.ТаймаутЗапроса;
	Иначе
		ТаймаутЗапроса = ТаймаутНаследуемый;
	КонецЕсли;
	
	Если ИспользоватьТаймаутПоУмолчанию Тогда
		ТаймаутЗапроса = ТаймаутНаследуемый;
	КонецЕсли;
	
	Если Параметры.Свойство("ИспользоватьПортПоУмолчанию") Тогда
		ИспользоватьПортПоУмолчанию = Параметры.ИспользоватьПортПоУмолчанию;
	Иначе
		ИспользоватьПортПоУмолчанию = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("ПортНаследуемый") Тогда
		ПортНаследуемый = Параметры.ПортНаследуемый;
	Иначе
		ПортНаследуемый = ПортHTTPПоУмолчанию();
	КонецЕсли;
	
	Если Параметры.Свойство("ПортЗапроса") Тогда
		ПортЗапроса = Параметры.ПортЗапроса;
	Иначе
		ПортЗапроса = ПортНаследуемый;
	КонецЕсли;
	
	Если ИспользоватьПортПоУмолчанию Тогда
		ПортЗапроса = ПортНаследуемый;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьДоступностьПолейНастроекЗапроса();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура ИспользоватьТаймаутПоУмолчаниюПриИзменении(Элемент)
	
	Если ИспользоватьТаймаутПоУмолчанию Тогда
		ТаймаутЗапроса = ТаймаутНаследуемый;
	КонецЕсли;
	
	ОбновитьДоступностьПолейНастроекЗапроса();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьПортПоУмолчаниюПриИзменении(Элемент)
	
	Если ИспользоватьПортПоУмолчанию Тогда
		ПортЗапроса = ПортНаследуемый;
	КонецЕсли;
	
	ОбновитьДоступностьПолейНастроекЗапроса();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область ОбработчикиКомандФормы

// BSLLS:UnusedLocalMethod-off

&НаКлиенте
Процедура ПрименитьНастройкиЗапроса(Команда)
	
	Если Не ИспользоватьТаймаутПоУмолчанию И ТаймаутЗапроса < 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Таймаут запроса не может быть отрицательным";
		Сообщение.Поле = "ТаймаутЗапроса";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если Не ИспользоватьПортПоУмолчанию Тогда
		Если ПортЗапроса < 1 Или ПортЗапроса > МаксимальныйНомерПорта() Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
				"Порт должен быть в диапазоне 1-%1",
				Формат(МаксимальныйНомерПорта(), "ЧГ=0"));
			Сообщение.Поле = "ПортЗапроса";
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ИспользоватьТаймаутПоУмолчанию", ИспользоватьТаймаутПоУмолчанию);
	Результат.Вставить("ТаймаутЗапроса", ТаймаутЗапроса);
	Результат.Вставить("ИспользоватьПортПоУмолчанию", ИспользоватьПортПоУмолчанию);
	Результат.Вставить("ПортЗапроса", ПортЗапроса);
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьНастройкиЗапроса(Команда)
	
	Закрыть();
	
КонецПроцедуры

// BSLLS:UnusedLocalMethod-on

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьДоступностьПолейНастроекЗапроса()
	
	Элементы.ТаймаутЗапроса.Доступность = Не ИспользоватьТаймаутПоУмолчанию;
	Элементы.ПортЗапроса.Доступность = Не ИспользоватьПортПоУмолчанию;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПортHTTPПоУмолчанию()
	
	Возврат 80;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция МаксимальныйНомерПорта()
	
	Возврат 65535;
	
КонецФункции

#КонецОбласти

// BSLLS:UnusedLocalVariable-on
